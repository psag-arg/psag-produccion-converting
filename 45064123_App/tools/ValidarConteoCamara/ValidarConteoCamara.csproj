<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Herramienta de validación (no se instala en el servidor): pasa video grabado de la cámara 10 por la cadena
    real del servicio (FuenteFfmpeg → VigilanteVideo → ProcesadorMangas → DetectorParadas → AcumuladorMinutos)
    con varias configuraciones a la vez y compara mangas y paradas contra una referencia. Ver Program.cs.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PSAG.Mantenimiento.ConteoCamara\PSAG.Mantenimiento.ConteoCamara.csproj" />
  </ItemGroup>

</Project>
