# Secrets and configuration
appsettings.Production.json
appsettings.*.local.json
secrets.json
*.pfx
*.p12

# Logs
*.log
nlog-*.log
Serilog/

# Test results
coverage/
TestResults/
*.trx
*.coverage
*.coveragexml

# SQL Server files
*.mdf
*.ldf
*.ndf

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# =============================================================================
# Claude Code - Archivos locales (no compartir entre desarrolladores)
# =============================================================================
.claude/settings.local.json
.claude/agent-memory-local/
CLAUDE.local.md

# =============================================================================
# OneDrive - Evitar conflictos de sincronización
# =============================================================================
# Los directorios bin/, obj/ y .vs/ ya están excluidos arriba
# Adicional: archivos temporales de OneDrive
~$*
*.tmp

# T-610 conteo por cámara: binario de ffmpeg, overrides locales, lotes pendientes y credenciales
**/ffmpeg/*.exe
appsettings.local.json
**/pendientes/
*.env
