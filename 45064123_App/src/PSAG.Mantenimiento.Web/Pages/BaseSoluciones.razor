@page "/detenciones/soluciones"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Web
@using PSAG.Mantenimiento.Web.Models
@using PSAG.Mantenimiento.Web.Services
@attribute [Authorize]
@inject IAnalisisService AnalisisService
@inject ICatalogosService CatalogosService

<PageTitle>Base de soluciones - PSAG Produccion</PageTitle>

<div class="container-fluid">
    <div class="mb-4">
        <h2>Base de soluciones</h2>
        <div class="text-muted">Fallas cerradas con solución o causa cargada. Buscá cómo se resolvieron antes.</div>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <div class="row g-3 align-items-start">
                <div class="col-lg-4">
                    <label class="form-label">Buscar</label>
                    <div class="input-group">
                        <input type="text" class="form-control" placeholder="Ej: carro limpieza rodillo"
                               @bind="busqueda" @bind:event="oninput" @onkeydown="TeclaBusqueda" />
                        <button class="btn btn-primary" @onclick="Buscar" disabled="@buscando">
                            <i class="bi bi-search"></i>
                        </button>
                    </div>
                </div>
                <div class="col-lg-2 col-md-4">
                    <label class="form-label">Línea</label>
                    <select class="form-select" @bind="lineaId" @bind:after="@(async () => await CambiarLinea())">
                        <option value="">Todas</option>
                        @foreach (var linea in lineas)
                        {
                            <option value="@linea.LineaId">@linea.Nombre</option>
                        }
                    </select>
                </div>
                <div class="col-lg-2 col-md-4">
                    <label class="form-label">Equipo</label>
                    <select class="form-select" @bind="equipoId" @bind:after="@(async () => await Buscar())">
                        <option value="">Todos</option>
                        @foreach (var equipo in equipos)
                        {
                            <option value="@equipo.EquipoId">@(lineaId.HasValue ? equipo.Nombre : $"{equipo.Nombre} ({equipo.LineaNombre})")</option>
                        }
                    </select>
                    @if (!lineaId.HasValue)
                    {
                        <div class="form-text">Elegí una línea para ver sólo sus equipos.</div>
                    }
                </div>
                <div class="col-lg-2 col-md-4">
                    <label class="form-label">Tipo de falla</label>
                    <select class="form-select" @bind="tipoFallaId" @bind:after="@(async () => await Buscar())">
                        <option value="">Todos</option>
                        @foreach (var tipo in tiposFalla)
                        {
                            <option value="@tipo.TipoFallaId">@tipo.Nombre</option>
                        }
                    </select>
                </div>
                <div class="col-lg-2 col-md-4">
                    <label class="form-label d-none d-md-block invisible" aria-hidden="true">Limpiar</label>
                    <button class="btn btn-outline-secondary w-100" @onclick="LimpiarFiltros">Limpiar</button>
                </div>
            </div>
        </div>
    </div>

    @if (buscando)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Buscando...</span>
            </div>
        </div>
    }
    else
    {
        @if (errorBusqueda != null)
        {
            <div class="alert alert-danger">@errorBusqueda</div>
        }
        else if (resultados.Any())
        {
            <div class="text-muted mb-3">
                @if (total > resultados.Count)
                {
                    <span>Se muestran las @resultados.Count más recientes de @total fallas cerradas que coinciden. Afiná la búsqueda para ver menos.</span>
                }
                else
                {
                    <span>@(resultados.Count == 1 ? "1 falla cerrada coincide" : $"{resultados.Count} fallas cerradas coinciden")</span>
                }
            </div>
        }

        @foreach (var item in resultados)
        {
            <div class="card mb-3">
                <div class="card-body">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                        <div class="d-flex flex-wrap align-items-center gap-2">
                            <a href="detenciones/@item.DetencionId?volver=/detenciones/soluciones"><strong>@item.Codigo</strong></a>
                            <span class="badge bg-light text-dark border">@item.LineaNombre</span>
                            @if (item.EquipoNombre != null)
                            {
                                <span class="badge bg-light text-dark border">@item.EquipoNombre</span>
                            }
                            @if (item.TipoFallaNombre != null)
                            {
                                <span class="badge bg-info text-dark">@item.TipoFallaNombre</span>
                            }
                            <span class="badge bg-secondary">@item.MinutosEfectivos min</span>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <small class="text-muted">
                                @(item.AnalisisPorUsuarioNombre ?? "")
                                @(item.FechaHoraAnalisis.HasValue ? item.FechaHoraAnalisis.Value.ToString("dd/MM/yyyy") : item.Fecha.ToString("dd/MM/yyyy"))
                            </small>
                            @if (puedeEditar && editando?.DetencionId != item.DetencionId)
                            {
                                <button class="btn btn-outline-primary btn-sm" @onclick="() => EmpezarEdicion(item)" disabled="@(editando != null)">
                                    <i class="bi bi-pencil me-1"></i>Editar
                                </button>
                            }
                        </div>
                    </div>
                    <div><span class="text-muted">Falla:</span> @item.Descripcion</div>

                    @if (guardadoId == item.DetencionId)
                    {
                        <div class="alert alert-success py-1 px-2 small mt-2 mb-0">Análisis actualizado. El cambio quedó en el historial de la detención.</div>
                    }

                    @if (editando?.DetencionId == item.DetencionId)
                    {
                        <div class="border rounded p-3 mt-2">
                            @if (errorEdicion != null)
                            {
                                <div class="alert alert-danger py-2">@errorEdicion</div>
                            }
                            <div class="mb-3">
                                <label class="form-label fw-semibold mb-1">Solución <span class="text-danger">*</span></label>
                                <textarea class="form-control" rows="3" maxlength="@LargoSolucion" @bind="solucionTexto" @bind:event="oninput"></textarea>
                                <div class="form-text">@solucionTexto.Length de @LargoSolucion caracteres como máximo.</div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold mb-1">Causa de falla <span class="text-danger">*</span></label>
                                <textarea class="form-control" rows="3" maxlength="@LargoCausaYPlan" @bind="causaTexto" @bind:event="oninput"></textarea>
                                <div class="form-text">@causaTexto.Length de @LargoCausaYPlan caracteres como máximo.</div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold mb-1">Plan de acción <span class="text-muted small fw-normal">(opcional)</span></label>
                                <textarea class="form-control" rows="3" maxlength="@LargoCausaYPlan" @bind="planTexto" @bind:event="oninput"></textarea>
                                <div class="form-text">@planTexto.Length de @LargoCausaYPlan caracteres como máximo.</div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold mb-1">Fotos</label>
                                <FotosAnalisis DetencionId="item.DetencionId" Adjuntos="item.Adjuntos" PuedeAdjuntar="true"
                                               OnAgregada="@(a => item.Adjuntos.Add(a))" />
                                <div class="form-text">Las fotos se guardan apenas se suben, aunque después canceles la edición del texto.</div>
                            </div>
                            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                                <small class="text-muted">Se guarda sobre el análisis original. Queda registrado quién lo cambió, cuándo y qué decía antes.</small>
                                <div>
                                    <button class="btn btn-outline-secondary me-2" @onclick="CancelarEdicion" disabled="@guardando">Cancelar</button>
                                    <button class="btn btn-primary" @onclick="@(async () => await GuardarEdicion(item))" disabled="@guardando">
                                        @if (guardando)
                                        {
                                            <span class="spinner-border spinner-border-sm me-2"></span>
                                        }
                                        Guardar cambios
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        @if (!string.IsNullOrEmpty(item.AccionesRealizadas))
                        {
                            <div class="mt-1"><strong>Solución:</strong> @item.AccionesRealizadas</div>
                        }
                        @if (!string.IsNullOrEmpty(item.CausaFalla))
                        {
                            <div><strong>Causa:</strong> @item.CausaFalla</div>
                        }
                        @if (!string.IsNullOrEmpty(item.PlanAccion))
                        {
                            <div><strong>Plan de acción:</strong> @item.PlanAccion</div>
                        }
                        @if (item.Adjuntos.Any())
                        {
                            <div class="mt-2">
                                <FotosAnalisis DetencionId="item.DetencionId" Adjuntos="item.Adjuntos" />
                            </div>
                        }
                    }
                </div>
            </div>
        }

        @if (!resultados.Any() && errorBusqueda == null)
        {
            <div class="card">
                <div class="card-body text-center text-muted py-4">
                    @if (buscoConFiltros)
                    {
                        <span>Ninguna falla cerrada coincide con estos filtros. Probá con menos palabras o tocá <em>Limpiar</em>.</span>
                    }
                    else
                    {
                        <span>Todavía no hay fallas cerradas con solución. Aparecen acá cuando alguien cierra un análisis.</span>
                    }
                </div>
            </div>
        }
    }
</div>

@code {
    private const int LargoSolucion = 4000;
    private const int LargoCausaYPlan = 2000;

    [Parameter, SupplyParameterFromQuery]
    public string? Busqueda { get; set; }

    [Parameter, SupplyParameterFromQuery]
    public int? LineaId { get; set; }

    [Parameter, SupplyParameterFromQuery]
    public int? EquipoId { get; set; }

    [Parameter, SupplyParameterFromQuery]
    public int? TipoFallaId { get; set; }

    private List<LineaDto> lineas = new();
    private List<EquipoDto> equipos = new();
    private List<TipoFallaDto> tiposFalla = new();
    private List<SolucionDto> resultados = new();
    private int total;
    private bool buscando = true;

    // Edición de un análisis cerrado (administración y supervisión; la API lo vuelve a validar)
    private bool puedeEditar;
    private SolucionDto? editando;
    private long? guardadoId;
    private string solucionTexto = string.Empty;
    private string causaTexto = string.Empty;
    private string planTexto = string.Empty;
    private bool guardando;
    private string? errorEdicion;
    private bool buscoConFiltros;
    private string? errorBusqueda;

    // Enlazados a los filtros (la query string solo define el estado inicial)
    private string? busqueda;
    private int? lineaId;
    private int? equipoId;
    private int? tipoFallaId;

    protected override async Task OnInitializedAsync()
    {
        busqueda = Busqueda;
        lineaId = LineaId;
        equipoId = EquipoId;
        tipoFallaId = TipoFallaId;

        var tareaLineas = CatalogosService.GetLineasAsync();
        var tareaTiposFalla = CatalogosService.GetTiposFallaAsync();
        await Task.WhenAll(tareaLineas, tareaTiposFalla, CargarEquipos());
        lineas = await tareaLineas;
        tiposFalla = await tareaTiposFalla;
        await Buscar();
    }

    private async Task CargarEquipos()
    {
        equipos = await CatalogosService.GetEquiposAsync(lineaId);
        if (equipoId.HasValue && equipos.All(e => e.EquipoId != equipoId))
        {
            equipoId = null;
        }
    }

    private async Task CambiarLinea()
    {
        await CargarEquipos();
        await Buscar();
    }

    private async Task TeclaBusqueda(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await Buscar();
        }
    }

    private async Task LimpiarFiltros()
    {
        busqueda = null;
        lineaId = null;
        tipoFallaId = null;
        await CargarEquipos();
        equipoId = null;
        await Buscar();
    }

    private async Task Buscar()
    {
        buscando = true;
        errorBusqueda = null;
        buscoConFiltros = !string.IsNullOrWhiteSpace(busqueda) || lineaId.HasValue || equipoId.HasValue || tipoFallaId.HasValue;
        editando = null;
        guardadoId = null;
        try
        {
            var resultado = await AnalisisService.BuscarSolucionesAsync(new BuscarSolucionesFiltro
            {
                Busqueda = busqueda,
                LineaId = lineaId,
                EquipoId = equipoId,
                TipoFallaId = tipoFallaId
            });
            resultados = resultado.Items;
            total = resultado.Total;
            puedeEditar = resultado.PuedeEditar;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error buscando soluciones: {ex.Message}");
            resultados = new();
            total = 0;
            errorBusqueda = "No se pudo buscar en la base de soluciones. Revisá la conexión y probá de nuevo.";
        }
        finally
        {
            buscando = false;
        }
    }

    private void EmpezarEdicion(SolucionDto item)
    {
        editando = item;
        guardadoId = null;
        errorEdicion = null;
        solucionTexto = item.AccionesRealizadas ?? string.Empty;
        causaTexto = item.CausaFalla ?? string.Empty;
        planTexto = item.PlanAccion ?? string.Empty;
    }

    private void CancelarEdicion()
    {
        editando = null;
        errorEdicion = null;
    }

    private async Task GuardarEdicion(SolucionDto item)
    {
        if (string.IsNullOrWhiteSpace(solucionTexto) || string.IsNullOrWhiteSpace(causaTexto))
        {
            errorEdicion = "La solución y la causa de la falla no pueden quedar vacías.";
            return;
        }

        guardando = true;
        errorEdicion = null;
        try
        {
            var (analisis, error) = await AnalisisService.EditarCerradoAsync(item.DetencionId, new GuardarAnalisisRequest
            {
                AccionesRealizadas = solucionTexto,
                CausaFalla = causaTexto,
                PlanAccion = planTexto,
                RowVersion = item.RowVersion
            });

            if (analisis == null)
            {
                errorEdicion = error;
                return;
            }

            item.AccionesRealizadas = analisis.AccionesRealizadas;
            item.CausaFalla = analisis.CausaFalla;
            item.PlanAccion = analisis.PlanAccion;
            item.RowVersion = analisis.RowVersion;
            item.Adjuntos = analisis.Adjuntos;
            editando = null;
            guardadoId = item.DetencionId;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al editar el análisis: {ex.Message}");
            errorEdicion = "No se pudo guardar. Revisá la conexión y probá de nuevo.";
        }
        finally
        {
            guardando = false;
        }
    }
}
