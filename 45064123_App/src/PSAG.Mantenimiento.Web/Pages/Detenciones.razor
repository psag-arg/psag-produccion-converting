@page "/detenciones"
@using System.Globalization
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.JSInterop
@using PSAG.Mantenimiento.Web.Models
@using PSAG.Mantenimiento.Web.Services
@implements IAsyncDisposable
@attribute [Authorize]
@inject IDetencionesService DetencionesService
@inject ICatalogosService CatalogosService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS

<PageTitle>Detenciones - PSAG Produccion</PageTitle>

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-0">Detenciones</h2>
            @if (!puedeCargar)
            {
                <small class="text-muted">Tu usuario es de consulta: podés ver y exportar, no cargar ni editar.</small>
            }
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-success" @onclick="ExportarExcel">
                <i class="bi bi-file-earmark-excel me-2"></i>Exportar Excel
            </button>
            @if (puedeCargar)
            {
                <button class="btn btn-primary" @onclick="AbrirModalNueva">
                    <i class="bi bi-plus-lg me-2"></i>Nueva detención
                </button>
            }
        </div>
    </div>

    @if (!string.IsNullOrEmpty(mensajeError))
    {
        <div class="alert alert-danger">@mensajeError</div>
    }
    @if (!string.IsNullOrEmpty(mensajeAviso))
    {
        <div class="alert alert-warning">@mensajeAviso</div>
    }

    <!-- Filtros -->
    <div class="card mb-4">
        <div class="card-body">
            <div class="row g-3">
                <!-- Buscador universal -->
                <div class="col-md-4">
                    <label class="form-label">Buscar</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                        <input type="text" class="form-control" placeholder="Código, equipo, tipo de falla, descripción..."
                               @bind="filtroBusqueda" @bind:event="oninput" @onkeyup="OnBusquedaKeyUp" />
                        @if (!string.IsNullOrEmpty(filtroBusqueda))
                        {
                            <button class="btn btn-outline-secondary" type="button" @onclick="LimpiarBusqueda">
                                <i class="bi bi-x"></i>
                            </button>
                        }
                    </div>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Fecha Desde</label>
                    <input type="date" class="form-control" @bind="filtroFechaDesde" @bind:after="@(async () => await AplicarFiltros())" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Fecha Hasta</label>
                    <input type="date" class="form-control" @bind="filtroFechaHasta" @bind:after="@(async () => await AplicarFiltros())" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Línea</label>
                    <select class="form-select" @bind="filtroLineaId" @bind:after="@(async () => await AplicarFiltros())">
                        <option value="">Todas</option>
                        @foreach (var linea in lineas)
                        {
                            <option value="@linea.LineaId">@linea.Nombre</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Estado</label>
                    <select class="form-select" @bind="filtroEstado" @bind:after="@(async () => await AplicarFiltros())">
                        <option value="">Todos</option>
                        <option value="REGISTRADA">Registrada (incluye las que requieren análisis)</option>
                        <option value="EN_SEGUIMIENTO">En análisis</option>
                        <option value="CERRADA">Cerrada</option>
                    </select>
                </div>
            </div>
            <div class="row g-3 mt-0 align-items-end">
                <div class="col-md-3">
                    <label class="form-label">Análisis</label>
                    <select class="form-select" @bind="filtroAnalisis" @bind:after="@(async () => await AplicarFiltros())">
                        <option value="">Todos</option>
                        <option value="PENDIENTE">Análisis pendiente</option>
                        <option value="SIN">Sin análisis pendiente</option>
                    </select>
                </div>
                <div class="col-md-9 d-flex justify-content-end align-items-center gap-3">
                    @if (esAdministrador)
                    {
                        <div class="form-check form-switch mb-0">
                            <input class="form-check-input" type="checkbox" role="switch" id="verEliminadas"
                                   @bind="verEliminadas" @bind:after="@(async () => await AplicarFiltros())" />
                            <label class="form-check-label" for="verEliminadas">Incluir eliminadas</label>
                        </div>
                    }
                    <button class="btn btn-outline-secondary btn-sm" @onclick="LimpiarFiltros">
                        <i class="bi bi-x-circle me-1"></i>Limpiar filtros
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabla de detenciones -->
    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
        </div>
    }
    else if (errorCarga != null)
    {
        <div class="alert alert-danger">@errorCarga</div>
    }
    else if (detenciones.Items.Any())
    {
        <div class="card">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Código</th>
                            <th>Fecha y hora</th>
                            <th>Línea</th>
                            <th>Equipo</th>
                            <th>Tipo de falla</th>
                            <th>Minutos</th>
                            <th>Estado</th>
                            <th>Turno</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var det in detenciones.Items)
                        {
                            <tr class="@(det.Eliminada ? "opacity-50" : "")"
                                style="@(det.Eliminada ? "" : "cursor: pointer;")"
                                @onclick="() => AbrirFila(det)">
                                <td class="text-nowrap"><strong>@det.Codigo</strong></td>
                                <td>
                                    @det.Fecha.ToString("dd/MM/yyyy")
                                    @if (HoraReal(det) is { } horaParada)
                                    {
                                        <span class="text-muted ms-1">@horaParada.ToLocalTime().ToString("HH:mm", CultureInfo.InvariantCulture)</span>
                                    }
                                </td>
                                <td>@det.LineaNombre</td>
                                <td>@(det.EquipoNombre ?? "-")</td>
                                <td>@(det.TipoFallaNombre ?? "-")</td>
                                <td>
                                    <span class="badge bg-secondary">@det.MinutosEfectivos min</span>
                                </td>
                                <td>
                                    <span class="@EstadoUi.BadgeClass(det.EstadoActual, det.AnalisisPendiente)"
                                          style="@EstadoUi.BadgeStyle(det.EstadoActual, det.AnalisisPendiente)">
                                        @EstadoUi.Texto(det.EstadoActualDescripcion, det.EstadoAnalisisDescripcion)
                                    </span>
                                    @if (det.Eliminada)
                                    {
                                        <span class="badge bg-dark ms-1" title="@TextoEliminada(det)">Eliminada</span>
                                        <div class="small text-muted">@TextoEliminada(det)</div>
                                    }
                                </td>
                                <td>@det.TurnoNombre</td>
                                <td class="text-end text-nowrap" @onclick:stopPropagation="true">
                                    @if (det.Eliminada)
                                    {
                                        @if (esAdministrador)
                                        {
                                            <button class="btn btn-sm btn-outline-success" title="Restaurar" @onclick="() => RestaurarDetencion(det.DetencionId)">
                                                <i class="bi bi-arrow-counterclockwise me-1"></i>Restaurar
                                            </button>
                                        }
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-outline-primary me-1" title="Ver detalle" @onclick="() => VerDetalle(det.DetencionId)">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                        @if (det.AnalisisPendiente)
                                        {
                                            <button class="btn btn-sm me-1" title="@TituloAnalisis(det)" style="color: var(--bs-orange); border: 1px solid var(--bs-orange);"
                                                    @onclick="() => VerDetalle(det.DetencionId)">
                                                <i class="bi bi-tools"></i>
                                            </button>
                                        }
                                        @if (det.EstadoActual != "CERRADA" && puedeCargar)
                                        {
                                            <button class="btn btn-sm btn-outline-secondary me-1" title="Editar" @onclick="() => EditarDetencion(det)">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                        }
                                        @if (esAdministrador)
                                        {
                                            <button class="btn btn-sm btn-outline-danger" title="Eliminar" @onclick="() => AbrirEliminar(det)">
                                                <i class="bi bi-trash3"></i>
                                            </button>
                                        }
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Paginacion -->
        @if (detenciones.TotalPages > 1)
        {
            <nav class="mt-3">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                        <button class="page-link" @onclick="() => CambiarPagina(currentPage - 1)">Anterior</button>
                    </li>
                    @foreach (var pagina in PaginasVisibles())
                    {
                        var pageNum = pagina;
                        @if (pageNum == 0)
                        {
                            <li class="page-item disabled"><span class="page-link">…</span></li>
                        }
                        else
                        {
                            <li class="page-item @(currentPage == pageNum ? "active" : "")">
                                <button class="page-link" @onclick="() => CambiarPagina(pageNum)">@pageNum</button>
                            </li>
                        }
                    }
                    <li class="page-item @(currentPage == detenciones.TotalPages ? "disabled" : "")">
                        <button class="page-link" @onclick="() => CambiarPagina(currentPage + 1)">Siguiente</button>
                    </li>
                </ul>
            </nav>
        }

        <p class="text-muted text-center mt-2">
            Página @currentPage de @Math.Max(detenciones.TotalPages, 1) · @detenciones.TotalCount detenciones
        </p>
    }
    else
    {
        <div class="alert alert-info">
            No se encontraron detenciones con los filtros seleccionados. Probá con otras fechas o tocá <em>Limpiar filtros</em>.
        </div>
    }
</div>

@* Modal Nueva/Editar Detencion *@
@if (showModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(editando ? "Editar detención" : "Nueva detención")</h5>
                    <button type="button" class="btn-close" @onclick="CerrarModal"></button>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="@(editando ? "col-12" : "col-lg-8")">
                            @if (!string.IsNullOrEmpty(errorMessage))
                            {
                                <div class="alert alert-danger">@errorMessage</div>
                            }

                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label class="form-label">Línea *</label>
                                    <fieldset disabled="@editando">
                                        <AutocompleteSelect TItem="LineaDto"
                                                            TValue="int"
                                                            Items="lineasDisponibles"
                                                            @bind-SelectedValue="selectedLineaId"
                                                            OnValueChanged="OnLineaChanged"
                                                            ValueSelector="@(l => l.LineaId)"
                                                            TextSelector="@(l => l.Nombre)"
                                                            EmptyText="No tenés líneas asignadas. Pedile al administrador que te asigne una."
                                                            Placeholder="Buscar línea...">
                                            <ItemTemplate Context="linea">
                                                @linea.Nombre
                                            </ItemTemplate>
                                        </AutocompleteSelect>
                                    </fieldset>
                                    @if (!editando && errorCatalogos)
                                    {
                                        <div class="form-text text-danger">No se pudo cargar la lista de líneas. Cerrá esta ventana y recargá la página.</div>
                                    }
                                    else if (!editando && !lineasDisponibles.Any())
                                    {
                                        <div class="form-text text-danger">No tenés líneas asignadas. Pedile al administrador que te asigne una.</div>
                                    }
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Fecha *</label>
                                    <input type="date" class="form-control" @bind="model.Fecha" max="@HoyIso"
                                           @bind:after="@(() => errorMessage = null)" />
                                </div>
                            </div>

                            <div class="row mb-3">
                                <div class="col-md-4">
                                    <label class="form-label">Hora inicio</label>
                                    <input type="time" class="form-control" value="@horaInicioTexto" disabled="@editandoPlc" @onchange="CambiarHoraInicio" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Hora fin</label>
                                    <input type="time" class="form-control" value="@horaFinTexto" disabled="@editandoPlc" @onchange="CambiarHoraFin" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Minutos de parada @(editandoPlc || MinutosManuales.HasValue ? "" : "*")</label>
                                    @if (editandoPlc)
                                    {
                                        <div class="form-control bg-light">
                                            <strong>@editandoDetencion!.MinutosEfectivos</strong> min
                                            <small class="text-muted ms-1">del PLC</small>
                                        </div>
                                    }
                                    else if (MinutosManuales is int minutosCalculados)
                                    {
                                        <div class="form-control bg-light">
                                            <strong>@minutosCalculados</strong> min
                                            <small class="text-muted ms-1">calculados por horas</small>
                                        </div>
                                        @if (CruzaMedianoche)
                                        {
                                            <div class="form-text">Termina al día siguiente (cruza la medianoche).</div>
                                        }
                                        @if (minutosCalculados > 12 * 60)
                                        {
                                            <div class="form-text text-danger">Revisá las horas: son más de 12 h de parada.</div>
                                        }
                                    }
                                    else
                                    {
                                        <input type="number" class="form-control" @bind="model.MinutosDeclarados" min="1"
                                               @bind:after="@(async () => await ActualizarAvisoAnalisisAsync())" />
                                        <div class="form-text">O cargá hora de inicio y fin y se calculan solos.</div>
                                    }
                                </div>
                            </div>

                            @* Información de Maquinista y Turno *@
                            @if (selectedLineaId > 0)
                            {
                                <div class="row mb-3">
                                    <div class="col-md-6">
                                        <label class="form-label">Maquinista @(puedeSeleccionarMaquinista && !editando ? "*" : "")</label>
                                        @if (editando)
                                        {
                                            <div class="form-control bg-light @(string.IsNullOrWhiteSpace(maquinistaGuardado) ? "text-muted" : "")">
                                                <i class="bi bi-person-fill me-2"></i>@(string.IsNullOrWhiteSpace(maquinistaGuardado) ? "No registrado" : maquinistaGuardado)
                                            </div>
                                        }
                                        else if (puedeSeleccionarMaquinista)
                                        {
                                            @* Admin/Supervisor eligen cualquier maquinista de la línea *@
                                            <select class="form-select" @bind="selectedMaquinistaId" @bind:after="OnMaquinistaChanged">
                                                <option value="0">-- Elegí el maquinista --</option>
                                                @foreach (var maq in maquinistasLinea)
                                                {
                                                    <option value="@maq.UsuarioLineaId">@maq.NombreUsuario · @(string.IsNullOrEmpty(maq.TurnoNombre) ? "sin turno" : maq.TurnoNombre)</option>
                                                }
                                            </select>
                                            @if (!maquinistasLinea.Any())
                                            {
                                                <div class="form-text text-danger">Esta línea no tiene maquinistas asignados. Pedile al administrador que los cargue en Configuración → Maquinistas.</div>
                                            }
                                            else if (MaquinistaElegido is { TurnoId: null } && !HorasCargadas)
                                            {
                                                <div class="form-text text-warning-emphasis">Este maquinista no tiene turno. Cargá la hora de inicio y fin, o asignale un turno en Configuración → Maquinistas.</div>
                                            }
                                        }
                                        else if (maquinistaActual != null)
                                        {
                                            <div class="form-control bg-light">
                                                <i class="bi bi-person-fill me-2 text-primary"></i>@maquinistaActual.NombreUsuario
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="form-control bg-light text-muted">
                                                <i class="bi bi-person me-2"></i>Vos (no figurás como maquinista de esta línea)
                                            </div>
                                        }
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">Turno</label>
                                        @if (editando && !horasEditadas)
                                        {
                                            <div class="form-control bg-light">
                                                <i class="bi bi-clock-fill me-2 text-success"></i>@editandoDetencion?.TurnoNombre
                                            </div>
                                            <div class="form-text">No cambia salvo que cambies la hora de inicio.</div>
                                        }
                                        else if (HorasCargadas)
                                        {
                                            <div class="form-control bg-light">
                                                <i class="bi bi-clock-fill me-2 text-success"></i>Según hora de inicio
                                            </div>
                                        }
                                        else if (!string.IsNullOrEmpty(turnoAsignado))
                                        {
                                            <div class="form-control bg-light">
                                                <i class="bi bi-clock-fill me-2 text-success"></i>@turnoAsignado
                                            </div>
                                        }
                                        else if (MaquinistaElegido is { TurnoId: null })
                                        {
                                            <div class="form-control bg-warning-subtle text-warning-emphasis">
                                                <i class="bi bi-exclamation-triangle me-2"></i>Cargá hora de inicio y fin
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="form-control bg-warning-subtle text-warning-emphasis">
                                                <i class="bi bi-clock me-2"></i>El de ahora (@resumenTurno.TurnoNombre)
                                            </div>
                                            <div class="form-text">Si la parada fue en otro turno, cargá la hora de inicio y fin.</div>
                                        }
                                    </div>
                                </div>
                            }

                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label class="form-label">Equipo</label>
                                    <AutocompleteSelect TItem="EquipoDto"
                                                        TValue="int?"
                                                        Items="equipos"
                                                        @bind-SelectedValue="model.EquipoId"
                                                        OnValueChanged="OnEquipoChanged"
                                                        ValueSelector="@(e => (int?)e.EquipoId)"
                                                        TextSelector="@(e => e.Nombre)"
                                                        Disabled="@(selectedLineaId == 0)"
                                                        EmptyText="Esta línea no tiene equipos cargados. Podés dejar el equipo vacío."
                                                        Placeholder="@(selectedLineaId == 0 ? "Elegí primero la línea" : "Buscar equipo...")">
                                        <ItemTemplate Context="equipo">
                                            @equipo.Nombre
                                        </ItemTemplate>
                                    </AutocompleteSelect>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Tipo de Falla</label>
                                    <AutocompleteSelect TItem="TipoFallaDto"
                                                        TValue="int?"
                                                        Items="tiposFalla"
                                                        @bind-SelectedValue="model.TipoFallaId"
                                                        OnValueChanged="OnTipoFallaChanged"
                                                        ValueSelector="@(t => (int?)t.TipoFallaId)"
                                                        TextSelector="@(t => t.Nombre)"
                                                        Placeholder="Buscar tipo de falla...">
                                        <ItemTemplate Context="tipo">
                                            @tipo.Nombre
                                        </ItemTemplate>
                                    </AutocompleteSelect>
                                </div>
                            </div>

                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label class="form-label">Detalle de Falla</label>
                                    <AutocompleteSelect TItem="DetalleFallaDto"
                                                        TValue="int?"
                                                        Items="detallesFalla"
                                                        @bind-SelectedValue="model.DetalleFallaId"
                                                        ValueSelector="@(d => (int?)d.DetalleFallaId)"
                                                        TextSelector="@(d => d.Nombre)"
                                                        Disabled="@(!model.TipoFallaId.HasValue)"
                                                        EmptyText="No hay detalles cargados para este tipo de falla. Podés dejar el detalle vacío."
                                                        Placeholder="@(model.TipoFallaId.HasValue ? "Buscar detalle..." : "Elegí primero el tipo de falla")">
                                        <ItemTemplate Context="detalle">
                                            @detalle.Nombre
                                        </ItemTemplate>
                                    </AutocompleteSelect>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Descripción *</label>
                                <textarea class="form-control" @bind="model.Descripcion" rows="4"
                                    @bind:after="@(() => errorMessage = null)"
                                    placeholder="Describí qué pasó y la causa de la detención..."></textarea>
                            </div>

                            @if (requiereAnalisisPrevio)
                            {
                                <div class="alert alert-warning d-flex align-items-start gap-2 mb-0">
                                    <i class="bi bi-tools mt-1"></i>
                                    <div>
                                        @if (!editando)
                                        {
                                            <strong>Esta detención va a requerir análisis.</strong>
                                            <span>Al registrarla le aparece al responsable en <em>Mis pendientes</em>.</span>
                                        }
                                        else if (editandoDetencion?.RequiereAnalisis == true)
                                        {
                                            <strong>Esta detención requiere análisis.</strong>
                                            <span>Está en <em>Mis pendientes</em> del responsable.</span>
                                        }
                                        else
                                        {
                                            <strong>Con estos cambios la detención va a requerir análisis.</strong>
                                            <span>Al guardar los cambios, le aparece al responsable en <em>Mis pendientes</em>.</span>
                                        }
                                    </div>
                                </div>
                            }
                        </div>

                        @if (!editando)
                        {
                        <div class="col-lg-4">
                            <div class="card bg-light">
                                <div class="card-header bg-info text-white">
                                    <h6 class="mb-0">
                                        <i class="bi bi-clock-history me-2"></i>
                                        Acumulado del Turno
                                    </h6>
                                </div>
                                <div class="card-body">
                                    @if (isLoadingResumen)
                                    {
                                        <div class="text-center py-3">
                                            <div class="spinner-border spinner-border-sm text-info"></div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="mb-2">
                                            <small class="text-muted">Turno:</small>
                                            <strong class="ms-2">@resumenTurno.TurnoNombre</strong>
                                        </div>
                                        @if (resumenTurno.Items.Any())
                                        {
                                            <table class="table table-sm mb-0">
                                                <thead>
                                                    <tr>
                                                        <th>Tipo</th>
                                                        <th class="text-center">Cant</th>
                                                        <th class="text-end">Min</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var item in resumenTurno.Items.Take(5))
                                                    {
                                                        <tr>
                                                            <td><small>@item.TipoFallaNombre</small></td>
                                                            <td class="text-center">@item.CantidadDetenciones</td>
                                                            <td class="text-end">@item.TotalMinutos</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                                <tfoot class="fw-bold">
                                                    <tr>
                                                        <td>Total</td>
                                                        <td class="text-center">@resumenTurno.Items.Sum(i => i.CantidadDetenciones)</td>
                                                        <td class="text-end">@resumenTurno.TotalMinutos</td>
                                                    </tr>
                                                </tfoot>
                                            </table>
                                        }
                                        else
                                        {
                                            <p class="text-muted text-center mb-0">Todavía no hay detenciones en este turno.</p>
                                        }
                                    }
                                </div>
                            </div>
                        </div>
                        }
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CerrarModal">Cancelar</button>
                    <button type="button" class="btn btn-primary" @onclick="GuardarDetencion" disabled="@isSubmitting">
                        @if (isSubmitting)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        @(editando ? "Actualizar" : "Registrar")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (detencionAEliminar != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-trash3 text-danger me-2"></i>Eliminar detención
                    </h5>
                    <button type="button" class="btn-close" @onclick="CerrarEliminar"></button>
                </div>
                <div class="modal-body">
                    <p>
                        Vas a eliminar <strong>@detencionAEliminar.Codigo</strong>
                        (@(detencionAEliminar.EquipoNombre ?? "-") · @detencionAEliminar.MinutosEfectivos min · @detencionAEliminar.Fecha.ToString("dd/MM/yyyy")).
                    </p>
                    <div class="alert alert-secondary small">
                        No se borra de la base. Queda marcada como eliminada, con usuario, fecha y motivo, y deja de contar en indicadores y reportes.
                        Se puede ver con el filtro <em>Incluir eliminadas</em> y restaurar.
                    </div>
                    <label class="form-label">Motivo <span class="text-danger">*</span></label>
                    <textarea class="form-control" rows="3" maxlength="500" @bind="motivoEliminacion" @bind:event="oninput"
                              placeholder="Por qué se elimina la detención..."></textarea>
                    @if (errorEliminar)
                    {
                        <div class="text-danger small mt-2">No se pudo eliminar la detención. Intentá de nuevo.</div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CerrarEliminar">Cancelar</button>
                    <button type="button" class="btn btn-danger" @onclick="ConfirmarEliminar"
                            disabled="@(string.IsNullOrWhiteSpace(motivoEliminacion) || isSubmitting)">
                        <i class="bi bi-trash3 me-1"></i>Eliminar
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private PagedResult<DetencionDto> detenciones = new();
    private List<LineaDto> lineas = new();
    private List<LineaDto> lineasDisponibles = new();
    private List<MaquinistaDto> misAsignaciones = new();
    private List<MaquinistaDto> maquinistasLinea = new();  // Maquinistas de la linea seleccionada
    private MaquinistaDto? maquinistaActual;
    private string? turnoAsignado;
    private int selectedMaquinistaId;
    private bool puedeSeleccionarMaquinista;  // True si es Admin/Supervisor
    private bool puedeCargar;                 // Mismos roles que la política CanCreateDetenciones
    private bool esSoloOperario;
    private bool esAdministrador;
    private ClaimsPrincipal? usuario;
    private string? maquinistaGuardado;
    private List<EquipoDto> equipos = new();
    private List<TipoFallaDto> tiposFalla = new();
    private List<DetalleFallaDto> detallesFalla = new();
    private ResumenTurnoResponse resumenTurno = new();

    private bool isLoading = true;
    private bool showModal = false;
    private bool editando = false;
    private bool isSubmitting = false;
    private bool isLoadingResumen = false;
    private bool requiereAnalisisPrevio = false;
    private string? errorMessage;
    private string? mensajeError;
    private string? mensajeAviso;
    private string? errorCarga;
    private bool errorCatalogos;

    private int currentPage = 1;
    private int pageSize = 10;
    private int? filtroLineaId;
    private string? filtroEstado;
    private string? filtroAnalisis;   // "PENDIENTE" | "SIN" | null (todos)
    private bool verEliminadas;
    private DateTime? filtroFechaDesde;
    private DateTime? filtroFechaHasta;
    private string? filtroBusqueda;
    private System.Timers.Timer? debounceTimer;

    private CrearDetencionRequest model = new();
    private int selectedLineaId;
    private DetencionDto? editandoDetencion;
    private string? horaInicioTexto;
    private string? horaFinTexto;
    private bool horasEditadas;

    private DetencionDto? detencionAEliminar;
    private string? motivoEliminacion;
    private bool errorEliminar;

    private IJSObjectReference? moduloDescargas;

    private bool HorasCargadas => ParsearHora(horaInicioTexto).HasValue && ParsearHora(horaFinTexto).HasValue;

    private static string HoyIso => DateTime.Today.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);

    private MaquinistaDto? MaquinistaElegido =>
        selectedMaquinistaId > 0 ? maquinistasLinea.FirstOrDefault(m => m.UsuarioLineaId == selectedMaquinistaId) : null;

    private bool CruzaMedianoche =>
        ParsearHora(horaInicioTexto) is { } inicio && ParsearHora(horaFinTexto) is { } fin && fin < inicio;

    /// <summary>
    /// Las horas de una detención del PLC se ven pero no se editan.
    /// </summary>
    private bool editandoPlc => editandoDetencion?.OrigenTiempo == "PLC";

    /// <summary>
    /// Minutos entre inicio y fin. Si el fin es anterior, cruza medianoche. Sólo para mostrar; el backend recalcula.
    /// </summary>
    private int? MinutosManuales
    {
        get
        {
            var inicio = ParsearHora(horaInicioTexto);
            var fin = ParsearHora(horaFinTexto);
            if (!inicio.HasValue || !fin.HasValue) return null;

            var diferencia = fin.Value.ToTimeSpan() - inicio.Value.ToTimeSpan();
            if (diferencia < TimeSpan.Zero) diferencia += TimeSpan.FromDays(1);
            return (int)diferencia.TotalMinutes;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        // Verificar si el usuario puede seleccionar maquinista (Admin/Gerencia/Supervisor)
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        usuario = user;
        puedeSeleccionarMaquinista = user.IsInRole("ADMINISTRADOR") ||
                                      user.IsInRole("SUPERVISOR");
        esAdministrador = user.IsInRole("ADMINISTRADOR");
        puedeCargar = new[] { "ADMINISTRADOR", "MANTENIMIENTO", "SUPERVISOR", "OPERARIO" }.Any(user.IsInRole);
        esSoloOperario = user.IsInRole("OPERARIO")
            && !new[] { "ADMINISTRADOR", "MANTENIMIENTO", "SUPERVISOR" }.Any(user.IsInRole);

        await CargarLineas();
        await CargarDetenciones();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            moduloDescargas = await JS.InvokeAsync<IJSObjectReference>("import", "./js/descargas.js");
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (moduloDescargas != null)
        {
            await moduloDescargas.DisposeAsync();
        }
    }

    private async Task CargarLineas()
    {
        try
        {
            var lineasTask = CatalogosService.GetLineasAsync();
            var tiposFallaTask = CatalogosService.GetTiposFallaAsync();
            var asignacionesTask = CatalogosService.GetMisAsignacionesAsync();

            await Task.WhenAll(lineasTask, tiposFallaTask, asignacionesTask);

            lineas = await lineasTask;
            tiposFalla = await tiposFallaTask;
            misAsignaciones = await asignacionesTask;

            // Si el usuario tiene asignaciones, filtrar lineas a solo las asignadas
            if (misAsignaciones.Any())
            {
                var lineasAsignadasIds = misAsignaciones.Select(a => a.LineaId).ToHashSet();
                lineasDisponibles = lineas.Where(l => lineasAsignadasIds.Contains(l.LineaId)).ToList();
            }
            else
            {
                // Sin asignaciones: el operario no puede cargar (la API lo rechaza); el resto ve todas.
                lineasDisponibles = esSoloOperario ? new() : lineas;
            }
            errorCatalogos = false;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error cargando catálogos: {ex.Message}");
            errorCatalogos = true;
        }
    }

    private DetencionFiltroRequest ConstruirFiltro() => new()
    {
        Page = currentPage,
        PageSize = pageSize,
        LineaId = filtroLineaId,
        Estado = filtroEstado,
        FechaDesde = filtroFechaDesde.HasValue ? DateOnly.FromDateTime(filtroFechaDesde.Value) : null,
        FechaHasta = filtroFechaHasta.HasValue ? DateOnly.FromDateTime(filtroFechaHasta.Value) : null,
        Busqueda = filtroBusqueda,
        AnalisisPendiente = filtroAnalisis switch
        {
            "PENDIENTE" => true,
            "SIN" => false,
            _ => null
        },
        VerEliminadas = esAdministrador && verEliminadas
    };

    private async Task CargarDetenciones()
    {
        isLoading = true;
        errorCarga = null;
        try
        {
            detenciones = await DetencionesService.GetDetencionesConFiltrosAsync(ConstruirFiltro());
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
            // No dejar a la vista filas que no corresponden al filtro.
            detenciones = new PagedResult<DetencionDto>();
            errorCarga = "No se pudieron cargar las detenciones. Revisá la conexión y recargá la página.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task AplicarFiltros()
    {
        currentPage = 1;
        await CargarDetenciones();
    }

    private async Task CambiarPagina(int page)
    {
        currentPage = page;
        await CargarDetenciones();
    }

    private async Task LimpiarFiltros()
    {
        filtroLineaId = null;
        filtroEstado = null;
        filtroAnalisis = null;
        verEliminadas = false;
        filtroFechaDesde = null;
        filtroFechaHasta = null;
        filtroBusqueda = null;
        currentPage = 1;
        await CargarDetenciones();
    }

    private void OnBusquedaKeyUp()
    {
        debounceTimer?.Stop();
        debounceTimer?.Dispose();
        debounceTimer = new System.Timers.Timer(400);
        debounceTimer.Elapsed += async (s, e) =>
        {
            debounceTimer?.Stop();
            await InvokeAsync(async () =>
            {
                currentPage = 1;
                await CargarDetenciones();
                StateHasChanged();
            });
        };
        debounceTimer.AutoReset = false;
        debounceTimer.Start();
    }

    private async Task LimpiarBusqueda()
    {
        filtroBusqueda = null;
        currentPage = 1;
        await CargarDetenciones();
    }

    private async Task ExportarExcel()
    {
        mensajeError = null;
        mensajeAviso = null;
        if (errorCarga == null && detenciones.TotalCount == 0)
        {
            mensajeAviso = "No hay detenciones para exportar con estos filtros.";
            return;
        }
        var contenido = await DetencionesService.ExportarExcelAsync(ConstruirFiltro());
        if (contenido == null || moduloDescargas == null)
        {
            mensajeError = "No se pudo exportar el Excel. Intentá de nuevo.";
            return;
        }

        await moduloDescargas.InvokeVoidAsync(
            "descargarArchivo",
            $"detenciones_{DateTime.Now:yyyyMMdd_HHmmss}.xlsx",
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
            Convert.ToBase64String(contenido));
    }

    private async Task AbrirModalNueva()
    {
        model = new CrearDetencionRequest();
        selectedLineaId = 0;
        selectedMaquinistaId = 0;
        maquinistaActual = null;
        turnoAsignado = null;
        maquinistasLinea.Clear();
        equipos.Clear();
        detallesFalla.Clear();
        editando = false;
        editandoDetencion = null;
        errorMessage = null;
        requiereAnalisisPrevio = false;
        horaInicioTexto = null;
        horaFinTexto = null;
        horasEditadas = false;
        maquinistaGuardado = null;
        showModal = true;
        await CargarResumenTurno();
    }

    private async Task EditarDetencion(DetencionDto det)
    {
        model = new CrearDetencionRequest
        {
            LineaId = det.LineaId,
            EquipoId = det.EquipoId,
            TipoFallaId = det.TipoFallaId,
            DetalleFallaId = det.DetalleFallaId,
            Fecha = DateOnly.FromDateTime(det.Fecha),
            MinutosDeclarados = det.MinutosEfectivos,
            Descripcion = det.Descripcion
        };
        selectedLineaId = det.LineaId;

        // Si la detención tiene horas reales (cargadas o del PLC), las mostramos. Sólo se reenvían si el usuario las cambia.
        var conHoras = det.OrigenTiempo is "CALCULADO" or "PLC" && det.FechaHoraParada.HasValue && det.FechaHoraArranque.HasValue;
        horaInicioTexto = conHoras ? det.FechaHoraParada!.Value.ToLocalTime().ToString("HH:mm", CultureInfo.InvariantCulture) : null;
        horaFinTexto = conHoras ? det.FechaHoraArranque!.Value.ToLocalTime().ToString("HH:mm", CultureInfo.InvariantCulture) : null;
        horasEditadas = false;

        if (model.LineaId > 0)
        {
            equipos = await CatalogosService.GetEquiposAsync(model.LineaId);
        }
        if (model.TipoFallaId.HasValue)
        {
            detallesFalla = await CatalogosService.GetDetallesFallaAsync(model.TipoFallaId, model.EquipoId);
        }

        editandoDetencion = det;
        editando = true;
        errorMessage = null;
        maquinistaGuardado = null;
        showModal = true;
        await ActualizarAvisoAnalisisAsync();
        try
        {
            // La lista no trae el maquinista; el detalle sí.
            maquinistaGuardado = (await DetencionesService.GetDetencionAsync(det.DetencionId))?.CreadoPorUsuarioNombre;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error cargando el maquinista: {ex.Message}");
            maquinistaGuardado = null;
        }
    }

    private void CerrarModal()
    {
        showModal = false;
        editandoDetencion = null;
        requiereAnalisisPrevio = false;
        model = new();
    }

    private async Task OnLineaChanged()
    {
        errorMessage = null;
        model.LineaId = selectedLineaId;
        maquinistaActual = null;
        turnoAsignado = null;
        selectedMaquinistaId = 0;
        maquinistasLinea.Clear();

        if (selectedLineaId > 0)
        {
            if (puedeSeleccionarMaquinista)
            {
                // Admin/Gerencia/Supervisor: cargar todos los maquinistas de la linea
                maquinistasLinea = await CatalogosService.GetMaquinistasAsync(selectedLineaId);
            }
            else
            {
                // Operario: buscar su propia asignacion para esta linea
                var asignacion = misAsignaciones.FirstOrDefault(a => a.LineaId == selectedLineaId);
                if (asignacion != null)
                {
                    maquinistaActual = asignacion;
                    if (asignacion.TurnoId.HasValue)
                    {
                        turnoAsignado = asignacion.TurnoNombre;
                    }
                }
            }

            equipos = await CatalogosService.GetEquiposAsync(selectedLineaId);
            await CargarResumenTurno();
        }
        else
        {
            equipos.Clear();
        }
        model.EquipoId = null;
        await ActualizarAvisoAnalisisAsync();
    }

    private async Task OnMaquinistaChanged()
    {
        errorMessage = null;
        turnoAsignado = null;

        if (selectedMaquinistaId > 0)
        {
            var maquinista = maquinistasLinea.FirstOrDefault(m => m.UsuarioLineaId == selectedMaquinistaId);
            if (maquinista != null)
            {
                turnoAsignado = maquinista.TurnoNombre;
            }
        }
        await Task.CompletedTask;
    }

    private async Task OnEquipoChanged()
    {
        // Recargar detalles de falla si hay tipo de falla seleccionado
        if (model.TipoFallaId.HasValue)
        {
            detallesFalla = await CatalogosService.GetDetallesFallaAsync(model.TipoFallaId, model.EquipoId);
        }
        await ActualizarAvisoAnalisisAsync();
    }

    private async Task OnTipoFallaChanged()
    {
        if (model.TipoFallaId.HasValue)
        {
            detallesFalla = await CatalogosService.GetDetallesFallaAsync(model.TipoFallaId, model.EquipoId);
        }
        else
        {
            detallesFalla.Clear();
        }
        model.DetalleFallaId = null;
        await ActualizarAvisoAnalisisAsync();
    }

    /// <summary>
    /// Pregunta al backend si la detención, tal como está cargada, va a requerir análisis.
    /// No guarda nada.
    /// </summary>
    private async Task ActualizarAvisoAnalisisAsync()
    {
        errorMessage = null;
        AplicarHorasAlModelo();
        model.LineaId = selectedLineaId;
        requiereAnalisisPrevio = selectedLineaId > 0
            && model.TipoFallaId.HasValue
            && await DetencionesService.PrevisualizarAnalisisAsync(model);
    }

    private async Task CargarResumenTurno()
    {
        isLoadingResumen = true;
        try
        {
            resumenTurno = await DetencionesService.GetResumenTurnoAsync(selectedLineaId > 0 ? selectedLineaId : null);
        }
        catch { }
        finally
        {
            isLoadingResumen = false;
        }
    }

    private async Task GuardarDetencion()
    {
        errorMessage = null;

        var inicio = ParsearHora(horaInicioTexto);
        var fin = ParsearHora(horaFinTexto);

        // Lo que falta, todo junto, para no descubrir los errores de a uno.
        var faltan = new List<string>();
        if (selectedLineaId == 0) faltan.Add("línea");
        if (!editando && puedeSeleccionarMaquinista && selectedMaquinistaId <= 0) faltan.Add("maquinista");
        if (!inicio.HasValue && !fin.HasValue && (model.MinutosDeclarados == null || model.MinutosDeclarados <= 0)) faltan.Add("minutos de parada (o hora de inicio y fin)");
        if (string.IsNullOrWhiteSpace(model.Descripcion)) faltan.Add("descripción");
        if (faltan.Any())
        {
            errorMessage = "Falta completar: " + UnirConY(faltan) + ".";
            return;
        }

        model.LineaId = selectedLineaId;
        if (!editando && puedeSeleccionarMaquinista)
        {
            model.UsuarioLineaId = selectedMaquinistaId;
        }

        if (model.Fecha > DateOnly.FromDateTime(DateTime.Today))
        {
            errorMessage = "La fecha no puede ser posterior a hoy.";
            return;
        }
        if (inicio.HasValue != fin.HasValue)
        {
            errorMessage = "Ingresá la hora de inicio y la de fin, o ninguna de las dos.";
            return;
        }
        if (editando && editandoDetencion is { OrigenTiempo: "CALCULADO", FechaHoraParada: not null } && !inicio.HasValue)
        {
            errorMessage = "Esta detención se cargó con horas: dejá la hora de inicio y la de fin.";
            return;
        }
        if (inicio.HasValue && MinutosManuales == 0)
        {
            errorMessage = "La hora de inicio y la de fin no pueden ser iguales.";
            return;
        }
        if (!editando && MaquinistaElegido is { TurnoId: null } && !inicio.HasValue)
        {
            errorMessage = "Este maquinista no tiene turno. Asignáselo en Configuración → Maquinistas o cargá la hora de inicio y fin.";
            return;
        }

        AplicarHorasAlModelo();
        isSubmitting = true;

        try
        {
            if (editando && editandoDetencion != null)
            {
                var (actualizada, error) = await DetencionesService.ActualizarDetencionAsync(
                    editandoDetencion.DetencionId, ConstruirActualizacion(editandoDetencion));
                if (actualizada)
                {
                    showModal = false;
                    await CargarDetenciones();
                }
                else
                {
                    errorMessage = error;
                }
            }
            else
            {
                var (creada, error) = await DetencionesService.CrearDetencionAsync(model);
                if (creada != null)
                {
                    showModal = false;
                    await CargarDetenciones();
                }
                else
                {
                    errorMessage = error;
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void AplicarHorasAlModelo()
    {
        // Un PLC no tiene horas editables: la previsualización usa sus minutos.
        model.HoraInicio = editandoPlc ? null : ParsearHora(horaInicioTexto);
        model.HoraFin = editandoPlc ? null : ParsearHora(horaFinTexto);
        model.OrigenTiempo = HorasCargadas && !editandoPlc ? "CALCULADO" : "DECLARADO";
    }

    private ActualizarDetencionRequest ConstruirActualizacion(DetencionDto det)
    {
        // Sólo se mandan horas si el usuario las cambió. Así no se recalculan por redondeo a minuto
        // ni cambian de turno al editar la descripción. Sin horas, el backend conserva el tiempo.
        var mandarHoras = horasEditadas && !editandoPlc;
        return new()
        {
            Fecha = model.Fecha,
            EquipoId = model.EquipoId,
            TipoFallaId = model.TipoFallaId,
            DetalleFallaId = model.DetalleFallaId,
            MinutosDeclarados = model.MinutosDeclarados,
            HoraInicio = mandarHoras ? model.HoraInicio : null,
            HoraFin = mandarHoras ? model.HoraFin : null,
            OrigenTiempo = mandarHoras ? model.OrigenTiempo : det.OrigenTiempo,
            Descripcion = model.Descripcion,
            AccionesRealizadas = det.AccionesRealizadas,
            ResolucionDescripcion = det.ResolucionDescripcion,
            RowVersion = det.RowVersion
        };
    }

    private void AbrirEliminar(DetencionDto det)
    {
        detencionAEliminar = det;
        motivoEliminacion = null;
        errorEliminar = false;
    }

    private void CerrarEliminar()
    {
        detencionAEliminar = null;
    }

    private async Task ConfirmarEliminar()
    {
        if (detencionAEliminar == null || string.IsNullOrWhiteSpace(motivoEliminacion)) return;

        isSubmitting = true;
        errorEliminar = false;
        try
        {
            if (await DetencionesService.EliminarDetencionAsync(detencionAEliminar.DetencionId, motivoEliminacion.Trim()))
            {
                detencionAEliminar = null;
                await CargarDetenciones();
            }
            else
            {
                errorEliminar = true;
            }
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task RestaurarDetencion(long id)
    {
        mensajeError = null;
        if (await DetencionesService.RestaurarDetencionAsync(id))
        {
            await CargarDetenciones();
        }
        else
        {
            mensajeError = "No se pudo restaurar la detención.";
        }
    }

    private async Task CambiarHoraInicio(ChangeEventArgs e)
    {
        errorMessage = null;
        horaInicioTexto = e.Value?.ToString();
        horasEditadas = true;
        await ActualizarAvisoAnalisisAsync();
    }

    private async Task CambiarHoraFin(ChangeEventArgs e)
    {
        errorMessage = null;
        horaFinTexto = e.Value?.ToString();
        horasEditadas = true;
        await ActualizarAvisoAnalisisAsync();
    }

    private static TimeOnly? ParsearHora(string? texto) =>
        TimeOnly.TryParseExact(texto, new[] { "HH:mm", "HH:mm:ss" }, CultureInfo.InvariantCulture, DateTimeStyles.None, out var hora)
            ? hora
            : null;

    /// <summary>
    /// La hora de parada sólo existe si se cargó con horas (CALCULADO o PLC). Las DECLARADO no tienen hora real.
    /// </summary>
    private static DateTimeOffset? HoraReal(DetencionDto det) =>
        det.OrigenTiempo != "DECLARADO" ? det.FechaHoraParada : null;

    private void AbrirFila(DetencionDto det)
    {
        // Las eliminadas no tienen detalle para el usuario común; sólo se restauran.
        if (!det.Eliminada)
        {
            VerDetalle(det.DetencionId);
        }
    }

    private void VerDetalle(long id)
    {
        Navigation.NavigateTo($"/detenciones/{id}");
    }

    private static string UnirConY(List<string> partes) =>
        partes.Count == 1 ? partes[0] : string.Join(", ", partes.Take(partes.Count - 1)) + " y " + partes[^1];

    /// <summary>
    /// Números de página a mostrar: la primera, la última y hasta 5 alrededor de la actual. 0 es "…".
    /// </summary>
    private List<int> PaginasVisibles()
    {
        var total = detenciones.TotalPages;
        var desde = Math.Max(1, Math.Min(currentPage - 2, total - 4));
        var hasta = Math.Min(total, desde + 4);
        var paginas = new List<int>();
        if (desde > 1)
        {
            paginas.Add(1);
            if (desde > 2) paginas.Add(0);
        }
        for (var i = desde; i <= hasta; i++) paginas.Add(i);
        if (hasta < total)
        {
            if (hasta < total - 1) paginas.Add(0);
            paginas.Add(total);
        }
        return paginas;
    }

    private static string TextoEliminada(DetencionDto det)
    {
        var quien = string.IsNullOrWhiteSpace(det.EliminadaPorUsuarioNombre) ? "" : $" por {det.EliminadaPorUsuarioNombre}";
        var cuando = det.FechaHoraEliminacion is { } fecha ? $" el {fecha.ToLocalTime():dd/MM/yyyy}" : "";
        var motivo = string.IsNullOrWhiteSpace(det.MotivoEliminacion) ? "" : $": {det.MotivoEliminacion}";
        return $"Eliminada{quien}{cuando}{motivo}";
    }

    /// <summary>
    /// El análisis lo completa el responsable o un administrador; el resto sólo lo ve.
    /// </summary>
    private string TituloAnalisis(DetencionDto det)
    {
        var esResponsable = (det.ResponsableUsuarioId != null && det.ResponsableUsuarioId == usuario?.FindFirst(ClaimTypes.NameIdentifier)?.Value)
            || (det.ResponsableRol != null && usuario?.IsInRole(det.ResponsableRol) == true);
        if (esAdministrador || esResponsable)
        {
            return "Completar análisis";
        }

        var quien = det.ResponsableRol is { Length: > 0 } rol
            ? char.ToUpperInvariant(rol[0]) + rol[1..].ToLowerInvariant()
            : "el responsable";
        return $"Ver análisis (lo completa {quien})";
    }
}
