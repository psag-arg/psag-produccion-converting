@page "/detenciones/{Id:long}"
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using PSAG.Mantenimiento.Web.Models
@using PSAG.Mantenimiento.Web.Services
@attribute [Authorize]
@inject IDetencionesService DetencionesService
@inject IAnalisisService AnalisisService
@inject ICatalogosService CatalogosService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Detención @(detencion?.Codigo ?? "") - PSAG Produccion</PageTitle>

<div class="container">
    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
        </div>
    }
    else if (detencion == null)
    {
        <div class="alert alert-warning">
            No se encontró la detención.
            <button class="btn btn-link" @onclick="VolverAlListado">Volver al listado</button>
        </div>
    }
    else
    {
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2>@detencion.Codigo</h2>
                <span class="@EstadoUi.BadgeClass(detencion.EstadoActual, detencion.AnalisisPendiente) fs-6"
                      style="@EstadoUi.BadgeStyle(detencion.EstadoActual, detencion.AnalisisPendiente)">
                    @EstadoUi.Texto(detencion.EstadoActualDescripcion, detencion.EstadoAnalisisDescripcion)
                </span>
            </div>
            <div class="d-flex align-items-center">
                @if (detencion.EstadoActual != "CERRADA" && !detencion.RequiereAnalisis)
                {
                    @if (puedeCerrarDetencion)
                    {
                        <button class="btn btn-success" @onclick="AbrirCerrarModal">
                            Cerrar detención
                        </button>
                    }
                    else
                    {
                        <small class="text-muted">La cierra Mantenimiento.</small>
                    }
                }
                @if (puedeEditar)
                {
                    <button class="btn btn-outline-primary ms-2" @onclick="EditarDetencion">
                        <i class="bi bi-pencil me-1"></i>Editar
                    </button>
                }
                <button class="btn btn-outline-secondary ms-2" @onclick="VolverAlListado">
                    Volver
                </button>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-body">
                <div class="row g-3">
                    @foreach (var (paso, indice) in ObtenerPasos().Select((p, i) => (p, i)))
                    {
                        <div class="col">
                            <div class="d-flex align-items-start">
                                <span class="badge rounded-pill me-2 @(paso.Actual ? "bg-primary" : paso.Hecho ? "bg-success" : "bg-secondary")">
                                    @if (paso.Hecho)
                                    {
                                        <i class="bi bi-check-lg"></i>
                                    }
                                    else
                                    {
                                        @(indice + 1)
                                    }
                                </span>
                                <div>
                                    <strong class="@(paso.Actual ? "text-primary" : "")">@paso.Titulo</strong>
                                    @if (!string.IsNullOrEmpty(paso.Detalle))
                                    {
                                        <div class="small text-muted">@paso.Detalle</div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-8">
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0">Información General</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="text-muted small">Fecha</label>
                                <div><strong>@detencion.Fecha.ToString("dd/MM/yyyy")</strong></div>
                            </div>
                            @if (detencion.OrigenTiempo != "DECLARADO" && detencion.FechaHoraParada is { } horaParada)
                            {
                                <div class="col-md-6 mb-3">
                                    <label class="text-muted small">Hora de parada</label>
                                    <div><strong>@horaParada.ToString("HH:mm")</strong></div>
                                </div>
                            }
                            <div class="col-md-6 mb-3">
                                <label class="text-muted small">Turno</label>
                                <div><strong>@detencion.TurnoNombre</strong></div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="text-muted small">Línea</label>
                                <div><strong>@detencion.LineaNombre</strong></div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="text-muted small">Equipo</label>
                                <div>
                                    <strong>@(detencion.EquipoNombre ?? "No especificado")</strong>
                                    @if (detencion.EquipoCritico)
                                    {
                                        <span class="badge bg-danger ms-2">Crítico</span>
                                    }
                                </div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="text-muted small">Tipo de Falla</label>
                                <div><strong>@(detencion.TipoFallaNombre ?? "No especificado")</strong></div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="text-muted small">Detalle de Falla</label>
                                <div><strong>@(detencion.DetalleFallaNombre ?? "No especificado")</strong></div>
                            </div>
                        </div>

                        <hr />

                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label class="text-muted small">Minutos Efectivos</label>
                                <div><span class="badge bg-primary fs-5">@detencion.MinutosEfectivos min</span></div>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="text-muted small">Maquinista</label>
                                <div><strong>@(string.IsNullOrWhiteSpace(detencion.CreadoPorUsuarioNombre) ? "No especificado" : detencion.CreadoPorUsuarioNombre)</strong></div>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="text-muted small">Registrado</label>
                                <div><strong>@detencion.FechaHoraCreacion.ToString("dd/MM/yyyy HH:mm")</strong></div>
                            </div>
                        </div>

                        <hr />

                        <div class="mb-3">
                            <label class="text-muted small">Descripción</label>
                            <div class="p-3 bg-light rounded">@detencion.Descripcion</div>
                        </div>

                        @* Con análisis, la solución se muestra en el bloque de Identificación de fallas *@
                        @if (!string.IsNullOrEmpty(detencion.AccionesRealizadas) && !detencion.RequiereAnalisis)
                        {
                            <div class="mb-3">
                                <label class="text-muted small">Acciones Realizadas</label>
                                <div class="p-3 bg-light rounded">@detencion.AccionesRealizadas</div>
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(detencion.ResolucionDescripcion))
                        {
                            <div class="mb-3">
                                <label class="text-muted small">Resolución</label>
                                <div class="p-3 bg-success bg-opacity-10 rounded">@detencion.ResolucionDescripcion</div>
                            </div>
                        }

                        @if (analisisSinRegla != null && (analisisSinRegla.Adjuntos.Any() || analisisSinRegla.Cambios.Any()))
                        {
                            @if (!string.IsNullOrEmpty(analisisSinRegla.CausaFalla))
                            {
                                <div class="mb-3">
                                    <label class="text-muted small">Causa de falla</label>
                                    <div class="p-3 bg-light rounded">@analisisSinRegla.CausaFalla</div>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(analisisSinRegla.PlanAccion))
                            {
                                <div class="mb-3">
                                    <label class="text-muted small">Plan de acción</label>
                                    <div class="p-3 bg-light rounded">@analisisSinRegla.PlanAccion</div>
                                </div>
                            }
                            @if (analisisSinRegla.Adjuntos.Any())
                            {
                                <div class="mb-3">
                                    <label class="text-muted small">Fotos</label>
                                    <FotosAnalisis DetencionId="Id" Adjuntos="analisisSinRegla.Adjuntos" />
                                </div>
                            }
                            <HistorialAnalisis Cambios="analisisSinRegla.Cambios" />
                        }
                    </div>
                </div>

                @if (detencion.RequiereAnalisis)
                {
                    <div class="card mb-4">
                        <div class="card-header">
                            <h5 class="mb-0"><i class="bi bi-clipboard2-pulse me-2"></i>Identificación de fallas</h5>
                        </div>
                        <div class="card-body">
                            @if (analisis == null)
                            {
                                <div class="text-muted">No se pudo cargar el análisis de la falla.</div>
                            }
                            else
                            {
                                @if (mensajeAnalisis != null)
                                {
                                    <div class="alert alert-@tipoMensaje py-2">@mensajeAnalisis</div>
                                }

                                @if (!AnalisisCerrado)
                                {
                                    <div class="small text-muted mb-3"><i class="bi bi-person me-1"></i>@ResponsableTexto(analisis)</div>
                                }

                                <div class="mb-4">
                                    <h6 class="mb-1">Solución (para resolver la falla) @if (analisis.PuedeEditar) { <span class="text-danger">*</span> }</h6>
                                    @if (analisis.PuedeEditar)
                                    {
                                        <textarea class="form-control @(faltaSolucion ? "is-invalid" : "")" rows="3" maxlength="@LargosAnalisis.Solucion"
                                                  @bind="solucionTexto" @bind:event="oninput" @bind:after="LimpiarFaltantes"
                                                  placeholder="Qué se hizo para resolver la falla"></textarea>
                                        <div class="form-text">@solucionTexto.Length de @LargosAnalisis.Solucion caracteres como máximo.</div>
                                    }
                                    else
                                    {
                                        <div class="p-3 bg-light rounded">@(string.IsNullOrEmpty(analisis.AccionesRealizadas) ? "Todavía sin completar." : analisis.AccionesRealizadas)</div>
                                    }
                                </div>

                                <div class="mb-4">
                                    <h6 class="mb-1">Causa de falla @if (analisis.PuedeEditar) { <span class="text-danger">*</span> }</h6>
                                    @if (analisis.PuedeEditar)
                                    {
                                        <textarea class="form-control @(faltaCausa ? "is-invalid" : "")" rows="3" maxlength="@LargosAnalisis.CausaYPlan"
                                                  @bind="causaTexto" @bind:event="oninput" @bind:after="LimpiarFaltantes"
                                                  placeholder="Causa raíz identificada"></textarea>
                                        <div class="form-text">@causaTexto.Length de @LargosAnalisis.CausaYPlan caracteres como máximo.</div>
                                    }
                                    else
                                    {
                                        <div class="p-3 bg-light rounded">@(string.IsNullOrEmpty(analisis.CausaFalla) ? "Todavía sin completar." : analisis.CausaFalla)</div>
                                    }
                                </div>

                                <div class="mb-4">
                                    <h6 class="mb-1">Plan de acción @if (!AnalisisCerrado) { <span class="text-muted small fw-normal">(opcional)</span> }</h6>
                                    @if (analisis.PuedeEditar)
                                    {
                                        <textarea class="form-control" rows="3" maxlength="@LargosAnalisis.CausaYPlan"
                                                  @bind="planTexto" @bind:event="oninput"
                                                  placeholder="Qué se hace para que no vuelva a pasar"></textarea>
                                        <div class="form-text">@planTexto.Length de @LargosAnalisis.CausaYPlan caracteres como máximo.</div>
                                    }
                                    else
                                    {
                                        <div class="p-3 bg-light rounded">@(string.IsNullOrEmpty(analisis.PlanAccion) ? (AnalisisCerrado ? "No se cargó plan de acción." : "Todavía sin completar.") : analisis.PlanAccion)</div>
                                    }
                                </div>

                                @if (analisis.Adjuntos.Any() || (analisis.PuedeAdjuntar && !AnalisisCerrado))
                                {
                                    <div class="mb-4">
                                        <h6 class="mb-1">Fotos @if (!AnalisisCerrado) { <span class="text-muted small fw-normal">(opcional)</span> }</h6>
                                        <FotosAnalisis DetencionId="Id" Adjuntos="analisis.Adjuntos"
                                                       PuedeAdjuntar="@(analisis.PuedeAdjuntar && !AnalisisCerrado)"
                                                       OnAgregada="@(a => analisis.Adjuntos.Add(a))" />
                                    </div>
                                }

                                @if (AnalisisCerrado && analisis.PuedeEditarCerrado)
                                {
                                    <div class="mb-3">
                                        <a class="btn btn-outline-primary btn-sm" href="@($"detenciones/soluciones?busqueda={Uri.EscapeDataString(detencion.Codigo)}")">
                                            <i class="bi bi-pencil me-1"></i>Editar en la base de soluciones
                                        </a>
                                    </div>
                                }

                                <HistorialAnalisis Cambios="analisis.Cambios" />

                                <hr />

                                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                                    <small class="text-muted">
                                        @if (analisis.FechaHoraAnalisis.HasValue)
                                        {
                                            <span>Firma: <strong>@(analisis.AnalisisPorUsuarioNombre ?? "usuario")</strong> · @analisis.FechaHoraAnalisis.Value.ToString("dd/MM/yyyy HH:mm")</span>
                                        }
                                        else
                                        {
                                            <span>Firma: queda con usuario y fecha al cerrar el análisis</span>
                                        }
                                    </small>
                                    @if (analisis.PuedeEditar && !confirmandoCierre)
                                    {
                                        <div class="text-end">
                                            <button class="btn btn-outline-primary me-2" @onclick="GuardarBorrador" disabled="@(guardandoAnalisis || FormularioVacio)">
                                                Guardar borrador
                                            </button>
                                            <button class="btn btn-success" @onclick="CerrarAnalisis" disabled="@guardandoAnalisis">
                                                Cerrar análisis
                                            </button>
                                            <div class="form-text">
                                                @(FormularioVacio ? "Escribí algo antes de guardar el borrador. " : "")Una vez cerrado, solo administración o supervisión pueden corregirlo.
                                            </div>
                                        </div>
                                    }
                                </div>

                                @if (confirmandoCierre)
                                {
                                    <div class="alert alert-warning mt-3 mb-0 d-flex justify-content-between align-items-center flex-wrap gap-2">
                                        <span><strong>Al cerrar el análisis ya no lo podés modificar</strong> (solo administración o supervisión pueden corregirlo). ¿Lo cerrás?</span>
                                        <div>
                                            <button class="btn btn-outline-secondary btn-sm me-2" @onclick="() => confirmandoCierre = false" disabled="@guardandoAnalisis">
                                                Volver
                                            </button>
                                            <button class="btn btn-success btn-sm" @onclick="ConfirmarCierreAnalisis" disabled="@guardandoAnalisis">
                                                @if (guardandoAnalisis)
                                                {
                                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                                }
                                                Sí, cerrar análisis
                                            </button>
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                }
            </div>

            <div class="col-md-4">
                @if (detencion.RequiereAnalisis && analisis != null)
                {
                    <div class="card mb-4">
                        <div class="card-header">
                            <h6 class="mb-0">Por qué está acá</h6>
                        </div>
                        <div class="card-body">
                            <strong>Requiere análisis</strong>
                            <div class="small text-muted mt-1">
                                Regla: @(analisis.TipoFallaNombre ?? "tipo de falla")
                                @if (analisis.MinutosMinimosRegla.HasValue)
                                {
                                    <span> ≥ @analisis.MinutosMinimosRegla min</span>
                                }
                            </div>
                            <div class="small text-muted">Asignada a: @(analisis.ResponsableNombre ?? "sin asignar")</div>
                        </div>
                    </div>

                    <div class="card mb-4">
                        <div class="card-header">
                            <h6 class="mb-0">Fallas parecidas</h6>
                        </div>
                        <div class="card-body p-0">
                            @if (analisis.FallasParecidas.Any())
                            {
                                <ul class="list-group list-group-flush">
                                    @foreach (var parecida in analisis.FallasParecidas)
                                    {
                                        <li class="list-group-item">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <a href="detenciones/@parecida.DetencionId"><strong>@parecida.Codigo</strong></a>
                                                <span class="badge bg-secondary">@parecida.MinutosEfectivos min</span>
                                            </div>
                                            <div class="small text-muted">@(parecida.EquipoNombre ?? parecida.TipoFallaNombre)</div>
                                            <div class="small">@(parecida.AccionesRealizadas ?? parecida.CausaFalla)</div>
                                        </li>
                                    }
                                </ul>
                            }
                            else
                            {
                                <div class="p-3 text-muted">Todavía no hay fallas cerradas de @(detencion.EquipoNombre ?? detencion.TipoFallaNombre ?? "este tipo") con solución cargada.</div>
                            }
                            <div class="p-3 border-top">
                                <a href="@UrlBaseSoluciones()">Buscar en base de soluciones</a>
                            </div>
                        </div>
                    </div>
                }

                <!-- Historial de estados -->
                <div class="card mb-4">
                    <div class="card-header">
                        <h6 class="mb-0">Historial de Estados</h6>
                    </div>
                    <div class="card-body p-0">
                        @if (detencion.HistorialEstados.Any())
                        {
                            <ul class="list-group list-group-flush">
                                @foreach (var hist in detencion.HistorialEstados.OrderByDescending(h => h.FechaHora))
                                {
                                    <li class="list-group-item">
                                        <div class="d-flex justify-content-between">
                                            <span class="@EstadoUi.BadgeClass(hist.EstadoNuevo, false)">@hist.EstadoNuevoDescripcion</span>
                                            <small class="text-muted">@hist.FechaHora.ToString("dd/MM HH:mm")</small>
                                        </div>
                                        @if (!string.IsNullOrEmpty(hist.Observacion))
                                        {
                                            <small class="text-muted d-block mt-1">@hist.Observacion</small>
                                        }
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            <div class="p-3 text-muted">Sin historial</div>
                        }
                    </div>
                </div>

                <!-- Notas -->
                <div class="card">
                    <div class="card-header">
                        <h6 class="mb-0">Notas</h6>
                    </div>
                    <div class="card-body p-0">
                        @if (detencion.Notas.Any())
                        {
                            <ul class="list-group list-group-flush">
                                @foreach (var nota in detencion.Notas.OrderByDescending(n => n.FechaHora))
                                {
                                    <li class="list-group-item">
                                        <small class="text-muted">@nota.FechaHora.ToString("dd/MM HH:mm")</small>
                                        <div>@nota.Texto</div>
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            <div class="p-3 text-muted">Sin notas</div>
                        }
                    </div>
                </div>
            </div>
        </div>

        @if (showCerrarModal)
        {
            <div class="modal show d-block" style="background-color: rgba(0,0,0,0.5);">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">Cerrar detención</h5>
                            <button type="button" class="btn-close" @onclick="() => showCerrarModal = false"></button>
                        </div>
                        <div class="modal-body">
                            @if (errorCerrar != null)
                            {
                                <div class="alert alert-danger py-2">@errorCerrar</div>
                            }
                            <div class="mb-3">
                                <label class="form-label">Acciones realizadas</label>
                                <textarea class="form-control" @bind="cerrarRequest.AccionesRealizadas" rows="3"></textarea>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Resolución *</label>
                                <textarea class="form-control" @bind="cerrarRequest.ResolucionDescripcion" @bind:event="oninput" rows="3"></textarea>
                                @if (string.IsNullOrWhiteSpace(cerrarRequest.ResolucionDescripcion))
                                {
                                    <div class="form-text">@FaltaResolucion</div>
                                }
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" @onclick="() => showCerrarModal = false">Cancelar</button>
                            <button type="button" class="btn btn-success" @onclick="CerrarDetencion"
                                    disabled="@(isCerrando || string.IsNullOrWhiteSpace(cerrarRequest.ResolucionDescripcion))">
                                @if (isCerrando)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                }
                                Cerrar detención
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>

@code {
    private const string FaltaResolucion = "Escribí la resolución para poder cerrar.";

    [Parameter]
    public long Id { get; set; }

    /// <summary>Pantalla desde la que se abrió el detalle (por ejemplo, /detenciones/pendientes).</summary>
    [SupplyParameterFromQuery(Name = "volver")]
    public string? Volver { get; set; }

    private DetencionDetalleDto? detencion;
    private AnalisisDetencionDto? analisis;
    private AnalisisDetencionDto? analisisSinRegla;
    private bool isLoading = true;
    private bool showCerrarModal = false;
    private bool isCerrando = false;
    private CerrarDetencionRequest cerrarRequest = new();

    private string solucionTexto = string.Empty;
    private string causaTexto = string.Empty;
    private string planTexto = string.Empty;
    private bool guardandoAnalisis = false;
    private string? mensajeAnalisis;
    private string tipoMensaje = "success";
    private bool faltaSolucion;
    private bool faltaCausa;
    private bool confirmandoCierre;
    private string? errorCerrar;

    private bool puedeCerrarDetencion;
    private bool puedeEditar;
    private bool esAdministrador;
    private ClaimsPrincipal? usuario;

    private bool AnalisisCerrado => detencion?.EstadoActual == "CERRADA";
    private bool FormularioVacio =>
        string.IsNullOrWhiteSpace(solucionTexto) && string.IsNullOrWhiteSpace(causaTexto) && string.IsNullOrWhiteSpace(planTexto);

    private record PasoEstado(string Titulo, string? Detalle, bool Hecho, bool Actual);

    protected override async Task OnInitializedAsync()
    {
        usuario = (await AuthStateProvider.GetAuthenticationStateAsync()).User;
        esAdministrador = usuario.IsInRole("ADMINISTRADOR");
        // Misma política que la API (CanCloseDetenciones).
        puedeCerrarDetencion = esAdministrador || usuario.IsInRole("MANTENIMIENTO");
        await CargarDetencion();
    }

    private async Task CargarDetencion()
    {
        isLoading = true;
        try
        {
            var tareaDetencion = DetencionesService.GetDetencionAsync(Id);
            var tareaAnalisis = CargarAnalisisAsync();
            await Task.WhenAll(tareaDetencion, tareaAnalisis);

            detencion = await tareaDetencion;
            if (detencion != null)
            {
                puedeEditar = await PuedeEditarAsync(detencion);
                cerrarRequest.RowVersion = detencion.RowVersion;
                analisis = detencion.RequiereAnalisis ? await tareaAnalisis : null;
                // Sin regla de análisis igual puede tener fotos o correcciones hechas desde la base de soluciones.
                analisisSinRegla = detencion.RequiereAnalisis ? null : await tareaAnalisis;
                CargarFormulario();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task<AnalisisDetencionDto?> CargarAnalisisAsync()
    {
        try
        {
            return await AnalisisService.GetAnalisisAsync(Id);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar el análisis: {ex.Message}");
            return null;
        }
    }

    private void CargarFormulario()
    {
        solucionTexto = analisis?.AccionesRealizadas ?? string.Empty;
        causaTexto = analisis?.CausaFalla ?? string.Empty;
        planTexto = analisis?.PlanAccion ?? string.Empty;
    }

    private async Task GuardarBorrador()
    {
        await GuardarAnalisis(cerrar: false);
    }

    private void CerrarAnalisis()
    {
        faltaSolucion = string.IsNullOrWhiteSpace(solucionTexto);
        faltaCausa = string.IsNullOrWhiteSpace(causaTexto);
        if (faltaSolucion || faltaCausa)
        {
            mensajeAnalisis = (faltaSolucion, faltaCausa) switch
            {
                (true, true) => "Para cerrar el análisis faltan la solución y la causa de la falla.",
                (true, false) => "Para cerrar el análisis falta la solución.",
                _ => "Para cerrar el análisis falta la causa de la falla."
            };
            tipoMensaje = "warning";
            return;
        }

        mensajeAnalisis = null;
        confirmandoCierre = true;
    }

    private async Task ConfirmarCierreAnalisis()
    {
        await GuardarAnalisis(cerrar: true);
        confirmandoCierre = false;
    }

    private void LimpiarFaltantes()
    {
        if (faltaSolucion && !string.IsNullOrWhiteSpace(solucionTexto)) faltaSolucion = false;
        if (faltaCausa && !string.IsNullOrWhiteSpace(causaTexto)) faltaCausa = false;
    }

    private async Task GuardarAnalisis(bool cerrar)
    {
        if (analisis == null)
        {
            return;
        }

        guardandoAnalisis = true;
        try
        {
            var request = new GuardarAnalisisRequest
            {
                AccionesRealizadas = solucionTexto,
                CausaFalla = causaTexto,
                PlanAccion = planTexto,
                RowVersion = analisis.RowVersion
            };

            var (success, error) = cerrar
                ? await AnalisisService.CerrarAnalisisAsync(Id, request)
                : await AnalisisService.GuardarBorradorAsync(Id, request);

            if (success)
            {
                await CargarDetencion();
                mensajeAnalisis = cerrar ? "Análisis cerrado." : "Borrador guardado.";
                tipoMensaje = "success";
            }
            else
            {
                mensajeAnalisis = error;
                tipoMensaje = "danger";
            }
        }
        finally
        {
            guardandoAnalisis = false;
        }
    }

    private void AbrirCerrarModal()
    {
        errorCerrar = null;
        showCerrarModal = true;
    }

    private async Task CerrarDetencion()
    {
        errorCerrar = null;
        if (string.IsNullOrWhiteSpace(cerrarRequest.ResolucionDescripcion))
        {
            errorCerrar = FaltaResolucion;
            return;
        }

        isCerrando = true;
        try
        {
            var (success, error) = await DetencionesService.CerrarDetencionAsync(Id, cerrarRequest);
            if (success)
            {
                showCerrarModal = false;
                await CargarDetencion();
            }
            else
            {
                errorCerrar = error;
            }
        }
        finally
        {
            isCerrando = false;
        }
    }

    /// <summary>Misma regla que el lápiz de la lista.</summary>
    private async Task<bool> PuedeEditarAsync(DetencionDto det)
    {
        if (usuario == null) return false;
        var lineas = RolesCarga.SoloOperario(usuario.IsInRole)
            ? (await CatalogosService.GetMisAsignacionesAsync()).Select(a => a.LineaId)
            : [];
        return RolesCarga.PuedeEditar(det, usuario.IsInRole, lineas);
    }

    private void EditarDetencion() => Navigation.NavigateTo($"/detenciones?editar={Id}");

    private void VolverAlListado()
    {
        // Sólo rutas internas de detenciones: el parámetro viene en la URL y no se confía en él.
        var destino = Volver is { } v && v.StartsWith("/detenciones", StringComparison.Ordinal) && !v.StartsWith("//")
            ? v
            : "/detenciones";
        Navigation.NavigateTo(destino);
    }

    /// <summary>
    /// Pasos del flujo: Registrada → Requiere análisis (solo si aplica) → En análisis → Cerrada.
    /// </summary>
    private List<PasoEstado> ObtenerPasos()
    {
        var estado = detencion!.EstadoActual;
        var pasos = new List<PasoEstado>
        {
            new("Registrada",
                detencion.RequiereAnalisis
                    ? detencion.Fecha.ToString("dd/MM/yyyy")
                    : $"{detencion.Fecha:dd/MM/yyyy} · {detencion.MotivoSinAnalisis ?? "No requiere análisis"}",
                Hecho: true,
                Actual: estado == "REGISTRADA" && !detencion.RequiereAnalisis)
        };

        if (!detencion.RequiereAnalisis)
        {
            pasos.Add(new("Cerrada",
                estado == "CERRADA" && detencion.FechaHoraCierre.HasValue
                    ? detencion.FechaHoraCierre.Value.ToString("dd/MM/yyyy")
                    : null,
                Hecho: estado == "CERRADA",
                Actual: estado == "CERRADA"));
            return pasos;
        }

        var regla = analisis?.MinutosMinimosRegla.HasValue == true
            ? $"Regla {analisis.TipoFallaNombre ?? ""} ≥ {analisis.MinutosMinimosRegla} min"
            : "Regla de análisis";
        pasos.Add(new("Requiere análisis", regla, Hecho: true, Actual: estado == "REGISTRADA"));

        pasos.Add(new("En análisis",
            analisis != null && estado != "CERRADA" ? $"Responsable: {analisis.ResponsableNombre ?? "sin asignar"}" : null,
            Hecho: estado == "EN_SEGUIMIENTO" || estado == "CERRADA",
            Actual: estado == "EN_SEGUIMIENTO"));

        pasos.Add(new("Cerrada",
            estado == "CERRADA" && analisis?.FechaHoraAnalisis != null
                ? $"{analisis.FechaHoraAnalisis.Value:dd/MM/yyyy} · {analisis.AnalisisPorUsuarioNombre}"
                : null,
            Hecho: estado == "CERRADA",
            Actual: estado == "CERRADA"));

        return pasos;
    }

    private string ResponsableTexto(AnalisisDetencionDto dato)
    {
        var responsable = dato.ResponsableNombre ?? "sin asignar";
        if (!dato.PuedeEditar)
        {
            return $"Lo completa {responsable}.";
        }

        return esAdministrador && !usuario.EsResponsable(dato.ResponsableUsuarioId, dato.ResponsableRol)
            ? $"Lo completa {responsable}. Como administrador también lo podés completar."
            : $"Te toca completarlo a vos ({responsable}).";
    }

    private string UrlBaseSoluciones()
    {
        if (detencion?.EquipoId.HasValue == true)
        {
            return $"detenciones/soluciones?equipoId={detencion.EquipoId}";
        }

        return detencion?.TipoFallaId.HasValue == true
            ? $"detenciones/soluciones?tipoFallaId={detencion.TipoFallaId}"
            : "detenciones/soluciones";
    }
}
