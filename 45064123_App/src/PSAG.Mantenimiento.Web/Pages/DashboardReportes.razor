    private async Task CargarDetalle(DetencionFiltroRequest filtro)
    {
        mostrarModal = true;
        cargandoDetalle = true;
        errorDetalle = null;
        StateHasChanged();

        try
        {
            detencionesDetalle = await DetencionesService.GetDetencionesConFiltrosAsync(filtro);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error cargando detalle: {ex.Message}");
