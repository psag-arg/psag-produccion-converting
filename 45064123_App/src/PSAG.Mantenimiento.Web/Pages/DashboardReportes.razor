</style>

@code {
    private List<LineaDto> lineas = new();
    private List<TurnoDto> turnos = new();
    private int filtroLineaId = 0;
    private int filtroAnio = DateTime.Today.Year;
    private int filtroTurnoId = 0;
    private int activeTab = 0;
    private bool isLoading = true;

    private IndisponibilidadReporteDto? indisponibilidad;
    private FallosMayoresReporteDto? fallosMayores;
    private ParetoDetencionesReporteDto? pareto;

    // Modal de detalle
    private bool mostrarModal = false;
    private bool cargandoDetalle = false;
    private string modalTitulo = "";
    private PagedResult<DetencionDto>? detencionesDetalle;

    // Colores para tipos de falla (basados en las imagenes del cliente)
    private static readonly Dictionary<string, string> ColoresTipoFalla = new()
    {
        { "FALLO PROCESO", "#F4B183" },
        { "FALLA PROCESO", "#F4B183" },
        { "PROCESO", "#F4B183" },
        { "FALLO EQUIPO", "#A5A5A5" },
        { "FALLA EQUIPO", "#A5A5A5" },
        { "EQUIPO", "#A5A5A5" },
        { "EMPALMES", "#FFE699" },
        { "CAMBIO DE FORMATO", "#9DC3E6" },
        { "CAMBIO DE FTO", "#9DC3E6" },
        { "OTROS", "#A9D18E" },
        { "SUMINISTROS", "#5B9BD5" },
        { "Sin clasificar", "#808080" }
    };

    private static readonly Dictionary<string, string> ColoresFalloMayor = new()
    {
        { "FALLO PROCESO", "#5B9BD5" },
        { "FALLA PROCESO", "#5B9BD5" },
        { "PROCESO", "#5B9BD5" },
        { "F. PROCESO", "#5B9BD5" },
        { "FALLO EQUIPO", "#FFD966" },
        { "FALLA EQUIPO", "#FFD966" },
        { "EQUIPO", "#FFD966" },
        { "F. EQUIPO", "#FFD966" }
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            lineas = await CatalogosService.GetLineasAsync();
            turnos = await CatalogosService.GetTurnosAsync();
        }
        catch { }

        await CargarReportes();
    }

    private async Task CargarReportes()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            var lineaId = filtroLineaId > 0 ? filtroLineaId : (int?)null;

            // Cargar los 3 reportes en paralelo
            var tareaIndisponibilidad = DashboardService.GetIndisponibilidadAsync(lineaId, filtroAnio);
            var tareaFallosMayores = DashboardService.GetFallosMayoresAsync(lineaId, filtroAnio);
            var tareaPareto = DashboardService.GetParetoAsync(
                lineaId,
                filtroTurnoId > 0 ? filtroTurnoId : (int?)null,
                new DateTime(filtroAnio, 1, 1),
                new DateTime(filtroAnio, 12, 31));

            await Task.WhenAll(tareaIndisponibilidad, tareaFallosMayores, tareaPareto);

            indisponibilidad = await tareaIndisponibilidad;
            fallosMayores = await tareaFallosMayores;
            pareto = await tareaPareto;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error cargando reportes: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task CargarPareto()
    {
        try
        {
            var lineaId = filtroLineaId > 0 ? filtroLineaId : (int?)null;
            pareto = await DashboardService.GetParetoAsync(
                lineaId,
                filtroTurnoId > 0 ? filtroTurnoId : (int?)null,
                new DateTime(filtroAnio, 1, 1),
                new DateTime(filtroAnio, 12, 31));
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error cargando pareto: {ex.Message}");
        }
    }

    private List<string> GetTiposFallaUnicos(IndisponibilidadReporteDto reporte)
    {
        return reporte.Meses
            .SelectMany(m => m.PorTipoFalla)
            .Select(t => t.TipoFallaNombre)
            .Distinct()
            .OrderBy(t => t)
            .ToList();
    }

    private List<string> GetTiposFallosMayoresUnicos(FallosMayoresReporteDto reporte)
    {
        return reporte.Meses
            .SelectMany(m => m.PorTipoFalla)
            .Select(t => t.TipoFallaNombre)
            .Distinct()
            .OrderBy(t => t)
            .ToList();
    }

    private string GetColorTipoFalla(string tipoFalla)
    {
        var upper = tipoFalla.ToUpper();
        foreach (var kvp in ColoresTipoFalla)
        {
            if (upper.Contains(kvp.Key.ToUpper()))
                return kvp.Value;
        }
        // Color por defecto basado en hash
        var hash = tipoFalla.GetHashCode();
        var colors = new[] { "#F4B183", "#A5A5A5", "#FFE699", "#9DC3E6", "#A9D18E", "#5B9BD5" };
        return colors[Math.Abs(hash) % colors.Length];
    }

    private string GetColorFalloMayor(string tipoFalla)
    {
        var upper = tipoFalla.ToUpper();
        foreach (var kvp in ColoresFalloMayor)
        {
            if (upper.Contains(kvp.Key.ToUpper()))
                return kvp.Value;
        }
        // Color por defecto
        return upper.Contains("PROCESO") ? "#5B9BD5" : "#FFD966";
    }

    // Metodos del modal de detalle
    private void CerrarModal()
    {
        mostrarModal = false;
        detencionesDetalle = null;
        modalTitulo = "";
    }

    private async Task MostrarDetallePorMesYTipo(int mes, int? tipoFallaId, string tipoFallaNombre, string mesNombre)
    {
        var lineaId = filtroLineaId > 0 ? filtroLineaId : (int?)null;
        var fechaDesde = new DateOnly(filtroAnio, mes, 1);
        var fechaHasta = fechaDesde.AddMonths(1).AddDays(-1);

        modalTitulo = $"{mesNombre} {filtroAnio} - {tipoFallaNombre}";
        if (lineaId.HasValue)
        {
            var linea = lineas.FirstOrDefault(l => l.LineaId == lineaId);
            modalTitulo += $" - {linea?.Nombre ?? "Linea"}";
        }

        await CargarDetalle(new DetencionFiltroRequest
        {
            LineaId = lineaId,
            TipoFallaId = tipoFallaId,
            FechaDesde = fechaDesde,
            FechaHasta = fechaHasta,
            PageSize = 100
        });
    }

    private async Task MostrarDetalleFallosMayores(int mes, int? tipoFallaId, string tipoFallaNombre, string mesNombre)
    {
        var lineaId = filtroLineaId > 0 ? filtroLineaId : (int?)null;
        var fechaDesde = new DateOnly(filtroAnio, mes, 1);
        var fechaHasta = fechaDesde.AddMonths(1).AddDays(-1);

        modalTitulo = $"Fallos Mayores (>=60 min) - {mesNombre} {filtroAnio} - {tipoFallaNombre}";
        if (lineaId.HasValue)
        {
            var linea = lineas.FirstOrDefault(l => l.LineaId == lineaId);
            modalTitulo += $" - {linea?.Nombre ?? "Linea"}";
        }

        // Nota: MinutosMinimo no esta implementado en el backend aun, pero mostramos el titulo
        await CargarDetalle(new DetencionFiltroRequest
        {
            LineaId = lineaId,
            TipoFallaId = tipoFallaId,
            FechaDesde = fechaDesde,
            FechaHasta = fechaHasta,
            PageSize = 100
        });
    }

    private async Task MostrarDetallePorTipoFalla(int? tipoFallaId, string tipoFallaNombre)
    {
        var lineaId = filtroLineaId > 0 ? filtroLineaId : (int?)null;
        var turnoId = filtroTurnoId > 0 ? filtroTurnoId : (int?)null;

        modalTitulo = $"Detenciones - {tipoFallaNombre}";
        if (lineaId.HasValue)
        {
            var linea = lineas.FirstOrDefault(l => l.LineaId == lineaId);
            modalTitulo += $" - {linea?.Nombre ?? "Linea"}";
        }

        await CargarDetalle(new DetencionFiltroRequest
        {
            LineaId = lineaId,
            TipoFallaId = tipoFallaId,
            TurnoId = turnoId,
            FechaDesde = new DateOnly(filtroAnio, 1, 1),
            FechaHasta = new DateOnly(filtroAnio, 12, 31),
            PageSize = 100
        });
    }

    private async Task MostrarDetallePorEquipo(int? equipoId, string equipoNombre)
    {
        var lineaId = filtroLineaId > 0 ? filtroLineaId : (int?)null;
        var turnoId = filtroTurnoId > 0 ? filtroTurnoId : (int?)null;

        modalTitulo = $"Detenciones - Equipo: {equipoNombre}";
        if (lineaId.HasValue)
        {
            var linea = lineas.FirstOrDefault(l => l.LineaId == lineaId);
            modalTitulo += $" - {linea?.Nombre ?? "Linea"}";
        }

        await CargarDetalle(new DetencionFiltroRequest
        {
            LineaId = lineaId,
            EquipoId = equipoId,
            TurnoId = turnoId,
            FechaDesde = new DateOnly(filtroAnio, 1, 1),
            FechaHasta = new DateOnly(filtroAnio, 12, 31),
            PageSize = 100
        });
    }

    private async Task MostrarDetallePorEquipoYDetalle(int? equipoId, string equipoNombre, int? detalleFallaId, string detalleFallaNombre)
    {
        var lineaId = filtroLineaId > 0 ? filtroLineaId : (int?)null;
        var turnoId = filtroTurnoId > 0 ? filtroTurnoId : (int?)null;

        modalTitulo = $"Detenciones - {equipoNombre} / {detalleFallaNombre}";
        if (lineaId.HasValue)
        {
            var linea = lineas.FirstOrDefault(l => l.LineaId == lineaId);
            modalTitulo += $" - {linea?.Nombre ?? "Linea"}";
        }

        await CargarDetalle(new DetencionFiltroRequest
        {
            LineaId = lineaId,
            EquipoId = equipoId,
            DetalleFallaId = detalleFallaId,
            TurnoId = turnoId,
            FechaDesde = new DateOnly(filtroAnio, 1, 1),
            FechaHasta = new DateOnly(filtroAnio, 12, 31),
            PageSize = 100
        });
    }

    private async Task CargarDetalle(DetencionFiltroRequest filtro)
    {
        mostrarModal = true;
        cargandoDetalle = true;
        StateHasChanged();

        try
        {
            detencionesDetalle = await DetencionesService.GetDetencionesConFiltrosAsync(filtro);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error cargando detalle: {ex.Message}");
            detencionesDetalle = new PagedResult<DetencionDto>();
        }
        finally
        {
            cargandoDetalle = false;
            StateHasChanged();
        }
    }
}
