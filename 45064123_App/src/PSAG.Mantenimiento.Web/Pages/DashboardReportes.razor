        }
        finally
        {
            cargandoDetalle = false;
            StateHasChanged();
        }
    }

    private bool EsMesEnCurso(int mes) => filtroAnio == DateTime.Today.Year && mes == DateTime.Today.Month;

    /// <summary>
    /// Tope del eje: 4 marcas parejas que cubren el máximo real (antes era fijo y recortaba barras).
    /// </summary>
    private static double TopeEscala(double maximo, double minimo)
    {
        foreach (var paso in new double[] { 1, 2, 3, 4, 5, 10, 15, 20, 25, 50, 100, 250, 500, 1000 })
        {
            if (paso * 4 >= Math.Max(maximo, minimo))
                return paso * 4;
        }
        return Math.Ceiling(maximo / 4) * 4;
    }

    private static IEnumerable<double> Marcas(double tope) => Enumerable.Range(0, 5).Select(i => tope * i / 4);

    /// <summary>
    /// Estado vacío que dice qué filtro lo dejó vacío y qué probar.
    /// </summary>
    private string TextoVacio(string que, bool incluirTurno)
    {
        var linea = lineas.FirstOrDefault(l => l.LineaId == filtroLineaId)?.Nombre ?? "ninguna línea";
        var periodo = activeTab == 2 ? TextoPeriodoPareto() : filtroAnio.ToString();
        var turno = incluirTurno && filtroTurnoId > 0
            ? $" · {turnos.FirstOrDefault(t => t.TurnoId == filtroTurnoId)?.Nombre}"
            : "";
        var sugerencia = activeTab == 2 ? "Probá con otra línea, otro año o Mes: Todos." : "Probá con otra línea u otro año.";
        return $"No hay {que} de {linea} en {periodo}{turno}. {sugerencia}";
    }

    // CSS necesita punto decimal: con la cultura es-AR "61,2px" es inválido y el navegador lo ignora.
    private static string Px(double valor) => valor.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) + "px";
}
