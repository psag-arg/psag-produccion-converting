@page "/dashboard/reportes"
@using Microsoft.AspNetCore.Authorization
@using PSAG.Mantenimiento.Web.Models
@using PSAG.Mantenimiento.Web.Services
@attribute [Authorize]
@inject IDashboardService DashboardService
@inject ICatalogosService CatalogosService
@inject IDetencionesService DetencionesService

<PageTitle>Reportes - PSAG Produccion</PageTitle>

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Reportes de Detenciones</h2>
        <div class="d-flex gap-2 align-items-center">
            <label class="form-label mb-0 me-2">Línea:</label>
            <select class="form-select form-select-sm" style="width: auto;" @bind="filtroLineaId" @bind:after="@(async () => await CargarReportes())">
                <option value="0">Todas las líneas</option>
                @foreach (var linea in lineas)
                {
                    <option value="@linea.LineaId">@linea.Nombre</option>
                }
            </select>
            <label class="form-label mb-0 ms-3 me-2">Año:</label>
            <select class="form-select form-select-sm" style="width: auto;" @bind="filtroAnio" @bind:after="@(async () => await CargarReportes())">
                @for (int i = DateTime.Today.Year; i >= DateTime.Today.Year - 3; i--)
                {
                    <option value="@i">@i</option>
                }
            </select>
            @if (activeTab == 2)
            {
                <label class="form-label mb-0 ms-3 me-2">Mes:</label>
                <select class="form-select form-select-sm" style="width: auto;" @bind="filtroMes" @bind:after="@(async () => await CargarPareto())">
                    <option value="0">Todos</option>
                    @for (int m = 1; m <= 12; m++)
                    {
                        <option value="@m">@NombresMeses[m]</option>
                    }
                </select>
            }
            <button class="btn btn-outline-primary btn-sm ms-2" @onclick="CargarReportes">
                <i class="bi bi-arrow-clockwise"></i> Actualizar
            </button>
        </div>
    </div>

    @if (errorLineas)
    {
        <div class="text-danger small text-end mb-2">No se pudo cargar la lista de líneas. Tocá Actualizar o recargá la página.</div>
    }

    @if (errorReportes != null)
    {
        <div class="alert alert-danger">@errorReportes</div>
    }

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
        </div>
    }
    else
    {
        <!-- Tabs -->
        <ul class="nav nav-tabs mb-3" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link @(activeTab == 0 ? "active" : "")" @onclick="() => activeTab = 0">
                    <i class="bi bi-bar-chart-fill me-1"></i> Indisponibilidad
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link @(activeTab == 1 ? "active" : "")" @onclick="() => activeTab = 1">
                    <i class="bi bi-exclamation-triangle me-1"></i> Fallos Mayores
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link @(activeTab == 2 ? "active" : "")" @onclick="() => activeTab = 2">
                    <i class="bi bi-list-ol me-1"></i> Pareto Detenciones
                </button>
            </li>
        </ul>

        <!-- Tab Content -->
        <div class="tab-content">
            @if (activeTab == 0)
            {
                @* REPORTE INDISPONIBILIDAD *@
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <h5 class="mb-0">
                            INDISPONIBILIDAD @(indisponibilidad?.LineaNombre ?? "Todas las líneas")
                        </h5>
                        @if (indisponibilidad != null && indisponibilidad.Meses.Any())
                        {
                            <span class="text-muted small">
                                Total minutos: @FormatoMinutos(indisponibilidad.Meses.Sum(m => m.MinutosTotalesParada)) ·
                                Total horas programadas: @FormatoHoras(indisponibilidad.Meses.Sum(m => m.HorasProgramadas)) h
                            </span>
                        }
                    </div>
                    <div class="card-body">
                        @if (indisponibilidad != null && indisponibilidad.Meses.Any())
                        {
                            <div class="alert alert-info py-2 small">
                                <strong>Indisponibilidad = minutos de detención ÷ tiempo programado.</strong>
                                El tiempo programado sale de los turnos de la planta más las excepciones del calendario.
                                El mes en curso se mide hasta hoy.
                            </div>

                            <!-- Leyenda -->
                            <div class="d-flex flex-wrap gap-3 mb-1">
                                @foreach (var tipo in UnicosPorTipo(indisponibilidad.Meses.Select(m => m.PorTipoFalla), t => t.TipoFallaId, t => t.TipoFallaNombre))
                                {
                                    <div class="d-flex align-items-center">
                                        <div style="width: 16px; height: 16px; background-color: @GetColorTipoFalla(tipo); margin-right: 6px;"></div>
                                        <small>@tipo.TipoFallaNombre</small>
                                    </div>
                                }
                            </div>
                            <div class="small text-muted mb-4">Los colores se cambian en Maestros → Tipos de falla.</div>

                            <!-- Grafico de barras apiladas: la escala va de 0 al máximo del año -->
                            var topeIndisp = TopeEscala(indisponibilidad.Meses.Select(m => m.IndisponibilidadTotal)
                                .Append(indisponibilidad.Promedio?.IndisponibilidadTotal ?? 0).Max(), 5);
                            <div class="chart-container" style="display: flex; align-items: flex-start; gap: 10px; position: relative;">
                                <!-- Eje Y: cada marca a la altura exacta de su valor -->
                                <div style="position: absolute; left: 10px; top: 0; height: @(AlturaGrafico)px; width: 45px;">
                                    @foreach (var marca in Marcas(topeIndisp))
                                    {
                                        <span class="small text-muted position-absolute end-0" style="bottom: @Px(marca / topeIndisp * AlturaGrafico); transform: translateY(50%);">@marca.ToString("0.#")%</span>
                                    }
                                </div>

                                @foreach (var mes in indisponibilidad.Meses)
                                {
                                    <div class="d-flex flex-column align-items-center" style="flex: 1; max-width: 80px;">
                                        <div class="d-flex align-items-end justify-content-center w-100 border-bottom" style="height: @(AlturaGrafico)px;">
                                            <!-- Barra apilada -->
                                            <div class="stacked-bar d-flex flex-column-reverse" style="width: 100%; max-width: 50px; height: @Px(mes.IndisponibilidadTotal / topeIndisp * AlturaGrafico);">
                                                @foreach (var tipo in mes.PorTipoFalla.OrderBy(t => t.TipoFallaNombre))
                                                {
                                                    <div class="clickable"
                                                         style="width: 100%; height: @Px(tipo.Porcentaje / topeIndisp * AlturaGrafico); background-color: @GetColorTipoFalla(tipo);"
                                                         title="@tipo.TipoFallaNombre: @tipo.Porcentaje% - Click para ver detalle"
                                                         @onclick="@(async () => await MostrarDetallePorMesYTipo(mes.Mes, tipo.TipoFallaId, tipo.TipoFallaNombre))"></div>
                                                }
                                            </div>
                                        </div>
                                        <!-- Label total -->
                                        <small class="fw-bold mt-1">@mes.IndisponibilidadTotal.ToString("0.0")%</small>
                                        <!-- Label mes -->
                                        <small class="text-muted">@mes.MesNombre</small>
                                    </div>
                                }

                                @if (indisponibilidad.Promedio != null && indisponibilidad.Promedio.PorTipoFalla.Any())
                                {
                                    <div class="d-flex flex-column align-items-center ms-4" style="flex: 1; max-width: 80px;">
                                        <div class="d-flex align-items-end justify-content-center w-100 border-bottom" style="height: @(AlturaGrafico)px;">
                                            <div class="stacked-bar d-flex flex-column-reverse" style="width: 100%; max-width: 50px; height: @Px(indisponibilidad.Promedio.IndisponibilidadTotal / topeIndisp * AlturaGrafico);">
                                                @foreach (var tipo in indisponibilidad.Promedio.PorTipoFalla.OrderBy(t => t.TipoFallaNombre))
                                                {
                                                    <div style="width: 100%; height: @Px(tipo.Porcentaje / topeIndisp * AlturaGrafico); background-color: @GetColorTipoFalla(tipo);"
                                                         title="@tipo.TipoFallaNombre: @tipo.Porcentaje%"></div>
                                                }
                                            </div>
                                        </div>
                                        <small class="fw-bold mt-1">@indisponibilidad.Promedio.IndisponibilidadTotal.ToString("0.0")%</small>
                                        <small class="text-muted">@indisponibilidad.Promedio.MesNombre</small>
                                    </div>
                                }
                            </div>

                            <!-- Tabla de datos -->
                            <div class="table-responsive mt-4">
                                <table class="table table-sm table-bordered">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Tipo de falla</th>
                                            @foreach (var mes in indisponibilidad.Meses)
                                            {
                                                <th class="text-center">
                                                    @mes.MesNombre
                                                    @if (EsMesEnCurso(mes.Mes))
                                                    {
                                                        <div class="small fw-normal text-muted" title="Mes en curso: cuenta el tiempo programado hasta hoy.">hasta hoy</div>
                                                    }
                                                </th>
                                            }
                                            <th class="text-center">PROM</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var tipo in UnicosPorTipo(indisponibilidad.Meses.Select(m => m.PorTipoFalla), t => t.TipoFallaId, t => t.TipoFallaNombre))
                                        {
                                            <tr>
                                                <td>@tipo.TipoFallaNombre</td>
                                                @foreach (var mes in indisponibilidad.Meses)
                                                {
                                                    var item = mes.PorTipoFalla.FirstOrDefault(t => t.TipoFallaId == tipo.TipoFallaId);
                                                    <td class="text-center clickable"
                                                        title="Click para ver detalle"
                                                        @onclick="@(async () => await MostrarDetallePorMesYTipo(mes.Mes, tipo.TipoFallaId, tipo.TipoFallaNombre))">
                                                        @((item?.Porcentaje ?? 0).ToString("0.0"))%
                                                    </td>
                                                }
                                                @{
                                                    var promItem = indisponibilidad.Promedio?.PorTipoFalla.FirstOrDefault(t => t.TipoFallaId == tipo.TipoFallaId);
                                                }
                                                <td class="text-center fw-bold">@((promItem?.Porcentaje ?? 0).ToString("0.0"))%</td>
                                            </tr>
                                        }
                                        <tr>
                                            <td>Minutos de detención</td>
                                            @foreach (var mes in indisponibilidad.Meses)
                                            {
                                                <td class="text-center">@FormatoMinutos(mes.MinutosTotalesParada)</td>
                                            }
                                            <td class="text-center fw-bold">@FormatoMinutos(indisponibilidad.Promedio?.MinutosTotalesParada ?? 0)</td>
                                        </tr>
                                        <tr>
                                            <td>Tiempo programado (h)</td>
                                            @foreach (var mes in indisponibilidad.Meses)
                                            {
                                                <td class="text-center">
                                                    <button type="button" class="btn btn-link btn-sm p-0 align-baseline"
                                                            title="Ver el tiempo programado día por día"
                                                            @onclick="@(async () => await MostrarTiempoProgramado(mes))">@FormatoHoras(mes.HorasProgramadas) h</button>
                                                </td>
                                            }
                                            <td class="text-center fw-bold">@FormatoHoras(indisponibilidad.Promedio?.HorasProgramadas ?? 0) h</td>
                                        </tr>
                                        <tr class="table-secondary fw-bold">
                                            <td>Indisponibilidad</td>
                                            @foreach (var mes in indisponibilidad.Meses)
                                            {
                                                <td class="text-center">@mes.IndisponibilidadTotal.ToString("0.0")%</td>
                                            }
                                            <td class="text-center">@(indisponibilidad.Promedio?.IndisponibilidadTotal.ToString("0.0") ?? "0.0")%</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        }
                        else if (errorReportes == null)
                        {
                            <p class="text-muted text-center py-4">@TextoVacio("detenciones", incluirTurno: false)</p>
                        }
                    </div>
                </div>
            }

            @if (activeTab == 1)
            {
                @* REPORTE FALLOS MAYORES *@
                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0">
                            FALLOS MAYORES (≥ @(fallosMayores?.UmbralMinutos ?? 60) min) @(fallosMayores?.LineaNombre ?? "Todas las líneas")
                        </h5>
                    </div>
                    <div class="card-body">
                        @if (fallosMayores != null && fallosMayores.Meses.Any())
                        {
                            <div class="alert alert-info py-2 small">
                                <strong>Indicador = minutos de las detenciones de @fallosMayores.UmbralMinutos min o más ÷ tiempo programado.</strong>
                                Las barras cuentan cuántas hubo en el mes.
                            </div>

                            <!-- Leyenda -->
                            <div class="d-flex flex-wrap gap-3 mb-1">
                                @foreach (var tipo in UnicosPorTipo(fallosMayores.Meses.Select(m => m.PorTipoFalla), t => t.TipoFallaId, t => t.TipoFallaNombre))
                                {
                                    <div class="d-flex align-items-center">
                                        <div style="width: 16px; height: 16px; background-color: @GetColorFalloMayor(tipo); margin-right: 6px;"></div>
                                        <small>Eventos @tipo.TipoFallaNombre</small>
                                    </div>
                                }
                            </div>
                            <div class="small text-muted mb-4">Los colores se cambian en Maestros → Tipos de falla.</div>

                            <!-- Grafico de eventos: la escala va de 0 al máximo del año -->
                            var topeEventos = TopeEscala(fallosMayores.Meses.Select(m => m.TotalEventos)
                                .Append(fallosMayores.Promedio?.TotalEventos ?? 0).Max(), 5);
                            <div class="chart-container" style="display: flex; align-items: flex-start; gap: 10px; position: relative;">
                                <div style="position: absolute; left: 10px; top: 0; height: @(AlturaGrafico)px; width: 45px;">
                                    @foreach (var marca in Marcas(topeEventos))
                                    {
                                        <span class="small text-muted position-absolute end-0" style="bottom: @Px(marca / topeEventos * AlturaGrafico); transform: translateY(50%);">@marca.ToString("0.#")</span>
                                    }
                                </div>

                                @foreach (var mes in fallosMayores.Meses)
                                {
                                    <div class="d-flex flex-column align-items-center" style="flex: 1; max-width: 80px;">
                                        <div class="d-flex align-items-end justify-content-center w-100 border-bottom" style="height: @(AlturaGrafico)px;">
                                            <div class="stacked-bar d-flex flex-column-reverse" style="width: 100%; max-width: 50px; height: @Px(mes.TotalEventos / topeEventos * AlturaGrafico);">
                                                @foreach (var tipo in mes.PorTipoFalla.OrderBy(t => t.TipoFallaNombre))
                                                {
                                                    <div class="clickable"
                                                         style="width: 100%; height: @Px(tipo.CantidadEventos / topeEventos * AlturaGrafico); background-color: @GetColorFalloMayor(tipo); display: flex; align-items: center; justify-content: center;"
                                                         title="@tipo.TipoFallaNombre: @tipo.CantidadEventos eventos - Click para ver detalle"
                                                         @onclick="@(async () => await MostrarDetalleFallosMayores(mes.Mes, tipo.TipoFallaId, tipo.TipoFallaNombre))">
                                                        @if (tipo.CantidadEventos > 0)
                                                        {
                                                            <small class="text-white fw-bold">@tipo.CantidadEventos.ToString("0.#")</small>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                        <small class="fw-bold mt-1">@mes.IndicadorPorcentaje.ToString("0.0")%</small>
                                        <small class="text-muted">@mes.MesNombre</small>
                                    </div>
                                }

                                @if (fallosMayores.Promedio != null && fallosMayores.Promedio.TotalEventos > 0)
                                {
                                    <div class="d-flex flex-column align-items-center ms-4" style="flex: 1; max-width: 80px;">
                                        <div class="d-flex align-items-end justify-content-center w-100 border-bottom" style="height: @(AlturaGrafico)px;">
                                            <div class="stacked-bar d-flex flex-column-reverse" style="width: 100%; max-width: 50px; height: @Px(fallosMayores.Promedio.TotalEventos / topeEventos * AlturaGrafico);">
                                                @foreach (var tipo in fallosMayores.Promedio.PorTipoFalla.OrderBy(t => t.TipoFallaNombre))
                                                {
                                                    <div style="width: 100%; height: @Px(tipo.CantidadEventos / topeEventos * AlturaGrafico); background-color: @GetColorFalloMayor(tipo); display: flex; align-items: center; justify-content: center;"
                                                         title="@tipo.TipoFallaNombre: @tipo.CantidadEventos.ToString("0.#") eventos por mes">
                                                        @if (tipo.CantidadEventos >= 1)
                                                        {
                                                            <small class="text-white fw-bold">@tipo.CantidadEventos.ToString("0.#")</small>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                        <small class="fw-bold mt-1">@fallosMayores.Promedio.IndicadorPorcentaje.ToString("0.0")%</small>
                                        <small class="text-muted">@fallosMayores.Promedio.MesNombre</small>
                                    </div>
                                }
                            </div>

                            <!-- Tabla de datos -->
                            <div class="table-responsive mt-4">
                                <table class="table table-sm table-bordered">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Tipo</th>
                                            @foreach (var mes in fallosMayores.Meses)
                                            {
                                                <th class="text-center">@mes.MesNombre</th>
                                            }
                                            <th class="text-center">PROM</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var tipo in UnicosPorTipo(fallosMayores.Meses.Select(m => m.PorTipoFalla), t => t.TipoFallaId, t => t.TipoFallaNombre))
                                        {
                                            <tr>
                                                <td>@tipo.TipoFallaNombre</td>
                                                @foreach (var mes in fallosMayores.Meses)
                                                {
                                                    var item = mes.PorTipoFalla.FirstOrDefault(t => t.TipoFallaId == tipo.TipoFallaId);
                                                    <td class="text-center">@((item?.CantidadEventos ?? 0).ToString("0.#"))</td>
                                                }
                                                @{
                                                    var promItem = fallosMayores.Promedio?.PorTipoFalla.FirstOrDefault(t => t.TipoFallaId == tipo.TipoFallaId);
                                                }
                                                <td class="text-center fw-bold">@((promItem?.CantidadEventos ?? 0).ToString("0.#"))</td>
                                            </tr>
                                        }
                                        <tr class="table-secondary">
                                            <td class="fw-bold">Total eventos</td>
                                            @foreach (var mes in fallosMayores.Meses)
                                            {
                                                <td class="text-center fw-bold">@mes.TotalEventos</td>
                                            }
                                            <td class="text-center fw-bold">@((fallosMayores.Promedio?.TotalEventos ?? 0).ToString("0.#"))</td>
                                        </tr>
                                        <tr class="table-warning">
                                            <td class="fw-bold">Indicador %</td>
                                            @foreach (var mes in fallosMayores.Meses)
                                            {
                                                <td class="text-center fw-bold">@mes.IndicadorPorcentaje.ToString("0.0")%</td>
                                            }
                                            <td class="text-center fw-bold">@(fallosMayores.Promedio?.IndicadorPorcentaje.ToString("0.0") ?? "0.0")%</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <p class="text-muted text-center py-4">@(errorReportes == null ? TextoVacio("fallos mayores", incluirTurno: false) : "")</p>
                        }
                    </div>
                </div>
            }

            @if (activeTab == 2)
            {
                @* REPORTE PARETO *@
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">
                            Pareto de detenciones · @TextoPeriodoPareto() · @(pareto?.LineaNombre ?? "Todas las líneas")
                        </h5>
                        <div class="d-flex gap-2 align-items-center">
                            <label class="form-label mb-0 me-1 small">Turno:</label>
                            <select class="form-select form-select-sm" style="width: auto;" @bind="filtroTurnoId" @bind:after="@(async () => await CargarPareto())">
                                <option value="0">Todos los turnos</option>
                                @foreach (var turno in turnos)
                                {
                                    <option value="@turno.TurnoId">@turno.Nombre</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="card-body">
                        @if (pareto != null && pareto.ResumenPorTipoFalla.Any())
                        {
                            <div class="row">
                                <!-- Resumen por Tipo de Falla -->
                                <div class="col-md-4">
                                    <h6 class="text-muted mb-3">Resumen por tipo de falla</h6>
                                    <table class="table table-sm table-bordered">
                                        <thead class="table-dark">
                                            <tr>
                                                <th>Tipo de falla</th>
                                                <th class="text-end">Minutos</th>
                                                <th class="text-end">% Acumulado</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var tipo in pareto.ResumenPorTipoFalla)
                                            {
                                                <tr class="clickable"
                                                    title="Click para ver detalle"
                                                    @onclick="@(async () => await MostrarDetallePorTipoFalla(tipo.TipoFallaId, tipo.TipoFallaNombre))">
                                                    <td>@tipo.TipoFallaNombre</td>
                                                    <td class="text-end">@tipo.MinutosTotales.ToString("N0")</td>
                                                    <td class="text-end">@tipo.PorcentajeAcumulado.ToString("0")%</td>
                                                </tr>
                                            }
                                            <tr class="table-secondary fw-bold">
                                                <td>Total general</td>
                                                <td class="text-end">@pareto.TotalMinutos.ToString("N0")</td>
                                                <td class="text-end">100%</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>

                                <!-- Detalle por Equipo -->
                                <div class="col-md-8">
                                    <h6 class="text-muted mb-3">Detalle por equipo y falla</h6>
                                    <div class="table-responsive" style="max-height: 500px; overflow-y: auto;">
                                        <table class="table table-sm table-bordered">
                                            <thead class="table-light sticky-top">
                                                <tr>
                                                    <th>Equipo</th>
                                                    <th>Detalle</th>
                                                    <th class="text-end">Minutos</th>
                                                    <th class="text-end">% Total</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var equipo in pareto.DetallePorEquipo)
                                                {
                                                    @foreach (var (detalle, index) in equipo.Detalles.Select((d, i) => (d, i)))
                                                    {
                                                        @* Sin equipo o sin detalle no hay filtro que los aísle: abrirlos traería todo *@
                                                        var detalleFiltrable = equipo.EquipoId.HasValue && detalle.DetalleFallaId.HasValue;
                                                        <tr class="@(detalleFiltrable ? "clickable" : "") @(detalle.PorcentajeDelTotal >= 5 ? "table-warning" : "")"
                                                            title="@(detalleFiltrable ? "Click para ver detalle" : SinFiltroTexto)"
                                                            @onclick="@(async () => { if (detalleFiltrable) await MostrarDetallePorEquipoYDetalle(equipo.EquipoId, equipo.EquipoNombre, detalle.DetalleFallaId, detalle.DetalleFallaNombre ?? ""); })">
                                                            @if (index == 0)
                                                            {
                                                                <td rowspan="@equipo.Detalles.Count" class="fw-bold align-middle @(equipo.EquipoId.HasValue ? "clickable" : "")"
                                                                    title="@(equipo.EquipoId.HasValue ? "Click para ver las detenciones del equipo" : SinFiltroTexto)"
                                                                    @onclick="@(async () => { if (equipo.EquipoId.HasValue) await MostrarDetallePorEquipo(equipo.EquipoId, equipo.EquipoNombre); })"
                                                                    @onclick:stopPropagation="true">
                                                                    @equipo.EquipoNombre
                                                                </td>
                                                            }
                                                            <td>@(string.IsNullOrEmpty(detalle.DetalleFallaNombre) ? "(Sin detalle)" : detalle.DetalleFallaNombre)</td>
                                                            <td class="text-end">@detalle.MinutosTotales</td>
                                                            <td class="text-end">@detalle.PorcentajeDelTotal.ToString("0")%</td>
                                                        </tr>
                                                    }
                                                }
                                                <tr class="table-secondary fw-bold">
                                                    <td colspan="2">Total general</td>
                                                    <td class="text-end">@pareto.TotalMinutos.ToString("N0")</td>
                                                    <td class="text-end">100%</td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        }
                        else if (errorReportes == null)
                        {
                            <p class="text-muted text-center py-4">@TextoVacio("detenciones", incluirTurno: true)</p>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

@* Modal de Detalle de Detenciones *@
@if (mostrarModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-xl modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-list-ul me-2"></i>
                        Detalle de Detenciones
                    </h5>
                    <button type="button" class="btn-close" @onclick="CerrarModal"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(modalTitulo))
                    {
                        <div class="alert alert-info py-2">
                            <strong>Filtro:</strong> @modalTitulo
                        </div>
                    }

                    @if (cargandoDetalle)
                    {
                        <div class="text-center py-4">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Cargando...</span>
                            </div>
                        </div>
                    }
                    else if (detencionesDetalle != null && detencionesDetalle.Items.Any())
                    {
                        <div class="mb-2 text-muted small">
                            @if (detencionesDetalle.TotalCount > detencionesDetalle.Items.Count)
                            {
                                <span>
                                    Mostrando las primeras @detencionesDetalle.Items.Count de @detencionesDetalle.TotalCount detenciones ·
                                    minutos de estas @detencionesDetalle.Items.Count: <strong>@detencionesDetalle.Items.Sum(d => d.MinutosEfectivos).ToString("N0")</strong>.
                                    Para ver todas, usá Detenciones con el mismo filtro.
                                </span>
                            }
                            else
                            {
                                <span>@detencionesDetalle.TotalCount detenciones · Total minutos: <strong>@detencionesDetalle.Items.Sum(d => d.MinutosEfectivos).ToString("N0")</strong></span>
                            }
                        </div>
                        <div class="table-responsive" style="max-height: 500px;">
                            <table class="table table-sm table-striped table-hover">
                                <thead class="table-dark sticky-top">
                                    <tr>
                                        <th>Código</th>
                                        <th>Fecha</th>
                                        <th>Equipo</th>
                                        <th>Tipo de falla</th>
                                        <th>Detalle</th>
                                        <th class="text-end">Min.</th>
                                        <th>Turno</th>
                                        <th>Descripción</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var det in detencionesDetalle.Items)
                                    {
                                        <tr>
                                            <td class="text-nowrap"><small>@det.Codigo</small></td>
                                            <td class="text-nowrap">@det.Fecha.ToString("dd/MM")</td>
                                            <td>@(det.EquipoNombre ?? "-")</td>
                                            <td>@(det.TipoFallaNombre ?? "-")</td>
                                            <td>@(det.DetalleFallaNombre ?? "-")</td>
                                            <td class="text-end fw-bold">@det.MinutosEfectivos</td>
                                            <td><small>@det.TurnoNombre</small></td>
                                            <td><small class="text-muted">@(det.Descripcion?.Length > 50 ? det.Descripcion.Substring(0, 50) + "..." : det.Descripcion)</small></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted text-center py-4">@(errorDetalle ?? "No se encontraron detenciones con los filtros seleccionados.")</p>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CerrarModal">Cerrar</button>
                </div>
            </div>
        </div>
    </div>
}

@if (mostrarModalProgramado && mesProgramado != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@programadoTitulo</h5>
                    <button type="button" class="btn-close" @onclick="CerrarModalProgramado"></button>
                </div>
                <div class="modal-body">
                    @if (cargandoProgramado)
                    {
                        <div class="text-center py-4">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Cargando...</span>
                            </div>
                        </div>
                    }
                    else
                    {
                        var minutosTotales = diasProgramados.Sum(d => d.Minutos);
                        <div class="row text-center mb-3">
                            <div class="col">
                                <div class="text-muted small">Minutos de detención</div>
                                <strong>@FormatoMinutos(mesProgramado.MinutosTotalesParada)</strong>
                            </div>
                            <div class="col">
                                <div class="text-muted small">Tiempo programado</div>
                                <strong>@FormatoHoras(mesProgramado.HorasProgramadas) h (@FormatoMinutos(mesProgramado.MinutosProgramados) min)</strong>
                            </div>
                            <div class="col">
                                <div class="text-muted small">Indisponibilidad</div>
                                <strong>@mesProgramado.IndisponibilidadTotal.ToString("0.0")%</strong>
                            </div>
                        </div>
                        <div class="table-responsive" style="max-height: 500px;">
                            <table class="table table-sm table-striped">
                                <thead class="table-light sticky-top">
                                    <tr>
                                        <th>Día</th>
                                        @if (filtroLineaId == 0)
                                        {
                                            <th>Línea</th>
                                        }
                                        <th class="text-end">Horas</th>
                                        <th>Origen</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var dia in diasProgramados)
                                    {
                                        <tr>
                                            <td class="text-nowrap">@dia.Fecha.ToString("ddd dd/MM")</td>
                                            @if (filtroLineaId == 0)
                                            {
                                                <td>@dia.LineaNombre</td>
                                            }
                                            <td class="text-end">@FormatoHoras(dia.Horas)</td>
                                            <td>@TextoOrigen(dia)</td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot class="table-secondary fw-bold">
                                    <tr>
                                        <td colspan="@(filtroLineaId == 0 ? 2 : 1)">Total</td>
                                        <td class="text-end">@FormatoHoras(minutosTotales / 60.0) h</td>
                                        <td></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                        <p class="small text-muted mt-2 mb-0">
                            Estándar = suma de los turnos activos. Si ese día no se trabajó o se trabajó menos,
                            cargá una excepción en Configuración → Turnos.
                        </p>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CerrarModalProgramado">Cerrar</button>
                </div>
            </div>
        </div>
    </div>
}

