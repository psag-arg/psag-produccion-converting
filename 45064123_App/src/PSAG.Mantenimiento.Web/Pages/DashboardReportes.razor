@code {
    private List<LineaDto> lineas = new();
    private List<TurnoDto> turnos = new();
    private int filtroLineaId = 0;
    private int filtroAnio = DateTime.Today.Year;
    private int filtroTurnoId = 0;
    private int filtroMes = 0;
    private int activeTab = 0;
    private bool isLoading = true;
    private string? errorReportes;
    private bool errorLineas;
    private string? errorDetalle;

    private const int AlturaGrafico = 240;
    private const string ErrorReportes = "No se pudieron cargar los reportes. Revisá la conexión y tocá Actualizar; si sigue, avisá a sistemas.";
    private const string SinFiltroTexto = "Detenciones cargadas sin equipo o sin detalle: abrilas desde Detenciones filtrando por línea y fecha.";

    private IndisponibilidadReporteDto? indisponibilidad;
    private FallosMayoresReporteDto? fallosMayores;
    private ParetoDetencionesReporteDto? pareto;

    // Modal de detalle
    private bool mostrarModal = false;
    private bool cargandoDetalle = false;
    private string modalTitulo = "";
    private PagedResult<DetencionDto>? detencionesDetalle;

    private bool mostrarModalProgramado = false;
    private bool cargandoProgramado = false;
    private string programadoTitulo = "";
    private IndisponibilidadMensualDto? mesProgramado;
    private List<TiempoProgramadoDiaDto> diasProgramados = new();

    private static readonly string[] NombresMeses =
    {
        "", "Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio",
        "Julio", "Agosto", "Septiembre", "Octubre", "Noviembre", "Diciembre"
    };

    // Colores de respaldo para tipos de falla sin color en el maestro (fijo por TipoFallaId)
    private static readonly string[] PaletaTipoFalla =
    {
        "#ED7D31", "#70AD47", "#7030A0", "#C00000", "#4BACC6", "#FF66CC", "#8FAADC", "#BF9000"
    };

    // Colores para tipos de falla (basados en las imagenes del cliente)
    private static readonly Dictionary<string, string> ColoresTipoFalla = new()
    {
        { "FALLO PROCESO", "#F4B183" },
        { "FALLA PROCESO", "#F4B183" },
        { "PROCESO", "#F4B183" },
        { "FALLO EQUIPO", "#A5A5A5" },
        { "FALLA EQUIPO", "#A5A5A5" },
        { "EQUIPO", "#A5A5A5" },
        { "EMPALMES", "#FFE699" },
        { "CAMBIO DE FORMATO", "#9DC3E6" },
        { "CAMBIO DE FTO", "#9DC3E6" },
        { "OTROS", "#A9D18E" },
        { "SUMINISTROS", "#5B9BD5" },
        { "Sin clasificar", "#808080" }
    };

    private static readonly Dictionary<string, string> ColoresFalloMayor = new()
    {
        { "FALLO PROCESO", "#5B9BD5" },
        { "FALLA PROCESO", "#5B9BD5" },
        { "PROCESO", "#5B9BD5" },
        { "F. PROCESO", "#5B9BD5" },
        { "FALLO EQUIPO", "#FFD966" },
        { "FALLA EQUIPO", "#FFD966" },
        { "EQUIPO", "#FFD966" },
        { "F. EQUIPO", "#FFD966" }
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            lineas = await CatalogosService.GetLineasAsync();
            turnos = await CatalogosService.GetTurnosAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error cargando líneas y turnos: {ex.Message}");
            errorLineas = true;
        }

        await CargarReportes();
    }

    private async Task CargarReportes()
    {
        isLoading = true;
        errorReportes = null;
        StateHasChanged();

        try
        {
            var lineaId = filtroLineaId > 0 ? filtroLineaId : (int?)null;

            // Cargar los 3 reportes en paralelo
            var tareaIndisponibilidad = DashboardService.GetIndisponibilidadAsync(lineaId, filtroAnio);
            var tareaFallosMayores = DashboardService.GetFallosMayoresAsync(lineaId, filtroAnio);
            var (desde, hasta) = PeriodoPareto();
            var tareaPareto = DashboardService.GetParetoAsync(
                lineaId,
                filtroTurnoId > 0 ? filtroTurnoId : (int?)null,
                desde.ToDateTime(TimeOnly.MinValue),
                hasta.ToDateTime(TimeOnly.MinValue));

            await Task.WhenAll(tareaIndisponibilidad, tareaFallosMayores, tareaPareto);

            indisponibilidad = await tareaIndisponibilidad;
            fallosMayores = await tareaFallosMayores;
            pareto = await tareaPareto;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error cargando reportes: {ex.Message}");
            // Sin datos a la vista: si no, un error parece "no hay detenciones".
            indisponibilidad = null;
            fallosMayores = null;
            pareto = null;
            errorReportes = ErrorReportes;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task CargarPareto()
    {
        errorReportes = null;
        try
        {
            var lineaId = filtroLineaId > 0 ? filtroLineaId : (int?)null;
            var (desde, hasta) = PeriodoPareto();
            pareto = await DashboardService.GetParetoAsync(
                lineaId,
                filtroTurnoId > 0 ? filtroTurnoId : (int?)null,
                desde.ToDateTime(TimeOnly.MinValue),
                hasta.ToDateTime(TimeOnly.MinValue));
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error cargando pareto: {ex.Message}");
            pareto = null;
            errorReportes = ErrorReportes;
        }
    }

    private (DateOnly Desde, DateOnly Hasta) PeriodoPareto() =>
        filtroMes > 0 ? RangoMes(filtroMes) : (new DateOnly(filtroAnio, 1, 1), new DateOnly(filtroAnio, 12, 31));

    private (DateOnly Desde, DateOnly Hasta) RangoMes(int mes)
    {
        var desde = new DateOnly(filtroAnio, mes, 1);
        return (desde, desde.AddMonths(1).AddDays(-1));
    }

    private string TextoPeriodoPareto() =>
        filtroMes > 0 ? $"{NombresMeses[filtroMes]} {filtroAnio}" : $"{filtroAnio}";

    private static string FormatoHoras(double horas) => horas.ToString("#,##0.#");

    private static string FormatoMinutos(int minutos) => minutos.ToString("N0");

    // Un tipo de falla por renglón, aunque aparezca en varios meses
    private static List<T> UnicosPorTipo<T>(IEnumerable<IEnumerable<T>> porMes, Func<T, int> tipoFallaId, Func<T, string> tipoFallaNombre) =>
        porMes.SelectMany(tipos => tipos)
            .GroupBy(tipoFallaId)
            .Select(g => g.First())
            .OrderBy(tipoFallaNombre)
            .ToList();

    private string GetColorTipoFalla(IndisponibilidadTipoFallaItem tipo) =>
        ResolverColor(tipo.Color, tipo.TipoFallaId, tipo.TipoFallaNombre, ColoresTipoFalla);

    private string GetColorFalloMayor(FalloMayorTipoItem tipo) =>
        ResolverColor(tipo.Color, tipo.TipoFallaId, tipo.TipoFallaNombre, ColoresFalloMayor);

    // Color del maestro Tipos de Falla; si no tiene, el mapa por nombre; si tampoco, un color fijo por TipoFallaId.
    private static string ResolverColor(string? colorMaestro, int tipoFallaId, string nombre, IReadOnlyDictionary<string, string> respaldo)
    {
        if (!string.IsNullOrWhiteSpace(colorMaestro))
            return colorMaestro;

        var upper = nombre.ToUpper();
        foreach (var kvp in respaldo)
        {
            if (upper.Contains(kvp.Key.ToUpper()))
                return kvp.Value;
        }

        return PaletaTipoFalla[Math.Abs(tipoFallaId) % PaletaTipoFalla.Length];
    }

    private async Task MostrarTiempoProgramado(IndisponibilidadMensualDto mes)
    {
        var lineaId = filtroLineaId > 0 ? filtroLineaId : (int?)null;
        var linea = lineas.FirstOrDefault(l => l.LineaId == lineaId);

        mesProgramado = mes;
        programadoTitulo = $"Tiempo programado · {NombresMeses[mes.Mes]} {filtroAnio} · {linea?.Nombre ?? "Todas las lineas"}";
        mostrarModalProgramado = true;
        cargandoProgramado = true;
        StateHasChanged();

        try
        {
            diasProgramados = await DashboardService.GetTiempoProgramadoAsync(lineaId, filtroAnio, mes.Mes) ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error cargando tiempo programado: {ex.Message}");
            diasProgramados = new();
        }
        finally
        {
            cargandoProgramado = false;
        }
    }

    private void CerrarModalProgramado()
    {
        mostrarModalProgramado = false;
        mesProgramado = null;
        diasProgramados = new();
    }

    private static string TextoOrigen(TiempoProgramadoDiaDto dia) => dia.Origen switch
    {
        "EXCEPCION" => string.IsNullOrWhiteSpace(dia.Motivo) ? "Excepción" : $"Excepción · {dia.Motivo}",
        "HISTORICO" => "Histórico (HS PROG)",
        _ => "Estándar"
    };

    // Metodos del modal de detalle
    private void CerrarModal()
    {
        mostrarModal = false;
        detencionesDetalle = null;
        modalTitulo = "";
    }

    private async Task MostrarDetallePorMesYTipo(int mes, int? tipoFallaId, string tipoFallaNombre)
    {
        var lineaId = filtroLineaId > 0 ? filtroLineaId : (int?)null;
        var (fechaDesde, fechaHasta) = RangoMes(mes);

        modalTitulo = $"{NombresMeses[mes]} {filtroAnio} - {tipoFallaNombre}";
        if (lineaId.HasValue)
        {
            var linea = lineas.FirstOrDefault(l => l.LineaId == lineaId);
            modalTitulo += $" - {linea?.Nombre ?? "Linea"}";
        }

        await CargarDetalle(new DetencionFiltroRequest
        {
            LineaId = lineaId,
            TipoFallaId = tipoFallaId,
            FechaDesde = fechaDesde,
            FechaHasta = fechaHasta,
            PageSize = 100
        });
    }

    private async Task MostrarDetalleFallosMayores(int mes, int? tipoFallaId, string tipoFallaNombre)
    {
        var lineaId = filtroLineaId > 0 ? filtroLineaId : (int?)null;
        var (fechaDesde, fechaHasta) = RangoMes(mes);
