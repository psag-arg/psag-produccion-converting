@page "/detenciones/pendientes"
@using System.Globalization
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using PSAG.Mantenimiento.Web.Models
@using PSAG.Mantenimiento.Web.Services
@attribute [Authorize]
@inject IAnalisisService AnalisisService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Mis pendientes - PSAG Produccion</PageTitle>

<div class="container-fluid">
    <div class="mb-4">
        <h2>Mis pendientes</h2>
        <div class="text-muted">@subtitulo</div>
    </div>

    @if (cargando)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
        </div>
    }
    else if (pendientes == null)
    {
        <div class="alert alert-warning">No se pudieron cargar los pendientes.</div>
    }
    else
    {
        <!-- Indicadores -->
        <div class="row g-3 mb-4">
            @if (pendientes.VeAnalisis)
            {
                <div class="col-6 col-lg-3">
                    <div class="card h-100"><div class="card-body">
                        <div class="text-muted small">Para analizar</div>
                        <div class="fs-3 fw-semibold">@pendientes.ParaAnalizar.Count</div>
                    </div></div>
                </div>
                <div class="col-6 col-lg-3">
                    <div class="card h-100"><div class="card-body">
                        <div class="text-muted small">En análisis</div>
                        <div class="fs-3 fw-semibold">@pendientes.EnAnalisis.Count</div>
                    </div></div>
                </div>
                <div class="col-6 col-lg-3">
                    <div class="card h-100"><div class="card-body">
                        <div class="text-muted small">Demora promedio</div>
                        <div class="fs-3 fw-semibold">
                            @TextoDemora()
                        </div>
                    </div></div>
                </div>
                <div class="col-6 col-lg-3">
                    <div class="card h-100"><div class="card-body">
                        <div class="text-muted small">Cerradas este mes</div>
                        <div class="fs-3 fw-semibold">@pendientes.CerradasEsteMes</div>
                    </div></div>
                </div>
            }
            @if (pendientes.VeDeclaracion)
            {
                <div class="col-6 col-lg-3">
                    <div class="card h-100"><div class="card-body">
                        <div class="text-muted small">Para declarar</div>
                        <div class="fs-3 fw-semibold">@pendientes.ParaDeclarar.Count</div>
                    </div></div>
                </div>
            }
        </div>

        <!-- Pestañas -->
        <ul class="nav nav-tabs mb-3">
            @if (pendientes.VeAnalisis)
            {
                <li class="nav-item">
                    <button class="nav-link @(pestania == "analizar" ? "active" : "")" @onclick='() => CambiarPestania("analizar")'>
                        Para analizar <span class="badge bg-secondary ms-1">@pendientes.ParaAnalizar.Count</span>
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link @(pestania == "en-analisis" ? "active" : "")" @onclick='() => CambiarPestania("en-analisis")'>
                        En análisis <span class="badge bg-secondary ms-1">@pendientes.EnAnalisis.Count</span>
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link @(pestania == "cerradas" ? "active" : "")" @onclick='() => CambiarPestania("cerradas")'>
                        Cerradas por mí
                    </button>
                </li>
            }
            @if (pendientes.VeDeclaracion)
            {
                <li class="nav-item">
                    <button class="nav-link @(pestania == "declarar" ? "active" : "")" @onclick='() => CambiarPestania("declarar")'>
                        Para declarar <span class="badge bg-secondary ms-1">@pendientes.ParaDeclarar.Count</span>
                    </button>
                </li>
            }
        </ul>

        @if (pestania == "declarar")
        {
            <div class="card">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Código</th>
                                <th>Línea</th>
                                <th>Intervalo</th>
                                <th>Minutos</th>
                                <th>Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in pendientes.ParaDeclarar)
                            {
                                <tr>
                                    <td><strong>@item.Codigo</strong></td>
                                    <td>@item.LineaNombre</td>
                                    <td>@TextoIntervalo(item)</td>
                                    <td><span class="badge bg-secondary">@item.MinutosEfectivos min</span></td>
                                    <td><span class="badge bg-warning text-dark">@item.EstadoActualDescripcion</span></td>
                                </tr>
                            }
                            @if (!pendientes.ParaDeclarar.Any())
                            {
                                <tr>
                                    <td colspan="5" class="text-center text-muted py-4">No hay detenciones para declarar.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="alert alert-light border mt-3 mb-0">
                Hasta que esté la lectura del PLC esta lista queda vacía: el operario carga la detención a mano como hoy.
                Cuando llegue la señal, la detención se crea sola con hora y minutos, y el operario completa equipo,
                tipo de falla y descripción.
            </div>
        }
        else
        {
            @if (pestania != "cerradas" && pendientes.EsAdministrador)
            {
                <div class="row mb-3">
                    <div class="col-md-4">
                        <label class="form-label">Responsable</label>
                        <select class="form-select" @onchange="CambiarResponsable">
                            <option value="" selected="@string.IsNullOrEmpty(filtroResponsable)">Todos los responsables</option>
                            @foreach (var opcion in pendientes.Responsables)
                            {
                                var valor = ValorOpcion(opcion);
                                <option value="@valor" selected="@(filtroResponsable == valor)">@opcion.Nombre</option>
                            }
                        </select>
                    </div>
                </div>
            }

            <div class="card">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Código</th>
                                <th>Fecha</th>
                                <th>Equipo</th>
                                <th>Tipo falla</th>
                                <th>Minutos</th>
                                <th>Estado</th>
                                @if (pestania != "cerradas")
                                {
                                    <th>Esperando</th>
                                }
                                @if (pestania != "cerradas" && pendientes.EsAdministrador)
                                {
                                    <th>Responsable</th>
                                }
                                @if (pestania == "cerradas")
                                {
                                    <th>Cerrada el</th>
                                }
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in ListaActual())
                            {
                                <tr>
                                    <td><strong>@item.Codigo</strong></td>
                                    <td>@item.Fecha.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        @(item.EquipoNombre ?? "-")
                                        @if (item.EquipoCritico)
                                        {
                                            <span class="badge bg-danger ms-1">Crítico</span>
                                        }
                                    </td>
                                    <td>@(item.TipoFallaNombre ?? "-")</td>
                                    <td><span class="badge bg-secondary">@item.MinutosEfectivos min</span></td>
                                    <td><span class="badge @ClaseEstado(item)">@EstadoAnalisis(item)</span></td>
                                    @if (pestania != "cerradas")
                                    {
                                        <td>
                                            @if (item.DiasEsperando.HasValue)
                                            {
                                                <span class="@(item.DiasEsperando > 3 ? "text-danger fw-semibold" : "")">@TextoEspera(item.DiasEsperando.Value)</span>
                                            }
                                        </td>
                                    }
                                    @if (pestania != "cerradas" && pendientes.EsAdministrador)
                                    {
                                        <td>@ResponsableDe(item)</td>
                                    }
                                    @if (pestania == "cerradas")
                                    {
                                        <td>@(item.FechaHoraAnalisis?.ToString("dd/MM/yyyy HH:mm") ?? "-")</td>
                                    }
                                    <td class="text-end">
                                        <button class="btn btn-sm @(pestania == "cerradas" ? "btn-outline-primary" : "btn-primary")"
                                                @onclick="() => AbrirDetencion(item.DetencionId)">
                                            @(pestania == "cerradas" ? "Ver" : "Analizar")
                                        </button>
                                    </td>
                                </tr>
                            }
                            @if (!ListaActual().Any())
                            {
                                <tr>
                                    <td colspan="10" class="text-center text-muted py-4">@TextoVacio()</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }
</div>

@code {
    private MisPendientesDto? pendientes;
    private bool cargando = true;
    private string pestania = "analizar";
    private string filtroResponsable = string.Empty;
    private string subtitulo = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var roles = authState.User.Claims
            .Where(c => c.Type == "role" || c.Type == ClaimTypes.Role)
            .Select(c => c.Value)
            .Distinct()
            .OrderBy(r => r)
            .Select(Capitalizar);
        subtitulo = $"Rol: {string.Join(", ", roles)} · ves solo lo que te toca a vos";

        await CargarPendientes();
        pestania = pendientes?.VeAnalisis == true ? "analizar" : "declarar";
    }

    private async Task CargarPendientes()
    {
        cargando = true;
        try
        {
            var responsableRol = filtroResponsable.StartsWith("R:") ? filtroResponsable[2..] : null;
            var responsableUsuarioId = filtroResponsable.StartsWith("U:") ? filtroResponsable[2..] : null;
            pendientes = await AnalisisService.GetMisPendientesAsync(responsableRol, responsableUsuarioId);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar pendientes: {ex.Message}");
            pendientes = null;
        }
        finally
        {
            cargando = false;
        }
    }

    private void CambiarPestania(string nueva)
    {
        pestania = nueva;
    }

    private async Task CambiarResponsable(ChangeEventArgs e)
    {
        filtroResponsable = e.Value?.ToString() ?? string.Empty;
        await CargarPendientes();
    }

    private string TextoDemora() =>
        pendientes?.DemoraPromedioDias is double dias
            ? $"{dias.ToString("0.0", CultureInfo.GetCultureInfo("es-AR"))} días"
            : "—";

    private List<PendienteAnalisisDto> ListaActual() => pestania switch
    {
        "en-analisis" => pendientes?.EnAnalisis ?? new List<PendienteAnalisisDto>(),
        "cerradas" => pendientes?.CerradasPorMi ?? new List<PendienteAnalisisDto>(),
        _ => pendientes?.ParaAnalizar ?? new List<PendienteAnalisisDto>()
    };

    private string TextoVacio() => pestania switch
    {
        "cerradas" => "Todavía no cerraste ningún análisis.",
        "en-analisis" => "No hay análisis en curso para vos.",
        _ => "No hay fallas esperando análisis para vos."
    };

    private void AbrirDetencion(long detencionId)
    {
        Navigation.NavigateTo($"detenciones/{detencionId}");
    }

    private static string ValorOpcion(ResponsableOpcionDto opcion) =>
        opcion.Rol != null ? $"R:{opcion.Rol}" : $"U:{opcion.UsuarioId}";

    private static string ResponsableDe(PendienteAnalisisDto item)
    {
        if (!string.IsNullOrEmpty(item.ResponsableUsuarioId))
        {
            return item.ResponsableUsuarioNombre ?? "Usuario asignado";
        }

        return item.ResponsableRol == null ? "-" : $"Rol {Capitalizar(item.ResponsableRol)}";
    }

    private static string EstadoAnalisis(PendienteAnalisisDto item) => item.EstadoActual switch
    {
        "REGISTRADA" => "Requiere análisis",
        "EN_SEGUIMIENTO" => "En análisis",
        _ => item.EstadoActualDescripcion
    };

    private static string ClaseEstado(PendienteAnalisisDto item) => item.EstadoActual switch
    {
        "REGISTRADA" => "bg-primary",
        "EN_SEGUIMIENTO" => "bg-warning text-dark",
        _ => "bg-success"
    };

    private static string TextoEspera(int dias) => dias switch
    {
        <= 0 => "hoy",
        1 => "hace 1 día",
        _ => $"hace {dias} días"
    };

    private static string TextoIntervalo(PendienteDeclaracionDto item)
    {
        if (!item.FechaHoraParada.HasValue)
        {
            return "Sin hora";
        }

        var inicio = item.FechaHoraParada.Value.ToString("dd/MM HH:mm");
        return item.FechaHoraArranque.HasValue
            ? $"{inicio} → {item.FechaHoraArranque.Value:HH:mm}"
            : inicio;
    }

    private static string Capitalizar(string texto) =>
        texto.Length == 0 ? texto : char.ToUpperInvariant(texto[0]) + texto[1..].ToLowerInvariant();
}
