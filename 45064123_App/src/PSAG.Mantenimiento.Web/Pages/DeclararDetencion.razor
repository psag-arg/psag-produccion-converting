@page "/detenciones/{DetencionId:long}/declarar"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject NavigationManager Navigation

<PageTitle>Declarar detención - PSAG Produccion</PageTitle>

@* T-610: el operador completa la detención que creó la cámara. T-770: el formulario es el componente
   Shared/FormularioDeclaracion (el tablero del operador lo abre en un modal). *@

<div class="container-fluid">
    <div class="mb-3">
        <a href="@Volver" class="text-decoration-none"><i class="bi bi-arrow-left me-1"></i>Volver</a>
    </div>
    <PSAG.Mantenimiento.Web.Shared.FormularioDeclaracion DetencionId="DetencionId" TextoListo="Volver a mis pendientes"
                                                        AlCerrar="@(() => Navigation.NavigateTo(Volver))" />
</div>

@code {
    [Parameter] public long DetencionId { get; set; }

    [SupplyParameterFromQuery(Name = "volver")]
    public string? VolverA { get; set; }

    private string Volver => string.IsNullOrWhiteSpace(VolverA) || !VolverA.StartsWith('/') ? "detenciones/pendientes" : VolverA.TrimStart('/');
}
