@page "/control-proceso/nuevo"
@using Microsoft.AspNetCore.Authorization
@using PSAG.Mantenimiento.Web.Models
@using PSAG.Mantenimiento.Web.Services
@attribute [Authorize]
@inject IRegistroProcesoService RegistroProcesoService
@inject ICatalogosService CatalogosService
@inject NavigationManager Navigation

<PageTitle>Nuevo control de proceso - PSAG Produccion</PageTitle>

<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card">
                <div class="card-header">
                    <h4 class="mb-0">Nuevo control de proceso</h4>
                </div>
                <div class="card-body">
                    <p class="text-muted mb-4">
                        Elegí la línea (y el producto, si corresponde) para cargar los puntos de control del turno actual.
                        Si ya hay un control empezado para esa combinación en este turno, se retoma.
                    </p>

                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger">@errorMessage</div>
                    }

                    @if (!string.IsNullOrEmpty(infoMessage))
                    {
                        <div class="alert alert-info">@infoMessage</div>
                    }

                    <div class="mb-4">
                        <label class="form-label fw-bold">Línea *</label>
                        <select class="form-select form-select-lg" @bind="selectedLineaId" @bind:after="OnLineaChanged">
                            <option value="0">-- Elegí una línea --</option>
                            @foreach (var linea in lineas)
                            {
                                <option value="@linea.LineaId">@linea.Nombre</option>
                            }
                        </select>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold">Producto</label>
                        <select class="form-select form-select-lg" @bind="selectedProductoId" @bind:after="@(async () => await CargarGrupos())" disabled="@(selectedLineaId == 0)">
                            <option value="0">-- Sin producto / no aplica --</option>
                            @foreach (var producto in productos)
                            {
                                <option value="@producto.ProductoId">@producto.Nombre</option>
                            }
                        </select>
                        <small class="text-muted">Opcional: si el producto tiene estándares propios, se controla contra esos.</small>
                    </div>

                    @if (selectedLineaId > 0)
                    {
                        <div class="mb-4">
                            <h6>Puntos de control a cargar:</h6>
                            @if (isLoadingGrupos)
                            {
                                <div class="spinner-border spinner-border-sm text-primary"></div>
                            }
                            else if (grupos.Any())
                            {
                                <ul class="list-group">
                                    @foreach (var grupo in grupos)
                                    {
                                        <li class="list-group-item d-flex justify-content-between align-items-center">
                                            @grupo.Nombre
                                            <span class="badge bg-primary rounded-pill">@grupo.Parametros.Count puntos</span>
                                        </li>
                                    }
                                </ul>
                            }
                            else
                            {
                                <div class="alert alert-warning mb-0">
                                    Esta línea todavía no tiene puntos de control de proceso cargados.
                                    Los carga un administrador desde Maestros &gt; Puntos de control de proceso.
                                </div>
                            }
                        </div>
                    }

                    <hr />

                    <div class="d-flex justify-content-between">
                        <button type="button" class="btn btn-outline-secondary" @onclick="Cancelar">
                            Cancelar
                        </button>
                        <button type="button" class="btn btn-primary btn-lg"
                                @onclick="IniciarRegistro"
                                disabled="@(isSubmitting || selectedLineaId == 0 || !grupos.Any())">
                            @if (isSubmitting)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                                <span>Iniciando...</span>
                            }
                            else
                            {
                                <i class="bi bi-play-fill me-2"></i>
                                <span>Empezar control</span>
                            }
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private List<LineaDto> lineas = new();
    private List<ProductoDto> productos = new();
    private List<GrupoParametroDto> grupos = new();
    private int selectedLineaId;
    private int selectedProductoId;
    private string? errorMessage;
    private string? infoMessage;
    private bool isSubmitting;
    private bool isLoadingGrupos;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            lineas = await CatalogosService.GetLineasAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al cargar líneas: {ex.Message}";
        }
    }

    private async Task OnLineaChanged()
    {
        selectedProductoId = 0;
        productos.Clear();
        grupos.Clear();

        if (selectedLineaId > 0)
        {
            try
            {
                productos = await CatalogosService.GetProductosAsync(selectedLineaId);
            }
            catch (Exception ex)
            {
                errorMessage = $"Error al cargar productos: {ex.Message}";
            }

            await CargarGrupos();
        }
    }

    private async Task OnProductoChanged()
    {
        await CargarGrupos();
    }

    private async Task CargarGrupos()
    {
        if (selectedLineaId == 0)
        {
            grupos.Clear();
            return;
        }

        isLoadingGrupos = true;
        errorMessage = null;

        try
        {
            grupos = await RegistroProcesoService.GetGruposConEstandaresAsync(selectedLineaId, selectedProductoId > 0 ? selectedProductoId : null);
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al cargar grupos: {ex.Message}";
            grupos.Clear();
        }
        finally
        {
            isLoadingGrupos = false;
        }
    }

    private async Task IniciarRegistro()
    {
        if (selectedLineaId == 0)
        {
            errorMessage = "Elegí una línea.";
            return;
        }

        isSubmitting = true;
        errorMessage = null;

        try
        {
            var request = new IniciarRegistroProcesoRequest
            {
                LineaId = selectedLineaId,
                ProductoId = selectedProductoId > 0 ? selectedProductoId : null
            };

            var (result, error) = await RegistroProcesoService.IniciarRegistroAsync(request);

            if (result != null)
            {
                if (!result.EsNuevo)
                {
                    infoMessage = $"Retomando el control del turno {result.TurnoNombre}...";
                }

                // Navegar a la pagina de carga
                Navigation.NavigateTo($"/control-proceso/{result.RegistroProcesoId}");
            }
            else
            {
                errorMessage = error ?? "No se pudo empezar el control. Verificá que haya un turno configurado para la hora actual.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void Cancelar()
    {
        Navigation.NavigateTo("/control-proceso");
    }
}
