@page "/registros-proceso/nuevo"
@using Microsoft.AspNetCore.Authorization
@using PSAG.Mantenimiento.Web.Models
@using PSAG.Mantenimiento.Web.Services
@attribute [Authorize]
@inject IRegistroProcesoService RegistroProcesoService
@inject ICatalogosService CatalogosService
@inject NavigationManager Navigation

<PageTitle>Iniciar Registro de Proceso - PSAG Produccion</PageTitle>

<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card">
                <div class="card-header">
                    <h4 class="mb-0">Iniciar Registro de Variables de Proceso</h4>
                </div>
                <div class="card-body">
                    <p class="text-muted mb-4">
                        Seleccione la linea y el producto para iniciar o retomar el registro del turno actual.
                        Si ya existe un registro para esta combinacion en el turno actual, se retomara automaticamente.
                    </p>

                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger">@errorMessage</div>
                    }

                    @if (!string.IsNullOrEmpty(infoMessage))
                    {
                        <div class="alert alert-info">@infoMessage</div>
                    }

                    <div class="mb-4">
                        <label class="form-label fw-bold">Linea *</label>
                        <select class="form-select form-select-lg" @bind="selectedLineaId" @bind:after="OnLineaChanged">
                            <option value="0">-- Seleccione una linea --</option>
                            @foreach (var linea in lineas)
                            {
                                <option value="@linea.LineaId">@linea.Nombre</option>
                            }
                        </select>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold">Producto *</label>
                        <select class="form-select form-select-lg" @bind="selectedProductoId" @bind:after="CargarGrupos" disabled="@(selectedLineaId == 0)">
                            <option value="0">-- Seleccione un producto --</option>
                            @foreach (var producto in productos)
                            {
                                <option value="@producto.ProductoId">@producto.Nombre</option>
                            }
                        </select>
                        @if (selectedLineaId > 0 && !productos.Any())
                        {
                            <small class="text-warning">No hay productos configurados para esta linea.</small>
                        }
                    </div>

                    @if (selectedLineaId > 0 && selectedProductoId > 0)
                    {
                        <div class="mb-4">
                            <h6>Grupos de parametros a registrar:</h6>
                            @if (isLoadingGrupos)
                            {
                                <div class="spinner-border spinner-border-sm text-primary"></div>
                            }
                            else if (grupos.Any())
                            {
                                <ul class="list-group">
                                    @foreach (var grupo in grupos)
                                    {
                                        <li class="list-group-item d-flex justify-content-between align-items-center">
                                            @grupo.Nombre
                                            <span class="badge bg-primary rounded-pill">@grupo.Parametros.Count parametros</span>
                                        </li>
                                    }
                                </ul>
                            }
                            else
                            {
                                <div class="alert alert-warning mb-0">
                                    No hay parametros configurados para esta combinacion linea/producto.
                                </div>
                            }
                        </div>
                    }

                    <hr />

                    <div class="d-flex justify-content-between">
                        <button type="button" class="btn btn-outline-secondary" @onclick="Cancelar">
                            Cancelar
                        </button>
                        <button type="button" class="btn btn-primary btn-lg"
                                @onclick="IniciarRegistro"
                                disabled="@(isSubmitting || selectedLineaId == 0 || selectedProductoId == 0 || !grupos.Any())">
                            @if (isSubmitting)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                                <span>Iniciando...</span>
                            }
                            else
                            {
                                <i class="bi bi-play-fill me-2"></i>
                                <span>Iniciar Registro</span>
                            }
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private List<LineaDto> lineas = new();
    private List<ProductoDto> productos = new();
    private List<GrupoParametroDto> grupos = new();
    private int selectedLineaId;
    private int selectedProductoId;
    private string? errorMessage;
    private string? infoMessage;
    private bool isSubmitting;
    private bool isLoadingGrupos;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            lineas = await CatalogosService.GetLineasAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al cargar lineas: {ex.Message}";
        }
    }

    private async Task OnLineaChanged()
    {
        selectedProductoId = 0;
        productos.Clear();
        grupos.Clear();

        if (selectedLineaId > 0)
        {
            try
            {
                productos = await CatalogosService.GetProductosAsync(selectedLineaId);
            }
            catch (Exception ex)
            {
                errorMessage = $"Error al cargar productos: {ex.Message}";
            }
        }
    }

    private async Task OnProductoChanged()
    {
        await CargarGrupos();
    }

    private async Task CargarGrupos()
    {
        if (selectedLineaId == 0 || selectedProductoId == 0)
        {
            grupos.Clear();
            return;
        }

        isLoadingGrupos = true;
        errorMessage = null;

        try
        {
            grupos = await RegistroProcesoService.GetGruposConEstandaresAsync(selectedLineaId, selectedProductoId);
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al cargar grupos: {ex.Message}";
            grupos.Clear();
        }
        finally
        {
            isLoadingGrupos = false;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        // Recargar grupos cuando cambia el producto
        await CargarGrupos();
    }

    private async Task IniciarRegistro()
    {
        if (selectedLineaId == 0)
        {
            errorMessage = "Debe seleccionar una linea";
            return;
        }

        if (selectedProductoId == 0)
        {
            errorMessage = "Debe seleccionar un producto";
            return;
        }

        isSubmitting = true;
        errorMessage = null;

        try
        {
            var request = new IniciarRegistroProcesoRequest
            {
                LineaId = selectedLineaId,
                ProductoId = selectedProductoId
            };

            var result = await RegistroProcesoService.IniciarRegistroAsync(request);

            if (result != null)
            {
                if (!result.EsNuevo)
                {
                    infoMessage = $"Retomando registro existente del turno {result.TurnoNombre}...";
                }

                // Navegar a la pagina de captura
                Navigation.NavigateTo($"/registros-proceso/{result.RegistroProcesoId}");
            }
            else
            {
                errorMessage = "Error al iniciar el registro. Verifique que haya un turno configurado para la hora actual.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void Cancelar()
    {
        Navigation.NavigateTo("/registros-proceso");
    }
}
