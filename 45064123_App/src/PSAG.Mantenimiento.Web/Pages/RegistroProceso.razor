@page "/control-proceso/{Id:long}"
@using System.Globalization
@using Microsoft.AspNetCore.Authorization
@using PSAG.Mantenimiento.Web.Models
@using PSAG.Mantenimiento.Web.Services
@attribute [Authorize]
@implements IAsyncDisposable
@inject IRegistroProcesoService RegistroProcesoService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Control de Proceso - PSAG Produccion</PageTitle>

<div class="container-fluid control-proceso">
    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
        </div>
    }
    else if (registro == null)
    {
        <div class="alert alert-danger">
            @(errorMessage ?? "Control de proceso no encontrado.")
            <button class="btn btn-link" @onclick="Volver">Volver al listado</button>
        </div>
    }
    else
    {
        <!-- Encabezado -->
        <div class="d-flex justify-content-between align-items-start mb-2 flex-wrap gap-2">
            <div>
                <h2 class="mb-1">Control de Proceso</h2>
                <p class="text-muted mb-0">
                    @registro.LineaNombre · @registro.ProductoNombre ·
                    @registro.Fecha.ToString("dd/MM/yyyy") · @registro.TurnoNombre
                </p>
            </div>
            <div class="d-flex align-items-center gap-2">
                <span class="badge @GetEstadoBadgeClass(registro.Estado) fs-6">@registro.EstadoDescripcion</span>
                <button class="btn btn-outline-secondary" @onclick="@(async () => await Volver())">
                    <i class="bi bi-arrow-left"></i> Volver
                </button>
            </div>
        </div>

        <!-- Avance: queda fijo arriba mientras se recorre la máquina -->
        <div class="avance-control card mb-3" id="avance">
            <div class="card-body py-2">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-1 small">
                    <span><strong>@Completados / @Total</strong> puntos</span>
                    <span class="@(Desvios > 0 ? "text-warning-emphasis fw-semibold" : "text-muted")">@Desvios @(Desvios == 1 ? "desvío" : "desvíos")</span>
                    @if (SinEstandarCargados > 0)
                    {
                        <span class="text-danger fw-semibold" title="Puntos cargados sin rango contra el que comparar">@SinEstandarCargados sin estándar</span>
                    }
                    <span class="estado-guardado @ClaseGuardado" role="status">@TextoGuardado</span>
                </div>
                <div class="progress mt-1" style="height: 8px;" role="progressbar" aria-valuenow="@Porcentaje" aria-valuemin="0" aria-valuemax="100" aria-label="Avance del control">
                    <div class="progress-bar @(Porcentaje == 100 ? "bg-success" : "bg-info")" style="width: @Porcentaje%"></div>
                </div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger alert-dismissible">
                @errorMessage
                <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
            </div>
        }

        @if (!string.IsNullOrEmpty(successMessage))
        {
            <div class="alert alert-success alert-dismissible">
                @successMessage
                <button type="button" class="btn-close" @onclick="() => successMessage = null"></button>
            </div>
        }

        @if (registro.Grupos.Any())
        {
            <!-- Solapas de grupos (en el celular se deslizan de costado) -->
            <ul class="nav nav-tabs mb-3 solapas-scroll" role="tablist">
                @foreach (var grupo in GruposOrdenados)
                {
                    var grupoCompletados = grupo.Detalles.Count(ControlProcesoUi.TieneValor);
                    var grupoTotal = grupo.Detalles.Count;
                    var grupoDesvios = grupo.Detalles.Count(d => Evaluacion(d) == ControlProcesoUi.FueraDeRango);

                    <li class="nav-item">
                        <button class="nav-link text-nowrap @(selectedGrupoId == grupo.GrupoParametroId ? "active" : "")"
                                role="tab" aria-selected="@(selectedGrupoId == grupo.GrupoParametroId ? "true" : "false")"
                                @onclick="@(async () => await IrAGrupo(grupo.GrupoParametroId, subir: false))">
                            @grupo.Nombre
                            <span class="badge @(grupoCompletados == grupoTotal ? "bg-success" : "bg-secondary") ms-1">
                                @grupoCompletados/@grupoTotal
                            </span>
                            @if (grupoDesvios > 0)
                            {
                                <span class="badge bg-warning text-dark ms-1">@grupoDesvios</span>
                            }
                        </button>
                    </li>
                }
            </ul>

            @if (GetGrupoActual() is { } grupoActual)
            {
                var indice = GruposOrdenados.FindIndex(g => g.GrupoParametroId == grupoActual.GrupoParametroId);
                var siguiente = indice + 1 < GruposOrdenados.Count ? GruposOrdenados[indice + 1] : null;

                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-1">
                        <h5 class="mb-0">@grupoActual.Nombre</h5>
                        <small class="text-muted">Grupo @(indice + 1) de @GruposOrdenados.Count</small>
                    </div>
                    <div class="card-body pt-0">
                        <div class="punto-encabezado row g-2 d-none d-md-flex text-muted small fw-semibold border-bottom py-2">
                            <div class="col-md-3">Punto de control</div>
                            <div class="col-md-2">Estándar</div>
                            <div class="col-md-3">Valor</div>
                            <div class="col-md-2">Estado</div>
                            <div class="col-md-2">Observación</div>
                        </div>

                        @* Secciones en el orden de la planilla (el Orden de sus puntos), no alfabético. *@
                        @foreach (var seccion in grupoActual.Detalles.GroupBy(d => d.Seccion ?? "General")
                                     .OrderBy(s => s.Min(d => d.Orden)).ThenBy(s => s.Key))
                        {
                            <h6 class="text-primary mt-3 mb-1 pb-1 border-bottom">@seccion.Key</h6>

                            @foreach (var detalle in seccion.OrderBy(d => d.Orden).ThenBy(d => d.ParametroNombre))
                            {
                                var localDetalle = detalle;
                                var isReadOnly = registro.Estado == "CERRADO" || detalle.FueraDePlantilla;
                                var evaluacion = Evaluacion(detalle);
                                var verObservacion = !string.IsNullOrEmpty(detalle.Observacion) || evaluacion == ControlProcesoUi.FueraDeRango
                                                     || observacionesAbiertas.Contains(detalle.ParametroId);

                                <div class="punto row g-2 align-items-center border-bottom py-2 @ClaseFila(evaluacion)" data-codigo="@detalle.ParametroCodigo">
                                    <div class="col-12 col-md-3">
                                        <strong>@detalle.ParametroNombre</strong>
                                        <span class="d-md-none ms-1">@EstandarBadge(detalle)</span>
                                        <div class="small text-muted">@detalle.ParametroCodigo · @detalle.FrecuenciaDescripcion</div>
                                        @if (detalle.FueraDePlantilla)
                                        {
                                            <span class="badge bg-secondary">Ya no está en la plantilla</span>
                                        }
                                    </div>
                                    <div class="col-md-2 d-none d-md-block">@EstandarBadge(detalle)</div>
                                    <div class="col-8 col-md-3">
                                        @if (ControlProcesoCatalogo.EsNumerico(detalle.TipoDato))
                                        {
                                            <div class="input-group">
                                                @if (ControlProcesoUi.AdmiteNegativo(detalle) && !isReadOnly)
                                                {
                                                    <button type="button" class="btn btn-outline-secondary" title="Cambiar el signo (+/−)"
                                                            @onclick="() => CambiarSigno(localDetalle)">±</button>
                                                }
                                                @* Teclado numérico del celular: inputmode decimal. Se acepta coma o punto. *@
                                                <input type="text"
                                                       inputmode="decimal"
                                                       enterkeyhint="next"
                                                       autocomplete="off"
                                                       aria-label="@($"Valor de {detalle.ParametroNombre}")"
                                                       class="form-control valor-punto @(evaluacion == ControlProcesoUi.FueraDeRango ? "border-warning" : "") @(numerosInvalidos.Contains(detalle.ParametroId) ? "is-invalid" : "")"
                                                       value="@(textoTipeado.TryGetValue(detalle.ParametroId, out var t) ? t : ControlProcesoUi.MostrarNumero(detalle.ValorReal))"
                                                       @onchange="e => OnValorChanged(localDetalle, e)"
                                                       disabled="@isReadOnly" />
                                                @if (!string.IsNullOrEmpty(detalle.UnidadMedida))
                                                {
                                                    <span class="input-group-text">@detalle.UnidadMedida</span>
                                                }
                                            </div>
                                            @if (numerosInvalidos.Contains(detalle.ParametroId))
                                            {
                                                <div class="small text-danger">Escribí un número, por ejemplo 152 o 0,7.</div>
                                            }
                                        }
                                        else if (detalle.TipoDato == ControlProcesoCatalogo.OkNoOk)
                                        {
                                            <div class="btn-group w-100" role="group">
                                                <button type="button"
                                                        class="btn @(detalle.ValorRealTexto == ControlProcesoCatalogo.Ok ? "btn-success" : "btn-outline-success")"
                                                        @onclick="() => OnOkNoOk(localDetalle, ControlProcesoCatalogo.Ok)"
                                                        disabled="@isReadOnly">OK</button>
                                                <button type="button"
                                                        class="btn @(detalle.ValorRealTexto == ControlProcesoCatalogo.NoOk ? "btn-danger" : "btn-outline-danger")"
                                                        @onclick="() => OnOkNoOk(localDetalle, ControlProcesoCatalogo.NoOk)"
                                                        disabled="@isReadOnly">NO OK</button>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="d-flex gap-1 align-items-start">
                                                <input type="text"
                                                       maxlength="200"
                                                       class="form-control"
                                                       aria-label="@($"Valor de {detalle.ParametroNombre}")"
                                                       value="@detalle.ValorRealTexto"
                                                       @onchange="e => OnValorTextoChanged(localDetalle, e.Value?.ToString())"
                                                       disabled="@isReadOnly" />
                                                @if (!isReadOnly)
                                                {
                                                    <BotonDictado Value="@detalle.ValorRealTexto" ValueChanged="@((string v) => OnValorTextoChanged(localDetalle, v))"
                                                                  MaxLength="200" Compacto="true" Campo="@detalle.ParametroNombre" />
                                                }
                                            </div>
                                        }
                                    </div>
                                    <div class="col-4 col-md-2 text-end text-md-start estado-punto">@EstadoBadge(evaluacion)</div>
                                    <div class="col-12 col-md-2">
                                        @if (verObservacion)
                                        {
                                            <div class="d-flex gap-1 align-items-start">
                                                <input type="text"
                                                       maxlength="1000"
                                                       class="form-control form-control-sm @(ControlProcesoUi.FaltaObservacion(detalle) ? "border-danger" : "")"
                                                       aria-label="@($"Observación de {detalle.ParametroNombre}")"
                                                       value="@detalle.Observacion"
                                                       placeholder="@(evaluacion == ControlProcesoUi.FueraDeRango ? "Obligatoria: fuera de estándar" : "Observación")"
                                                       @onchange="e => OnObservacionChanged(localDetalle, e.Value?.ToString())"
                                                       disabled="@isReadOnly" />
                                                @if (!isReadOnly)
                                                {
                                                    <BotonDictado Value="@detalle.Observacion" ValueChanged="@((string v) => OnObservacionChanged(localDetalle, v))"
                                                                  MaxLength="1000" Compacto="true" Campo="@($"la observación de {detalle.ParametroNombre}")" />
                                                }
                                            </div>
                                        }
                                        else if (!isReadOnly)
                                        {
                                            <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none" @onclick="() => observacionesAbiertas.Add(localDetalle.ParametroId)">
                                                <i class="bi bi-plus"></i> Observación
                                            </button>
                                        }
                                    </div>
                                </div>
                            }
                        }

                        @if (registro.Estado != "CERRADO")
                        {
                            <div class="d-flex justify-content-between align-items-center mt-3 flex-wrap gap-2">
                                <small class="text-muted">Se guarda solo a medida que cargás.</small>
                                @if (siguiente != null)
                                {
                                    <button class="btn btn-primary btn-lg" id="btn-siguiente-grupo" @onclick="@(async () => await IrAGrupo(siguiente.GrupoParametroId, subir: true))">
                                        Siguiente: @siguiente.Nombre <i class="bi bi-arrow-right ms-1"></i>
                                    </button>
                                }
                                else
                                {
                                    <span class="text-muted">Último grupo.</span>
                                }
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- Acciones finales -->
            @if (registro.Estado != "CERRADO")
            {
                <div class="card mt-3">
                    <div class="card-body d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <button class="btn btn-outline-primary" @onclick="@(async () => await GuardarAhora())" disabled="@(guardando || !HayPendientes)">
                            <i class="bi bi-save me-1"></i> Guardar ahora
                        </button>

                        @if (Completados == Total)
                        {
                            <button class="btn btn-success" @onclick="CerrarRegistro" disabled="@guardando">
                                <i class="bi bi-check-circle me-1"></i> Cerrar control
                            </button>
                        }
                        else
                        {
                            <button class="btn btn-outline-success" disabled title="Completá todos los puntos para poder cerrar">
                                <i class="bi bi-check-circle me-1"></i> Cerrar control (@Completados/@Total)
                            </button>
                        }
                    </div>
                </div>
            }
        }
        else
        {
            <div class="alert alert-info">
                No hay puntos de control configurados para este control.
            </div>
        }
    }
</div>

@code {
    [Parameter]
    public long Id { get; set; }

    private RegistroProcesoCompletoDto? registro;
    private int selectedGrupoId;
    private bool isLoading = true;
    private string? errorMessage;
    private string? successMessage;

    // Autoguardado: cada cambio queda pendiente y se manda solo al rato (o al cambiar de grupo).
    private readonly Dictionary<int, int> versionPendiente = new();   // ParametroId → versión local del cambio
    private int versionLocal;
    private bool guardando;
    private bool guardarOtraVez;
    private string? errorGuardado;
    private DateTime? ultimoGuardado;
    private CancellationTokenSource? demora;
    private static readonly TimeSpan DemoraAutoguardado = TimeSpan.FromSeconds(1.2);

    private readonly HashSet<int> observacionesAbiertas = new();
    private readonly HashSet<int> numerosInvalidos = new();
    private readonly Dictionary<int, string> textoTipeado = new();     // lo que no se pudo leer como número

    private List<GrupoConDetallesDto> GruposOrdenados => registro?.Grupos.OrderBy(g => g.Orden).ToList() ?? new();
    private IEnumerable<RegistroProcesoDetalleDto> Todos => registro?.Grupos.SelectMany(g => g.Detalles) ?? Enumerable.Empty<RegistroProcesoDetalleDto>();
    private int Total => Todos.Count(d => !d.FueraDePlantilla);
    private int Completados => Todos.Count(d => !d.FueraDePlantilla && ControlProcesoUi.TieneValor(d));
    private int Desvios => Todos.Count(d => Evaluacion(d) == ControlProcesoUi.FueraDeRango);
    private int SinEstandarCargados => Todos.Count(d => Evaluacion(d) == ControlProcesoUi.SinEstandar);
    private int Porcentaje => Total > 0 ? Completados * 100 / Total : 0;
    private bool HayPendientes => versionPendiente.Count > 0;
    private int EsperanObservacion => versionPendiente.Keys.Count(id => Buscar(id) is { } d && ControlProcesoUi.FaltaObservacion(d));

    private string TextoGuardado
    {
        get
        {
            if (registro?.Estado == "CERRADO") return "Cerrado";
            if (guardando) return "Guardando…";
            if (errorGuardado != null) return "No se guardó: " + errorGuardado;
            if (EsperanObservacion > 0) return $"Falta la observación en {EsperanObservacion} punto(s) fuera de rango para guardarlos";
            if (HayPendientes) return "Sin guardar…";
            return ultimoGuardado.HasValue ? $"Guardado {ultimoGuardado.Value:HH:mm}" : "Todo guardado";
        }
    }

    private string ClaseGuardado => guardando || HayPendientes ? "text-muted" : errorGuardado != null || EsperanObservacion > 0 ? "text-danger" : "text-success";

    protected override async Task OnInitializedAsync()
    {
        await CargarRegistro();
    }

    private async Task CargarRegistro(bool conservarGrupo = false)
    {
        if (!conservarGrupo) isLoading = true;
        try
        {
            var nuevo = await RegistroProcesoService.GetRegistroAsync(Id);
            registro = nuevo;
            if (registro != null && registro.Grupos.Any()
                && (!conservarGrupo || registro.Grupos.All(g => g.GrupoParametroId != selectedGrupoId)))
            {
                selectedGrupoId = registro.Grupos.OrderBy(g => g.Orden).First().GrupoParametroId;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al cargar el control: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private GrupoConDetallesDto? GetGrupoActual() =>
        registro?.Grupos.FirstOrDefault(g => g.GrupoParametroId == selectedGrupoId);

    private RegistroProcesoDetalleDto? Buscar(int parametroId) =>
        Todos.FirstOrDefault(d => d.ParametroId == parametroId && !d.FueraDePlantilla);

    /// <summary>Lo que dice la API si el punto ya está guardado; si se está cargando, la misma regla en el navegador.</summary>
    private string Evaluacion(RegistroProcesoDetalleDto d) =>
        versionPendiente.ContainsKey(d.ParametroId) || string.IsNullOrEmpty(d.Evaluacion)
            ? ControlProcesoUi.EvaluarLocal(d)
            : d.Evaluacion;

    // ---------- Cambios ----------

    private void OnValorChanged(RegistroProcesoDetalleDto detalle, ChangeEventArgs e)
    {
        var texto = e.Value?.ToString();
        if (string.IsNullOrWhiteSpace(texto))
        {
            numerosInvalidos.Remove(detalle.ParametroId);
            textoTipeado.Remove(detalle.ParametroId);
            detalle.ValorReal = null;
            RegistrarCambio(detalle);
            return;
        }

        if (ControlProcesoUi.TryLeerNumero(texto, out var valor))
        {
            numerosInvalidos.Remove(detalle.ParametroId);
            textoTipeado.Remove(detalle.ParametroId);
            detalle.ValorReal = valor;
            RegistrarCambio(detalle);
        }
        else
        {
            numerosInvalidos.Add(detalle.ParametroId);
            textoTipeado[detalle.ParametroId] = texto;
        }
    }

    private void CambiarSigno(RegistroProcesoDetalleDto detalle)
    {
        if (!detalle.ValorReal.HasValue || detalle.ValorReal == 0) return;
        detalle.ValorReal = -detalle.ValorReal.Value;
        RegistrarCambio(detalle);
    }

    private void OnOkNoOk(RegistroProcesoDetalleDto detalle, string valor)
    {
        detalle.ValorRealTexto = valor;
        RegistrarCambio(detalle);
    }

    private void OnValorTextoChanged(RegistroProcesoDetalleDto detalle, string? valor)
    {
        detalle.ValorRealTexto = valor;
        RegistrarCambio(detalle);
    }

    private void OnObservacionChanged(RegistroProcesoDetalleDto detalle, string? valor)
    {
        detalle.Observacion = valor;
        RegistrarCambio(detalle);
    }

    private void RegistrarCambio(RegistroProcesoDetalleDto detalle)
    {
        versionPendiente[detalle.ParametroId] = ++versionLocal;
        detalle.FueraDeEstandar = ControlProcesoUi.EvaluarLocal(detalle) == ControlProcesoUi.FueraDeRango;
        errorGuardado = null;
        ProgramarAutoguardado();
    }

    // ---------- Autoguardado ----------

    private void ProgramarAutoguardado()
    {
        demora?.Cancel();
        demora = new CancellationTokenSource();
        var token = demora.Token;
        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(DemoraAutoguardado, token);
                await InvokeAsync(async () =>
                {
                    await GuardarPendientes();
                    StateHasChanged();
                });
            }
            catch (TaskCanceledException) { }
        });
    }

    private async Task GuardarAhora()
    {
        demora?.Cancel();
        await GuardarPendientes();
    }

    /// <summary>
    /// Manda lo pendiente que está listo. Los puntos fuera de rango sin observación esperan (la API los rechazaría y
    /// con ellos todo el lote). Si mientras se guarda hay más cambios, se vuelve a mandar al terminar.
    /// </summary>
    private async Task GuardarPendientes()
    {
        if (registro == null || registro.Estado == "CERRADO") return;
        if (guardando)
        {
            guardarOtraVez = true;
            return;
        }

        guardando = true;
        try
        {
            do
            {
                guardarOtraVez = false;
                var lote = versionPendiente
                    .Select(p => (Detalle: Buscar(p.Key), Version: p.Value))
                    .Where(x => x.Detalle != null && ControlProcesoUi.TieneValor(x.Detalle) && !ControlProcesoUi.FaltaObservacion(x.Detalle))
                    .ToList();

                // Un valor borrado no se guarda (la carga es solo de agregado): sale de pendientes.
                foreach (var id in versionPendiente.Keys.Where(id => Buscar(id) is { } d && !ControlProcesoUi.TieneValor(d)).ToList())
                {
                    versionPendiente.Remove(id);
                }

                if (lote.Count == 0) break;

                var request = new GuardarValoresRequest
                {
                    RegistroProcesoId = registro.RegistroProcesoId,
                    RowVersion = registro.RowVersion,
                    Valores = lote.Select(x => new ValorParametroRequest
                    {
                        ParametroId = x.Detalle!.ParametroId,
                        ValorReal = x.Detalle.ValorReal,
                        ValorRealTexto = x.Detalle.ValorRealTexto,
                        Observacion = x.Detalle.Observacion
                    }).ToList()
                };

                var (success, error) = await RegistroProcesoService.GuardarValoresAsync(request);
                if (!success)
                {
                    errorGuardado = error ?? "error al guardar";
                    break;
                }

                // Sale de pendientes solo lo que no se volvió a tocar mientras viajaba.
                foreach (var (detalle, version) in lote)
                {
                    if (versionPendiente.TryGetValue(detalle!.ParametroId, out var actual) && actual == version)
                    {
                        versionPendiente.Remove(detalle.ParametroId);
                    }
                }

                ultimoGuardado = DateTime.Now;
                errorGuardado = null;
                await RefrescarDesdeApi();
            } while (guardarOtraVez || versionPendiente.Keys.Any(id => Buscar(id) is { } d && ControlProcesoUi.TieneValor(d) && !ControlProcesoUi.FaltaObservacion(d)));
        }
        catch (Exception ex)
        {
            errorGuardado = ex.Message;
        }
        finally
        {
            guardando = false;
        }
    }

    /// <summary>
    /// Trae lo guardado (RowVersion nuevo, estado y la evaluación de la API) sin perder lo que se está tipeando
    /// ni cambiar de grupo.
    /// </summary>
    private async Task RefrescarDesdeApi()
    {
        var nuevo = await RegistroProcesoService.GetRegistroAsync(Id);
        if (nuevo == null || registro == null) return;

        var locales = Todos.Where(d => versionPendiente.ContainsKey(d.ParametroId)).ToDictionary(d => d.ParametroId);
        foreach (var d in nuevo.Grupos.SelectMany(g => g.Detalles))
        {
            if (!d.FueraDePlantilla && locales.TryGetValue(d.ParametroId, out var local))
            {
                d.ValorReal = local.ValorReal;
                d.ValorRealTexto = local.ValorRealTexto;
                d.Observacion = local.Observacion;
                d.FueraDeEstandar = local.FueraDeEstandar;
            }
        }

        registro = nuevo;
    }

    private async Task IrAGrupo(int grupoId, bool subir)
    {
        demora?.Cancel();
        await GuardarPendientes();
        selectedGrupoId = grupoId;
        if (subir)
        {
            try
            {
                await using var ui = await JS.InvokeAsync<IJSObjectReference>("import", "./js/ui.js");
                await ui.InvokeVoidAsync("arriba");
            }
            catch (JSException) { }
        }
    }

    private async Task CerrarRegistro()
    {
        if (registro == null) return;

        demora?.Cancel();
        await GuardarPendientes();
        if (HayPendientes || errorGuardado != null)
        {
            errorMessage = "Antes de cerrar hay puntos sin guardar. " + TextoGuardado;
            return;
        }

        guardando = true;
        errorMessage = null;
        try
        {
            var request = new CerrarRegistroProcesoRequest
            {
                RegistroProcesoId = registro.RegistroProcesoId,
                RowVersion = registro.RowVersion
            };

            var (success, error) = await RegistroProcesoService.CerrarRegistroAsync(Id, request);
            if (success)
            {
                successMessage = "Control cerrado correctamente.";
                await CargarRegistro(conservarGrupo: true);
            }
            else
            {
                errorMessage = error ?? "Error al cerrar el control.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            guardando = false;
        }
    }

    private async Task Volver()
    {
        demora?.Cancel();
        await GuardarPendientes();
        Navigation.NavigateTo("/control-proceso");
    }

    public async ValueTask DisposeAsync()
    {
        // Si se va de la pantalla con cambios, se intenta guardarlos igual.
        demora?.Cancel();
        if (HayPendientes && !guardando)
        {
            try { await GuardarPendientes(); } catch { /* best effort */ }
        }
    }

    // ---------- Presentación ----------

    private static string ClaseFila(string evaluacion) => evaluacion switch
    {
        ControlProcesoUi.FueraDeRango => "punto-fuera",
        ControlProcesoUi.SinEstandar => "punto-sin-estandar",
        _ => ""
    };

    private RenderFragment EstandarBadge(RegistroProcesoDetalleDto d) => __builder =>
    {
        if (!ControlProcesoCatalogo.EsNumerico(d.TipoDato))
        {
            if (!string.IsNullOrEmpty(d.ValorEstandarSnapshot))
            {
                <span class="badge bg-info">@d.ValorEstandarSnapshot</span>
            }
        }
        else if (d.TieneRango) // con valor cargado: si había rango ESE día (snapshot), no el estándar de hoy
        {
            <span class="badge bg-info">@d.ValorEstandarSnapshot</span>
        }
        else if (!string.IsNullOrWhiteSpace(d.ValorEstandarSnapshot))
        {
            @* Valor único de la planilla sin tolerancia: se muestra, pero no alcanza para decir OK. *@
            <span class="badge bg-secondary" title="Valor de referencia sin tolerancia: falta cargar el rango en el estándar">
                @d.ValorEstandarSnapshot (ref.)
            </span>
            <span class="small text-danger d-block d-md-block">sin tolerancia</span>
        }
        else
        {
            <span class="badge text-danger-emphasis bg-danger-subtle border border-danger-subtle" title="Este punto no tiene estándar cargado para el producto">Sin estándar</span>
        }
    };

    private static RenderFragment EstadoBadge(string evaluacion) => __builder =>
    {
        switch (evaluacion)
        {
            case ControlProcesoUi.Ok:
                <span class="badge bg-success" title="Dentro del estándar"><i class="bi bi-check"></i> OK</span>
                break;
            case ControlProcesoUi.FueraDeRango:
                <span class="badge bg-warning text-dark" title="Fuera del estándar"><i class="bi bi-exclamation-triangle"></i> Fuera</span>
                break;
            case ControlProcesoUi.SinEstandar:
                <span class="badge bg-danger" title="No hay rango contra el que comparar: falta cargar el estándar"><i class="bi bi-question-circle"></i> Falta estándar</span>
                break;
            case ControlProcesoUi.Informativo:
                <span class="badge bg-secondary" title="Dato cargado (no se compara)"><i class="bi bi-check"></i> Cargado</span>
                break;
            default:
                <span class="badge bg-light text-muted border" title="Sin cargar"><i class="bi bi-dash"></i></span>
                break;
        }
    };

    private string GetEstadoBadgeClass(string estado) => estado switch
    {
        "PARCIAL" => "bg-warning text-dark",
        "COMPLETO" => "bg-info",
        "CERRADO" => "bg-success",
        _ => "bg-secondary"
    };
}
