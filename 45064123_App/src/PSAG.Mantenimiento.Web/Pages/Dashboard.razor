@page "/"
@page "/dashboard"
@using Microsoft.AspNetCore.Authorization
@using PSAG.Mantenimiento.Web.Models
@using PSAG.Mantenimiento.Web.Services
@attribute [Authorize]
@inject IDashboardService DashboardService
@inject ICatalogosService CatalogosService
@inject IConteoCamaraService ConteoCamaraService
@inject Microsoft.Extensions.Configuration.IConfiguration Configuracion
@implements IAsyncDisposable

<PageTitle>Dashboard - PSAG Produccion</PageTitle>

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Dashboard de Control</h2>
        <div class="d-flex gap-2">
            <select class="form-select form-select-sm" style="width: auto;" @bind="filtroLineaId" @bind:after="@(async () => await ActualizarAhora())">
                <option value="0">Todas las líneas</option>
                @foreach (var linea in lineas)
                {
                    <option value="@linea.LineaId">@linea.Nombre</option>
                }
            </select>
            <button class="btn btn-outline-primary btn-sm text-nowrap" @onclick="@(async () => await ActualizarAhora())" disabled="@actualizando">
                @if (actualizando)
                {
                    <span class="spinner-border spinner-border-sm" role="status"></span>
                }
                else
                {
                    <i class="bi bi-arrow-clockwise"></i>
                }
                Actualizar
            </button>
        </div>
    </div>

    @* Estado del refresco automático (reunión 17/11): de cuándo son los datos y si hay alguno viejo. *@
    <div class="d-flex flex-wrap justify-content-end align-items-center gap-2 small mb-2 dashboard-estado" aria-live="polite">
        @if (datosHastaGeneral is { } hasta)
        {
            <span class="badge bg-success-subtle text-success-emphasis border border-success-subtle"
                  title="Fin del último minuto cerrado que mandaron las cámaras. El panel va 1 o 2 minutos atrás del contador de la máquina: para comparar, mirar el contador a esa hora.">
                <i class="bi bi-camera-video me-1"></i>Datos hasta las @hasta.ToString("HH:mm")
            </span>
        }
        @foreach (var camara in camarasAtrasadas)
        {
            <span class="badge text-bg-danger" title="@EficienciaUi.AvisoAtraso(camara)">
                <i class="bi bi-exclamation-triangle-fill me-1"></i>@EficienciaUi.Titulo(camara): sin datos nuevos hace @EficienciaUi.Minutos(camara.MinutosSinDatosNuevos ?? 0)
            </span>
        }
        @if (ultimaActualizacion is { } ultima)
        {
            <span class="text-muted">
                Actualizado @ultima.ToString("HH:mm:ss")@(opciones.RefrescoActivo ? $" · se actualiza cada {TextoIntervalo}" : "")
            </span>
        }
        @if (errorRefresco is { } fallo)
        {
            <span class="text-danger">No se pudo actualizar a las @fallo.ToString("HH:mm:ss"); se muestran los datos anteriores.</span>
        }
    </div>

    @if (errorLineas)
    {
        <div class="text-danger small text-end mb-2">No se pudo cargar la lista de líneas. Tocá Actualizar o recargá la página.</div>
    }

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
        </div>
    }
    else if (dashboard != null)
    {
        <!-- Resumen de los 3 Ejes -->
        <div class="row mb-4">
            <!-- Eje 1: Detenciones -->
            <div class="col-lg-4 mb-3">
                <div class="card h-100 border-danger">
                    <div class="card-header bg-danger text-white">
                        <h6 class="mb-0"><i class="bi bi-pause-circle me-2"></i>Detenciones (últimos 30 días)</h6>
                    </div>
                    <div class="card-body">
                        <div class="row text-center">
                            <div class="col-6">
                                <h3 class="mb-0">@dashboard.Resumen.TotalDetenciones</h3>
                                <small class="text-muted">Total</small>
                            </div>
                            <div class="col-6">
                                <h3 class="mb-0 text-warning">@dashboard.Resumen.DetencionesAbiertas</h3>
                                <small class="text-muted" title="Registradas o en análisis, de los últimos 30 días">Sin cerrar (30 días)</small>
                            </div>
                        </div>
                        <hr />
                        <div class="row text-center">
                            <div class="col-6">
                                <h4 class="mb-0">@FormatMinutos(dashboard.Resumen.MinutosTotalesParada)</h4>
                                <small class="text-muted">Tiempo Total</small>
                            </div>
                            <div class="col-6">
                                <h4 class="mb-0">@FormatMinutos((int)dashboard.Resumen.TiempoPromedioResolucionMinutos)</h4>
                                <small class="text-muted">Promedio</small>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer bg-transparent">
                        <a href="/detenciones" class="btn btn-outline-danger btn-sm w-100">Ver Detenciones</a>
                    </div>
                </div>
            </div>

            <!-- Eje 2: Control de Proceso -->
            <div class="col-lg-4 mb-3">
                <div class="card h-100 border-primary">
                    <div class="card-header bg-primary text-white">
                        <h6 class="mb-0"><i class="bi bi-clipboard-data me-2"></i>Control de Proceso (Hoy)</h6>
                    </div>
                    <div class="card-body">
                        <div class="row text-center">
                            <div class="col-6">
                                <h3 class="mb-0">@dashboard.ResumenProceso.TotalRegistrosHoy</h3>
                                <small class="text-muted">Controles</small>
                            </div>
                            <div class="col-6">
                                <h3 class="mb-0">@dashboard.ResumenProceso.TotalValoresCapturados</h3>
                                <small class="text-muted">Valores</small>
                            </div>
                        </div>
                        <hr />
                        <div class="row text-center">
                            <div class="col-6">
                                <h4 class="mb-0 @(dashboard.ResumenProceso.PorcentajeCumplimiento >= 95 ? "text-success" : "text-warning")">
                                    @dashboard.ResumenProceso.PorcentajeCumplimiento%
                                </h4>
                                <small class="text-muted">Cumplimiento</small>
                            </div>
                            <div class="col-6">
                                <h4 class="mb-0 text-danger">@dashboard.ResumenProceso.ValoresFueraEstandar</h4>
                                <small class="text-muted">Fuera de estándar</small>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer bg-transparent">
                        <a href="/control-proceso" class="btn btn-outline-primary btn-sm w-100">Ver Control de Proceso</a>
                    </div>
                </div>
            </div>

            <!-- Eje 3: Inspecciones -->
            <div class="col-lg-4 mb-3">
                <div class="card h-100 border-success">
                    <div class="card-header bg-success text-white">
                        <h6 class="mb-0"><i class="bi bi-clipboard-check me-2"></i>Inspecciones (Semana)</h6>
                    </div>
                    <div class="card-body">
                        <div class="row text-center">
                            <div class="col-6">
                                <h3 class="mb-0">@dashboard.ResumenInspecciones.InspeccionesCompletadasHoy</h3>
                                <small class="text-muted">Completadas Hoy</small>
                            </div>
                            <div class="col-6">
                                <h3 class="mb-0 text-info">@dashboard.ResumenInspecciones.InspeccionesEnProgreso</h3>
                                <small class="text-muted">En Progreso</small>
                            </div>
                        </div>
                        <hr />
                        <div class="row text-center">
                            <div class="col-6">
                                <h4 class="mb-0 @(dashboard.ResumenInspecciones.PorcentajeOkSemana >= 95 ? "text-success" : "text-warning")">
                                    @dashboard.ResumenInspecciones.PorcentajeOkSemana%
                                </h4>
                                <small class="text-muted">OK Semana</small>
                            </div>
                            <div class="col-6">
                                <h4 class="mb-0 text-warning">@dashboard.ResumenInspecciones.HallazgosNoOkPendientes</h4>
                                <small class="text-muted">NO OK Pendientes</small>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer bg-transparent">
                        <a href="/inspecciones" class="btn btn-outline-success btn-sm w-100">Ver Inspecciones</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Eficiencia por turno según la cámara (reunión 03/11); los datos los refresca esta página (reunión 17/11). -->
        <EficienciaCamara Hoy="@eficienciaHoy" Ayer="@eficienciaAyer" Cargando="@actualizando" />

        <!-- Detenciones por Linea y Tipo de Falla -->
        <div class="row mb-4">
            <div class="col-lg-6 mb-3">
                <div class="card h-100">
                    <div class="card-header">
                        <h6 class="mb-0">Detenciones por línea (30 días)</h6>
                    </div>
                    <div class="card-body p-0">
                        @if (dashboard.DetencionesPorLinea.Any())
                        {
                            <table class="table table-sm mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Línea</th>
                                        <th class="text-center">Cantidad</th>
                                        <th class="text-end">Tiempo</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var linea in dashboard.DetencionesPorLinea.Take(5))
                                    {
                                        <tr>
                                            <td>@linea.LineaNombre</td>
                                            <td class="text-center"><span class="badge bg-secondary">@linea.CantidadDetenciones</span></td>
                                            <td class="text-end">@FormatMinutos(linea.MinutosTotalesParada)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                        else
                        {
                            <p class="text-muted text-center py-3">Sin detenciones en los últimos 30 días.</p>
                        }
                    </div>
                </div>
            </div>

            <div class="col-lg-6 mb-3">
                <div class="card h-100">
                    <div class="card-header">
                        <h6 class="mb-0">Detenciones por Tipo de Falla</h6>
                    </div>
                    <div class="card-body p-0">
                        @if (dashboard.DetencionesPorTipoFalla.Any())
                        {
                            <table class="table table-sm mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Tipo</th>
                                        <th class="text-center">Cantidad</th>
                                        <th class="text-end">%</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var tipo in dashboard.DetencionesPorTipoFalla.Take(5))
                                    {
                                        <tr>
                                            <td>@tipo.TipoFallaNombre</td>
                                            <td class="text-center"><span class="badge bg-secondary">@tipo.CantidadDetenciones</span></td>
                                            <td class="text-end">@tipo.Porcentaje%</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                        else
                        {
                            <p class="text-muted text-center py-3">Sin detenciones en los últimos 30 días.</p>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Detenciones Abiertas y Hallazgos NO OK -->
        <div class="row mb-4">
            <div class="col-lg-6 mb-3">
                <div class="card h-100">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h6 class="mb-0">Pendientes de análisis</h6>
                        <span class="badge bg-warning text-dark" title="Total de detenciones con análisis pendiente">@dashboard.TotalPendientesAnalisis</span>
                    </div>
                    <div class="card-body p-0">
                        @if (dashboard.DetencionesAbiertas.Any())
                        {
                            <div class="list-group list-group-flush">
                                @foreach (var det in dashboard.DetencionesAbiertas.Take(MostrarPendientes))
                                {
                                    <a href="/detenciones/@det.DetencionId" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                                        <div>
                                            <strong>@det.Codigo</strong>
                                            <br />
                                            <small class="text-muted">@det.LineaNombre @(det.EquipoNombre != null ? $"- {det.EquipoNombre}" : "")</small>
                                        </div>
                                        <div class="text-end">
                                            <span class="badge @GetPrioridadClass(det.Prioridad)">@det.MinutosEfectivos min</span>
                                            <br />
                                            <small class="text-muted">@det.Estado</small>
                                        </div>
                                    </a>
                                }
                            </div>
                            @if (dashboard.TotalPendientesAnalisis > MostrarPendientes)
                            {
                                <div class="small text-muted px-3 py-2 border-top">
                                    Se muestran las @MostrarPendientes más largas de @dashboard.TotalPendientesAnalisis.
                                    <a href="/detenciones/pendientes">Ver todas en Mis pendientes</a>.
                                </div>
                            }
                        }
                        else
                        {
                            <p class="text-success text-center py-3">
                                <i class="bi bi-check-circle me-2"></i>No hay detenciones esperando análisis.
                            </p>
                        }
                    </div>
                </div>
            </div>

            <div class="col-lg-6 mb-3">
                <div class="card h-100">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h6 class="mb-0">Hallazgos NO OK Pendientes</h6>
                        <span class="badge bg-warning text-dark">@dashboard.HallazgosPendientes.Count</span>
                    </div>
                    <div class="card-body p-0">
                        @if (dashboard.HallazgosPendientes.Any())
                        {
                            <div class="list-group list-group-flush">
                                @foreach (var hallazgo in dashboard.HallazgosPendientes.Take(5))
                                {
                                    <a href="/inspecciones/hallazgos" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                                        <div>
                                            <strong>@hallazgo.LineaNombre</strong>
                                            @if (hallazgo.RequiereAccionCorrectiva)
                                            {
                                                <span class="badge bg-danger ms-1">AC</span>
                                            }
                                            <br />
                                            <small class="text-muted">@TruncateText(hallazgo.Descripcion, 50)</small>
                                        </div>
                                        <div class="text-end">
                                            <span class="badge bg-secondary">@hallazgo.DiasAbierto dias</span>
                                            <br />
                                            <small class="text-muted">@hallazgo.FechaHoraHallazgo.ToString("dd/MM")</small>
                                        </div>
                                    </a>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="text-success text-center py-3">
                                <i class="bi bi-check-circle me-2"></i>Sin hallazgos pendientes
                            </p>
                        }
                    </div>
                    @if (dashboard.HallazgosPendientes.Any())
                    {
                        <div class="card-footer bg-transparent">
                            <a href="/inspecciones/hallazgos" class="btn btn-outline-warning btn-sm w-100">Ver Panel NO OK</a>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Top Desvios de Proceso -->
        @if (dashboard.TopDesviaciones.Any())
        {
            <div class="row mb-4">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <h6 class="mb-0">Desvios de Proceso (Hoy)</h6>
                        </div>
                        <div class="card-body p-0">
                            <table class="table table-sm table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Parametro</th>
                                        <th>Línea</th>
                                        <th>Producto</th>
                                        <th class="text-center">Valor</th>
                                        <th class="text-center">Estandar</th>
                                        <th>Hora</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var desvio in dashboard.TopDesviaciones.Take(5))
                                    {
                                        <tr class="table-warning">
                                            <td><strong>@desvio.ParametroNombre</strong></td>
                                            <td>@desvio.LineaNombre</td>
                                            <td>@desvio.ProductoNombre</td>
                                            <td class="text-center"><span class="badge bg-danger">@desvio.ValorCapturado</span></td>
                                            <td class="text-center">@(desvio.ValorEstandar?.ToString() ?? "-")</td>
                                            <td><small>@desvio.FechaHora.ToString("HH:mm")</small></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="alert alert-danger">
            <i class="bi bi-exclamation-triangle me-2"></i>
            No se pudieron cargar los datos del inicio. Revisá la conexión y tocá Actualizar; si sigue, avisá a sistemas.
        </div>
    }
</div>

@code {
    private List<LineaDto> lineas = new();
    private DashboardCompletoDto? dashboard;
    private EficienciaCamaraDiaDto? eficienciaHoy;
    private EficienciaCamaraDiaDto? eficienciaAyer;
    private int filtroLineaId;
    private int? lineaCargada;
    private bool isLoading = true;
    private bool actualizando;
    private const int MostrarPendientes = 5;
    private bool errorLineas;

    // Refresco automático (reunión 17/11): cada Dashboard:SegundosRefresco (60 s por defecto), sin solapar llamadas.
    private OpcionesDashboard opciones = new(OpcionesDashboard.SegundosRefrescoPorDefecto, OpcionesDashboard.MinutosDatosAtrasadosPorDefecto);
    private RefrescoPeriodico? refresco;
    private DateTime? ultimaActualizacion;
    private DateTime? errorRefresco;
    private DateTimeOffset? datosHastaGeneral;
    private List<EficienciaCamaraPuntoDto> camarasAtrasadas = new();
    private bool liberado;

    private string TextoIntervalo => opciones.SegundosRefresco % 60 == 0
        ? $"{opciones.SegundosRefresco / 60} min"
        : $"{opciones.SegundosRefresco} s";

    protected override async Task OnInitializedAsync()
    {
        opciones = OpcionesDashboard.Leer(Configuracion);
        try
        {
            lineas = await CatalogosService.GetLineasAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error cargando líneas: {ex.Message}");
            errorLineas = true;
        }

        // Con el refresco apagado (0) el timer no se inicia; el intervalo sólo hace falta para construirlo.
        refresco = new RefrescoPeriodico(
            TimeSpan.FromSeconds(opciones.RefrescoActivo ? opciones.SegundosRefresco : OpcionesDashboard.SegundosRefrescoMaximo),
            CargarAsync,
            ex => Console.WriteLine($"Error refrescando el Dashboard: {ex.Message}"));
        await refresco.SolicitarAsync();
        isLoading = false;
        if (opciones.RefrescoActivo && !liberado)
            refresco.Iniciar();
    }

    /// <summary>Botón Actualizar y cambio de línea: carga ya (si hay una carga en curso, vuelve a cargar al terminar).</summary>
    private async Task ActualizarAhora()
    {
        if (refresco != null)
            await refresco.SolicitarAsync();
    }

    /// <summary>
    /// Trae el Dashboard y la eficiencia de hoy y ayer con el filtro actual. No vacía la pantalla mientras carga
    /// (sin parpadeo ni salto de scroll): reemplaza los datos al llegar. Si una parte falla, queda la anterior.
    /// </summary>
    private async Task CargarAsync(CancellationToken ct)
    {
        var linea = filtroLineaId;
        var lineaId = linea > 0 ? (int?)linea : null;
        actualizando = true;
        await InvokeAsync(StateHasChanged);

        var fechaHoy = DateOnly.FromDateTime(DateTime.Now);
        var tareaDashboard = Intentar(() => DashboardService.GetDashboardAsync(lineaId: lineaId));
        var tareaHoy = Intentar(() => ConteoCamaraService.GetEficienciaAsync(fechaHoy, lineaId, opciones.MinutosDatosAtrasados, ct));
        var tareaAyer = Intentar(() => ConteoCamaraService.GetEficienciaAsync(fechaHoy.AddDays(-1), lineaId, opciones.MinutosDatosAtrasados, ct));
        await Task.WhenAll(tareaDashboard, tareaHoy, tareaAyer);
        actualizando = false;
        ct.ThrowIfCancellationRequested();

        // Si cambiaron la línea mientras tanto, no se pisa: la carga que pidió el cambio trae la línea nueva.
        if (linea != filtroLineaId || liberado)
            return;

        var (okDashboard, nuevoDashboard) = tareaDashboard.Result;
        var (okHoy, nuevaHoy) = tareaHoy.Result;
        var (okAyer, nuevaAyer) = tareaAyer.Result;
        // Con otra línea, lo anterior ya no corresponde: si esa parte falló queda vacía (con su aviso), no la vieja.
        var otraLinea = lineaCargada != linea;
        if (okDashboard || otraLinea) dashboard = nuevoDashboard;
        if (okHoy || otraLinea) eficienciaHoy = nuevaHoy;
        if (okAyer || otraLinea) eficienciaAyer = nuevaAyer;
        lineaCargada = linea;

        if (okDashboard && okHoy && okAyer)
        {
            ultimaActualizacion = DateTime.Now;
            errorRefresco = null;
        }
        else
        {
            errorRefresco = DateTime.Now;
        }

        var camaras = eficienciaHoy?.Camaras ?? [];
        datosHastaGeneral = EficienciaUi.DatosHastaGeneral(camaras);
        camarasAtrasadas = camaras.Where(EficienciaUi.Atrasada).ToList();
        await InvokeAsync(StateHasChanged);
    }

    private static async Task<(bool Ok, T? Valor)> Intentar<T>(Func<Task<T>> llamada)
    {
        try
        {
            return (true, await llamada());
        }
        catch (OperationCanceledException)
        {
            throw;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error cargando el Dashboard: {ex.Message}");
            return (false, default);
        }
    }

    /// <summary>Al salir de la pantalla: corta el timer y la carga en curso.</summary>
    public async ValueTask DisposeAsync()
    {
        liberado = true;
        if (refresco != null)
            await refresco.DisposeAsync();
    }

    private string FormatMinutos(int minutos)
    {
        if (minutos < 60)
            return $"{minutos}m";

        var horas = minutos / 60;
        var mins = minutos % 60;
        return mins > 0 ? $"{horas}h {mins}m" : $"{horas}h";
    }

    private string GetPrioridadClass(string prioridad) => prioridad switch
    {
        "Alta" => "bg-danger",
        "Media" => "bg-warning text-dark",
        _ => "bg-secondary"
    };

    private string TruncateText(string? value, int maxLength)
    {
        if (string.IsNullOrEmpty(value)) return string.Empty;
        return value.Length <= maxLength ? value : value.Substring(0, maxLength) + "...";
    }
}
