@page "/maestros/lineas"
@using Microsoft.AspNetCore.Authorization
@using PSAG.Mantenimiento.Web.Models
@using PSAG.Mantenimiento.Web.Services
@attribute [Authorize(Roles = "ADMINISTRADOR")]
@inject ICatalogosService CatalogosService
@inject IJSRuntime JS

<PageTitle>Lineas - PSAG Produccion</PageTitle>

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3>Lineas</h3>
        <button class="btn btn-primary" @onclick="NuevaLinea">
            <i class="bi bi-plus-circle me-2"></i>Nueva Linea
        </button>
    </div>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>Nombre</th>
                            <th>Descripcion</th>
                            <th class="text-center">Activo</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (lineas.Any())
                        {
                            @foreach (var linea in lineas)
                            {
                                <tr>
                                    <td>@linea.LineaId</td>
                                    <td><strong>@linea.Nombre</strong></td>
                                    <td>@linea.Descripcion</td>
                                    <td class="text-center">
                                        @if (linea.Activo)
                                        {
                                            <span class="badge bg-success">Activo</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Inactivo</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => EditarLinea(linea)">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmarDesactivar(linea)">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted py-4">No hay lineas registradas</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@* Modal para crear/editar *@
@if (showModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(editando ? "Editar" : "Nueva") Linea</h5>
                    <button type="button" class="btn-close" @onclick="CerrarModal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Nombre *</label>
                        <input type="text" class="form-control" @bind="lineaActual.Nombre" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Descripcion</label>
                        <textarea class="form-control" rows="3" @bind="lineaActual.Descripcion"></textarea>
                    </div>
                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" id="activo" @bind="lineaActual.Activo" />
                        <label class="form-check-label" for="activo">Activo</label>
                    </div>
                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger mt-3 mb-0">@errorMessage</div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CerrarModal">Cancelar</button>
                    <button type="button" class="btn btn-primary" @onclick="GuardarLinea" disabled="@isSaving">
                        @if (isSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        Guardar
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<LineaDto> lineas = new();
    private LineaDto lineaActual = new();
    private bool isLoading = true;
    private bool showModal = false;
    private bool editando = false;
    private bool isSaving = false;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await CargarLineas();
    }

    private async Task CargarLineas()
    {
        isLoading = true;
        try
        {
            lineas = await CatalogosService.GetLineasAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void NuevaLinea()
    {
        lineaActual = new LineaDto { Activo = true };
        editando = false;
        errorMessage = null;
        showModal = true;
    }

    private void EditarLinea(LineaDto linea)
    {
        lineaActual = new LineaDto
        {
            LineaId = linea.LineaId,
            Nombre = linea.Nombre,
            Descripcion = linea.Descripcion,
            Activo = linea.Activo
        };
        editando = true;
        errorMessage = null;
        showModal = true;
    }

    private void CerrarModal()
    {
        showModal = false;
        lineaActual = new();
    }

    private async Task GuardarLinea()
    {
        if (string.IsNullOrWhiteSpace(lineaActual.Nombre))
        {
            errorMessage = "El nombre es requerido";
            return;
        }

        isSaving = true;
        errorMessage = null;

        try
        {
            if (editando)
            {
                await CatalogosService.UpdateLineaAsync(lineaActual);
            }
            else
            {
                await CatalogosService.CreateLineaAsync(lineaActual);
            }

            showModal = false;
            await CargarLineas();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task ConfirmarDesactivar(LineaDto linea)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"¿Desea desactivar la linea '{linea.Nombre}'?");
        if (confirmed)
        {
            linea.Activo = false;
            await CatalogosService.UpdateLineaAsync(linea);
            await CargarLineas();
        }
    }
}
