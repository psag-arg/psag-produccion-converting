@page "/maestros/fallas"
@using Microsoft.AspNetCore.Authorization
@using PSAG.Mantenimiento.Web.Models
@using PSAG.Mantenimiento.Web.Services
@attribute [Authorize(Roles = "ADMINISTRADOR")]
@inject ICatalogosService CatalogosService
@inject IJSRuntime JS

<PageTitle>Fallas - PSAG Produccion</PageTitle>

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3>Fallas (Detalles de Falla)</h3>
        <div class="d-flex gap-2 align-items-center">
            <div style="width: 250px;">
                <AutocompleteSelect TItem="TipoFallaDto"
                                    TValue="int"
                                    Items="tiposFalla"
                                    @bind-SelectedValue="filtroTipoFallaId"
                                    OnValueChanged="CargarFallas"
                                    ValueSelector="@(t => t.TipoFallaId)"
                                    TextSelector="@(t => t.Nombre)"
                                    Placeholder="Filtrar por tipo...">
                    <ItemTemplate Context="tipo">
                        @tipo.Nombre
                    </ItemTemplate>
                </AutocompleteSelect>
            </div>
            <button class="btn btn-primary" @onclick="NuevaFalla">
                <i class="bi bi-plus-circle me-2"></i>Nueva falla
            </button>
        </div>
    </div>

    <AvisoDescartable @bind-Mensaje="mensajeLista" />

    <SwitchInactivos @bind-Mostrar="mostrarInactivos" @bind-Mostrar:after="CargarFallas" />

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>Tipo de Falla</th>
                            <th>Nombre</th>
                            <th>Descripción</th>
                            <th class="text-center">Activo</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (fallasFiltradas.Any())
                        {
                            @foreach (var falla in fallasFiltradas)
                            {
                                <tr>
                                    <td>@falla.DetalleFallaId</td>
                                    <td>
                                        @if (falla.TipoFallaNombre != null)
                                        {
                                            <span class="badge bg-warning text-dark">@falla.TipoFallaNombre</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted" title="Falla genérica: se ofrece con cualquier tipo de falla">Todos los tipos</span>
                                        }
                                    </td>
                                    <td><strong>@falla.Nombre</strong></td>
                                    <td>@falla.Descripcion</td>
                                    <td class="text-center">
                                        @if (falla.Activo)
                                        {
                                            <span class="badge bg-success">Activo</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Inactivo</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => EditarFalla(falla)">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        @if (falla.Activo)
                                        {
                                            <button class="btn btn-sm btn-outline-danger" title="Desactivar" @onclick="() => ConfirmarDesactivar(falla)">
                                                <i class="bi bi-pause-circle"></i>
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-4">No hay fallas registradas</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@* Modal para crear/editar *@
@if (showModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(editando ? "Editar falla" : "Nueva falla")</h5>
                    <button type="button" class="btn-close" @onclick="CerrarModal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Tipo de Falla *</label>
                        <AutocompleteSelect TItem="TipoFallaDto"
                                            TValue="int?"
                                            Items="tiposFalla"
                                            @bind-SelectedValue="fallaActual.TipoFallaId"
                                            ValueSelector="@(t => (int?)t.TipoFallaId)"
                                            TextSelector="@(t => t.Nombre)"
                                            Placeholder="Buscar tipo de falla...">
                            <ItemTemplate Context="tipo">
                                @tipo.Nombre
                            </ItemTemplate>
                        </AutocompleteSelect>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Nombre *</label>
                        <input type="text" class="form-control" @bind="fallaActual.Nombre" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Descripción</label>
                        <textarea class="form-control" rows="3" @bind="fallaActual.Descripcion"></textarea>
                    </div>
                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" id="activo" @bind="fallaActual.Activo" />
                        <label class="form-check-label" for="activo">Activo</label>
                    </div>
                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger mt-3 mb-0">@errorMessage</div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CerrarModal">Cancelar</button>
                    <button type="button" class="btn btn-primary" @onclick="GuardarFalla" disabled="@isSaving">
                        @if (isSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        Guardar
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<TipoFallaDto> tiposFalla = new();
    private List<DetalleFallaDto> fallas = new();
    private DetalleFallaDto fallaActual = new();
    private int filtroTipoFallaId = 0;
    private bool isLoading = true;
    private bool showModal = false;
    private bool editando = false;
    private bool isSaving = false;
    private string? errorMessage;
    private string? mensajeLista;
    private bool mostrarInactivos;

    private IEnumerable<DetalleFallaDto> fallasFiltradas => filtroTipoFallaId > 0
        ? fallas.Where(f => f.TipoFallaId == filtroTipoFallaId)
        : fallas;

    protected override async Task OnInitializedAsync()
    {
        tiposFalla = await CatalogosService.GetTiposFallaAsync();
        await CargarFallas();
    }

    private async Task CargarFallas()
    {
        isLoading = true;
        try
        {
            fallas = await CatalogosService.GetDetallesFallaAsync(incluirInactivos: mostrarInactivos);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void NuevaFalla()
    {
        fallaActual = new DetalleFallaDto { Activo = true, TipoFallaId = filtroTipoFallaId > 0 ? filtroTipoFallaId : 0 };
        editando = false;
        errorMessage = null;
        showModal = true;
    }

    private void EditarFalla(DetalleFallaDto falla)
    {
        fallaActual = new DetalleFallaDto
        {
            DetalleFallaId = falla.DetalleFallaId,
            TipoFallaId = falla.TipoFallaId,
            Nombre = falla.Nombre,
            Descripcion = falla.Descripcion,
            Activo = falla.Activo
        };
        editando = true;
        errorMessage = null;
        showModal = true;
    }

    private void CerrarModal()
    {
        showModal = false;
        fallaActual = new();
    }

    private async Task GuardarFalla()
    {
        if (!fallaActual.TipoFallaId.HasValue || fallaActual.TipoFallaId == 0)
        {
            errorMessage = "Elegí un tipo de falla.";
            return;
        }
        if (string.IsNullOrWhiteSpace(fallaActual.Nombre))
        {
            errorMessage = "Completá el nombre.";
            return;
        }

        isSaving = true;
        errorMessage = null;

        try
        {
            if (editando)
            {
                await CatalogosService.UpdateDetalleFallaAsync(fallaActual);
            }
            else
            {
                await CatalogosService.CreateDetalleFallaAsync(fallaActual);
            }

            showModal = false;
            await CargarFallas();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    private Task ConfirmarDesactivar(DetalleFallaDto falla) =>
        JS.ConfirmarYDesactivarAsync($"la falla '{falla.Nombre}'", Desactivacion.EfectoEnCarga,
            activo => falla.Activo = activo, () => CatalogosService.UpdateDetalleFallaAsync(falla), CargarFallas, m => mensajeLista = m);
}
