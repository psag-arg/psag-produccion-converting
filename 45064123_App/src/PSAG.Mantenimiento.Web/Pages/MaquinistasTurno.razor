@page "/detenciones/maquinistas-turno"
@using Microsoft.AspNetCore.Authorization
@using PSAG.Mantenimiento.Web.Models
@using PSAG.Mantenimiento.Web.Services
@attribute [Authorize(Roles = "ADMINISTRADOR,MANTENIMIENTO,SUPERVISOR")]
@inject IMaquinistaTurnoService MaquinistaTurnoService

<PageTitle>Maquinistas del turno - PSAG Produccion</PageTitle>

@* T-783: quién es el maquinista de cada turno de cada línea. Lo confirma el operario en el login; acá el supervisor
   lo carga o lo corrige (con motivo). Nada se pisa: cada cambio es un registro nuevo y queda el historial. Las
   detenciones pendientes de declaración de ese turno pasan a tomar al maquinista corregido. *@

<div class="container-fluid">
    <div class="d-flex flex-wrap align-items-end justify-content-between mb-3 gap-2">
        <div>
            <h2 class="mb-0">Maquinistas del turno</h2>
            <div class="text-muted">Turnos que empezaron el día elegido. El turno noche es del día en que empieza.</div>
        </div>
        <div>
            <label class="form-label small mb-1">Día</label>
            <input type="date" class="form-control" @bind="fecha" @bind:after="@(async () => await Cargar())" />
        </div>
    </div>

    @if (mensaje != null)
    {
        <div class="alert alert-success alert-dismissible">
            @mensaje
            <button type="button" class="btn-close" @onclick="() => mensaje = null"></button>
        </div>
    }

    @if (cargando)
    {
        <div class="text-center py-5"><div class="spinner-border text-primary" role="status"><span class="visually-hidden">Cargando...</span></div></div>
    }
    else if (errorCarga != null)
    {
        <div class="alert alert-warning">@errorCarga</div>
    }
    else if (dia == null || dia.Filas.Count == 0)
    {
        <div class="alert alert-info">No hay líneas o turnos activos para mostrar.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Línea</th>
                        <th>Turno</th>
                        <th>Maquinista</th>
                        <th>Cómo quedó</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var f in dia.Filas)
                    {
                        <tr class="@(f.EnCurso ? "table-primary" : "")">
                            <td>@f.LineaNombre</td>
                            <td>
                                @f.TurnoNombre
                                <div class="small text-muted">@f.Inicio.ToString("dd/MM HH:mm") a @f.Fin.ToString("dd/MM HH:mm")@(f.EnCurso ? " · en curso" : "")</div>
                            </td>
                            <td>
                                @if (f.Vigente != null)
                                {
                                    <strong>@(f.Vigente.Nombre ?? f.Vigente.UsuarioId)</strong>
                                }
                                else if (f.SegunAsignacionNombre != null)
                                {
                                    <span class="text-muted">Sin confirmar · por asignación: @f.SegunAsignacionNombre</span>
                                }
                                else
                                {
                                    <span class="text-muted">Sin maquinista</span>
                                }
                            </td>
                            <td class="small">
                                @if (f.Vigente != null)
                                {
                                    @(f.Vigente.Origen == "LOGIN" ? "Confirmó en el login" : $"Cargado por {f.Vigente.RegistradoPorNombre ?? "el supervisor"}")
                                    <span> a las @f.Vigente.FechaHora.ToString("HH:mm")</span>
                                    @if (!string.IsNullOrEmpty(f.Vigente.Observacion))
                                    {
                                        <div class="text-muted">@f.Vigente.Observacion</div>
                                    }
                                    @if (f.Historial.Count > 1)
                                    {
                                        <button class="btn btn-link btn-sm p-0" @onclick="() => Alternar(f)">
                                            @(abiertas.Contains(Clave(f)) ? "Ocultar historial" : $"Historial ({f.Historial.Count})")
                                        </button>
                                    }
                                }
                            </td>
                            <td class="text-end">
                                @if (f.PuedeCorregir)
                                {
                                    <button class="btn btn-sm btn-outline-primary" @onclick="() => AbrirCorreccion(f)">
                                        <i class="bi bi-pencil me-1"></i>@(f.Vigente == null ? "Cargar" : "Cambiar")
                                    </button>
                                }
                            </td>
                        </tr>
                        @if (abiertas.Contains(Clave(f)))
                        {
                            <tr>
                                <td colspan="5" class="small bg-body-tertiary">
                                    <ul class="mb-0">
                                        @foreach (var h in f.Historial)
                                        {
                                            <li>
                                                @h.FechaHora.ToString("HH:mm") · <strong>@(h.Nombre ?? h.UsuarioId)</strong> ·
                                                @(h.Origen == "LOGIN" ? "confirmó en el login" : $"cargado por {h.RegistradoPorNombre ?? h.RegistradoPorUsuarioId}")
                                                @if (!string.IsNullOrEmpty(h.Observacion))
                                                {
                                                    <span class="text-muted"> · @h.Observacion</span>
                                                }
                                            </li>
                                        }
                                    </ul>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@if (enEdicion != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Maquinista · @enEdicion.LineaNombre · @enEdicion.TurnoNombre</h5>
                    <button type="button" class="btn-close" @onclick="Cerrar"></button>
                </div>
                <div class="modal-body">
                    @if (enEdicion.Asignaciones.Count == 0)
                    {
                        <div class="alert alert-warning mb-0">
                            No hay maquinistas asignados a esta línea. Pedile al administrador que los cargue en Maestros → Maquinistas.
                        </div>
                    }
                    else
                    {
                        <div class="mb-3">
                            <label class="form-label">Maquinista</label>
                            <select class="form-select" @bind="usuarioLineaId">
                                <option value="0">Elegí...</option>
                                @foreach (var a in enEdicion.Asignaciones)
                                {
                                    <option value="@a.UsuarioLineaId">@(a.Nombre ?? a.UsuarioId) (@(a.TurnoNombre ?? "sin turno fijo"))</option>
                                }
                            </select>
                        </div>
                        <div class="mb-2">
                            <label class="form-label">Motivo</label>
                            <textarea class="form-control" rows="2" maxlength="500" @bind="observacion"
                                      placeholder="Ej.: cubrió el turno de Juan; confirmó por error"></textarea>
                        </div>
                        <div class="small text-muted">
                            Las detenciones pendientes de declaración de este turno pasan a este maquinista. Las ya declaradas no cambian.
                        </div>
                    }
                    @if (errorEdicion != null)
                    {
                        <div class="alert alert-danger mt-3 mb-0">@errorEdicion</div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-outline-secondary" @onclick="Cerrar">Cancelar</button>
                    <button class="btn btn-primary" disabled="@(guardando || enEdicion.Asignaciones.Count == 0)" @onclick="@(async () => await Guardar())">
                        Guardar
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private DateTime fecha = DateTime.Today;
    private MaquinistasTurnoDiaDto? dia;
    private bool cargando = true;
    private string? errorCarga;
    private string? mensaje;
    private readonly HashSet<string> abiertas = [];

    private MaquinistaTurnoFilaDto? enEdicion;
    private int usuarioLineaId;
    private string? observacion;
    private bool guardando;
    private string? errorEdicion;

    protected override async Task OnInitializedAsync() => await Cargar();

    private async Task Cargar()
    {
        cargando = true;
        errorCarga = null;
        try
        {
            dia = await MaquinistaTurnoService.GetDiaAsync(DateOnly.FromDateTime(fecha));
        }
        catch (Exception ex)
        {
            errorCarga = ex.Message;
        }
        finally
        {
            cargando = false;
        }
    }

    private static string Clave(MaquinistaTurnoFilaDto f) => $"{f.LineaId}-{f.TurnoId}";

    private void Alternar(MaquinistaTurnoFilaDto f)
    {
        if (!abiertas.Remove(Clave(f)))
            abiertas.Add(Clave(f));
    }

    private void AbrirCorreccion(MaquinistaTurnoFilaDto f)
    {
        enEdicion = f;
        usuarioLineaId = f.Vigente?.UsuarioLineaId ?? 0;
        observacion = null;
        errorEdicion = null;
    }

    private void Cerrar() => enEdicion = null;

    private async Task Guardar()
    {
        if (enEdicion == null)
            return;
        if (usuarioLineaId <= 0)
        {
            errorEdicion = "Elegí el maquinista.";
            return;
        }
        guardando = true;
        errorEdicion = null;
        try
        {
            var (resultado, error) = await MaquinistaTurnoService.CorregirAsync(new CorregirMaquinistaTurnoRequest
            {
                LineaId = enEdicion.LineaId,
                TurnoId = enEdicion.TurnoId,
                FechaTurno = DateOnly.FromDateTime(fecha),
                UsuarioLineaId = usuarioLineaId,
                Observacion = observacion
            });
            if (resultado == null)
            {
                errorEdicion = error;
                return;
            }
            mensaje = $"Maquinista guardado para {enEdicion.LineaNombre} · {enEdicion.TurnoNombre}." +
                (resultado.DetencionesReasignadas > 0 ? $" {resultado.DetencionesReasignadas} detención(es) pendiente(s) pasaron a su nombre." : "");
            enEdicion = null;
            await Cargar();
        }
        finally
        {
            guardando = false;
        }
    }
}
