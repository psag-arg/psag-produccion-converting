@page "/produccion/inicio-turno"
@using Microsoft.AspNetCore.Authorization
@using PSAG.Mantenimiento.Web.Models
@using PSAG.Mantenimiento.Web.Services
@attribute [Authorize]
@inject ITurnosProduccionService TurnosProduccionService
@inject ITurnoPropioService TurnoPropio
@inject IAuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Inicio de turno - PSAG Produccion</PageTitle>

@* T-798 etapa 2 (rehace ConfirmarMaquinista de T-783): después del login, el operario toma el turno en curso de
   cada línea en la que está habilitado y elige el producto (con su objetivo vigente). Si hay otro operador, se le
   avisa y tiene que confirmar el relevo. Si no hay nada que preguntar, o la API falla, sigue de largo.
   T-802: el obligado a turno (rol con ObligadoATurno) no puede seguir sin tomar un turno: no hay "seguir sin tomar",
   toma UNA línea (un solo turno abierto a la vez) y sigue; sin líneas o sin turno sólo puede cerrar sesión. El turno es
   el en curso por hora: lo declara al tomarlo.
   Turno automático: el turno de la máquina ya está abierto (lo abre el sistema a su hora): "tomar" es entrar a ese turno
   (o abrirlo si no existe). El producto es obligatorio: si el turno ya tiene uno (heredado del turno anterior o cargado) se
   sugiere y se confirma o se cambia; sin productos con objetivo en la línea, entra igual y avisa al supervisor. Si su turno
   anterior terminó y está en la tolerancia, puede ir a declarar sus detenciones o terminarlo. *@

<div class="container" style="max-width: 680px;">
    @if (cargando)
    {
        <div class="text-center py-5"><div class="spinner-border text-primary" role="status"><span class="visually-hidden">Cargando...</span></div></div>
    }
    else if (propuesta != null)
    {
        <h3 class="mt-3 mb-1"><i class="bi bi-play-circle me-2"></i>Inicio de turno</h3>
        @if (propuesta.TurnoNombre != null)
        {
            <div class="text-muted mb-3">@propuesta.TurnoNombre · @propuesta.FechaProduccion?.ToString("dd/MM/yyyy")</div>
        }

        @if (!string.IsNullOrEmpty(propuesta.Aviso))
        {
            <div class="alert alert-warning"><i class="bi bi-exclamation-triangle me-2"></i>@propuesta.Aviso</div>
        }

        @if (propuesta.MiSesionEnTolerancia is { } sesion && !sesionTerminada)
        {
            <div class="alert alert-info" data-testid="tolerancia">
                <div class="mb-2">
                    <i class="bi bi-hourglass-split me-1"></i>Tu <strong>@sesion.TurnoNombre de @sesion.LineaNombre</strong> terminó a las
                    @sesion.FinTurno.ToString("HH:mm"). Hasta las <strong>@sesion.ToleranciaHasta.ToString("HH:mm")</strong> podés declarar
                    y corregir sus detenciones (@(sesion.PendientesDeclarar == 1 ? "1 pendiente" : $"{sesion.PendientesDeclarar} pendientes")).
                </div>
                <a class="btn btn-sm btn-primary me-2" href="detenciones/pendientes"><i class="bi bi-list-check me-1"></i>Declarar mis pendientes</a>
                <button class="btn btn-sm btn-outline-secondary" disabled="@enviando" @onclick="@(async () => await TerminarTolerancia(sesion))">
                    <i class="bi bi-stop-circle me-1"></i>Terminar mi turno
                </button>
            </div>
        }

        @foreach (var o in propuesta.Lineas)
        {
            <div class="card mb-3">
                <div class="card-body">
                    <h5 class="card-title mb-2">@o.LineaNombre</h5>
                    @if (tomadas.TryGetValue(o.LineaId, out var t))
                    {
                        <div class="text-success"><i class="bi bi-check-circle me-1"></i>Tomaste el @propuesta.TurnoNombre de @o.LineaNombre.</div>
                        @if (t.Turno?.ProductoActual != null)
                        {
                            <div class="small text-muted">Producto: @t.Turno.ProductoActual.ProductoNombre@Objetivo(t.Turno.ProductoActual.MangasObjetivoTurno, t.Turno.ProductoActual.BolsonesObjetivoTurno)@(t.ProductoConfirmado ? " (confirmado)" : "")</div>
                        }
                        @if (t.Alerta != null)
                        {
                            <div class="alert alert-warning py-2 small mt-2 mb-0" data-testid="alerta-sin-objetivos"><i class="bi bi-exclamation-triangle me-1"></i>@t.Alerta</div>
                        }
                        @if (t.ReemplazadoNombre != null || t.ReemplazadoUsuarioId != null)
                        {
                            <div class="small text-muted">Relevaste a @(t.ReemplazadoNombre ?? "otro operador").</div>
                        }
                    }
                    else if (!o.PuedeTomar && o.MotivoNoPuedeTomar != null)
                    {
                        <div class="text-muted">@o.MotivoNoPuedeTomar</div>
                    }
                    else if (!o.PuedeTomar)
                    {
                        <div class="text-muted">El turno ya está cerrado. Si hay que corregirlo, avisale a tu supervisor.</div>
                    }
                    else if (o.SoyOperadorActual && (o.Productos.Count == 0 || (o.ProductoActualId != null && !o.ProductoSinConfirmar)))
                    {
                        <div class="text-success"><i class="bi bi-check-circle me-1"></i>Ya sos el operador de este turno@(o.ProductoActualNombre != null ? $" ({o.ProductoActualNombre})" : "").</div>
                    }
                    else
                    {
                        <p class="mb-2">
                            @if (o.SoyOperadorActual)
                            {
                                <span>Ya sos el operador del <strong>@propuesta.TurnoNombre</strong>. Falta @(o.ProductoSinConfirmar ? "confirmar" : "elegir") el producto.</span>
                            }
                            else
                            {
                                <span><strong>@propuesta.TurnoNombre</strong> de <strong>@o.LineaNombre</strong>@(o.SinOperador ? " (abierto sin operador)" : ""): ¿entrás?</span>
                            }
                        </p>
                        @if (!o.SoyOperadorActual && o.OperadorActualUsuarioId != null)
                        {
                            <div class="alert alert-info py-2 small">
                                Está <strong>@(o.OperadorActualNombre ?? "otro operador")</strong> desde las @o.OperadorActualDesde?.ToString("HH:mm").
                                Si lo tomás, lo relevás y el cambio queda registrado.
                            </div>
                        }
                        @if (o.Productos.Count > 0)
                        {
                            @if (o.ProductoActualId != null && o.ProductoSinConfirmar)
                            {
                                <div class="alert alert-warning py-2 small mb-2" data-testid="producto-heredado">
                                    La máquina figura con <strong>@o.ProductoActualNombre</strong> (el producto con que terminó el turno anterior,
                                    sin confirmar). Confirmalo o elegí el que corresponde.
                                </div>
                            }
                            <label class="form-label small mb-1">Producto *</label>
                            <select class="form-select mb-2" data-testid="producto-turno" value="@ProductoElegido(o)" @onchange="@(e => productos[o.LineaId] = int.TryParse(e.Value?.ToString(), out var id) ? id : null)">
                                <option value="" disabled>(elegí el producto)</option>
                                @foreach (var p in o.Productos)
                                {
                                    <option value="@p.ProductoMaestroId">@p.Nombre@Objetivo(p.MangasObjetivoTurno, p.BolsonesObjetivoTurno)</option>
                                }
                            </select>
                        }
                        else
                        {
                            <div class="alert alert-warning py-2 small mb-2" data-testid="sin-objetivos">
                                <i class="bi bi-exclamation-triangle me-1"></i>@o.LineaNombre no tiene objetivos cargados: avisale al supervisor
                                (Maestros → Parámetros línea + producto). Podés entrar igual: la máquina trabaja.
                            </div>
                        }
                        <button class="btn btn-primary" disabled="@(enviando || (o.Productos.Count > 0 && ProductoElegido(o) == string.Empty))" @onclick="@(async () => await Tomar(o))">
                            <i class="bi bi-check-lg me-1"></i>@TextoBoton(o)
                        </button>
                    }
                </div>
            </div>
        }

        @if (error != null)
        {
            <div class="alert alert-danger">@error</div>
        }

        <div class="d-flex justify-content-end gap-2 mt-2 mb-4">
            @if (propuesta.ObligadoATurno && !TieneTurno)
            {
                <span class="small text-muted align-self-center me-auto">Para empezar, tomá el turno de una de tus líneas.</span>
                <button class="btn btn-outline-secondary" @onclick="@(async () => await CerrarSesion())">
                    <i class="bi bi-box-arrow-right me-1"></i>Cerrar sesión
                </button>
            }
            else
            {
                <button class="btn btn-outline-secondary" @onclick="Seguir">
                    @(tomadas.Count > 0 || propuesta.Lineas.Count == 0 || TieneTurno ? "Continuar" : "No, seguir sin tomar")
                    <i class="bi bi-arrow-right ms-1"></i>
                </button>
            }
        </div>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "volver")]
    public string? Volver { get; set; }

    private PropuestaTurnoProduccionDto? propuesta;
    private readonly Dictionary<int, AperturaTurnoProduccionDto> tomadas = [];
    private readonly Dictionary<int, int?> productos = [];
    private bool cargando = true;
    private bool obligado;
    private bool enviando;
    private string? error;

    /// <summary>T-802: ya es el operador vigente de un turno abierto (o lo acaba de tomar).</summary>
    private bool TieneTurno => tomadas.Count > 0 || propuesta?.MiTurnoProduccionId != null;

    protected override async Task OnInitializedAsync()
    {
        propuesta = await TurnosProduccionService.GetPropuestaAsync();
        if (propuesta is not { Preguntar: true })
        {
            // El obligado a turno sin turno no sigue de largo (si la API falló, el layout lo vuelve a traer acá).
            var estado = await TurnoPropio.RefrescarAsync();
            obligado = estado.Obligado;
            if (estado.Bloqueado)
            {
                propuesta ??= new PropuestaTurnoProduccionDto { ObligadoATurno = true, Aviso = ApiErrores.SinConexion };
                cargando = false;
                return;
            }
            Seguir();
            return;
        }
        foreach (var o in propuesta.Lineas)
            productos[o.LineaId] = o.ProductoActualId ?? (o.Productos.Count == 1 ? o.Productos[0].ProductoMaestroId : null);
        cargando = false;
    }

    private bool sesionTerminada;

    /// <summary>Texto del botón: confirma el heredado, guarda el producto o entra (relevando si hay otro).</summary>
    private string TextoBoton(OpcionTurnoProduccionDto o)
    {
        var confirma = o.ProductoSinConfirmar && productos.GetValueOrDefault(o.LineaId) == o.ProductoActualId;
        if (o.SoyOperadorActual)
            return confirma ? "Confirmar producto" : "Guardar producto";
        if (o.OperadorActualUsuarioId != null)
            return confirma ? "Confirmar y relevar" : "Sí, lo relevo";
        return confirma ? "Confirmar y entrar" : "Entrar al turno";
    }

    /// <summary>Turno automático: termina la sesión en tolerancia del turno anterior.</summary>
    private async Task TerminarTolerancia(SesionToleranciaDto sesion)
    {
        enviando = true;
        error = null;
        try
        {
            var (resultado, mensaje) = await TurnosProduccionService.TerminarMiTurnoAsync(sesion.TurnoProduccionId);
            if (resultado == null)
            {
                error = mensaje;
                return;
            }
            sesionTerminada = true;
            await TurnoPropio.RefrescarAsync();
        }
        catch (Exception)
        {
            error = ApiErrores.SinConexion;
        }
        finally
        {
            enviando = false;
        }
    }

    private string ProductoElegido(OpcionTurnoProduccionDto o) =>
        productos.TryGetValue(o.LineaId, out var id) && id != null ? id.Value.ToString() : string.Empty;

    private static string Objetivo(int? mangas, int? bolsones) =>
        mangas == null && bolsones == null
            ? " · sin objetivo"
            : " · objetivo " + string.Join(" / ", new[]
            {
                mangas is { } m ? $"{m:N0} mangas" : null,
                bolsones is { } b ? $"{b:N0} bolsones" : null
            }.Where(x => x != null));

    private async Task Tomar(OpcionTurnoProduccionDto opcion)
    {
        enviando = true;
        error = null;
        try
        {
            var request = new AbrirTurnoProduccionRequest
            {
                LineaId = opcion.LineaId,
                ProductoMaestroId = productos.GetValueOrDefault(opcion.LineaId),
                // El aviso del relevo ya se mostró en la tarjeta: tocar el botón es la confirmación.
                Relevar = opcion.OperadorActualUsuarioId != null && !opcion.SoyOperadorActual
            };
            var (resultado, mensaje) = await TurnosProduccionService.AbrirAsync(request);
            if (resultado == null)
            {
                error = mensaje;
                return;
            }
            if (resultado.RequiereConfirmarRelevo)
            {
                // Entró otro operador mientras tanto: se recarga para mostrar el aviso de relevo.
                error = "Mientras tanto tomó el turno otro operador. Revisá el aviso y confirmá el relevo.";
                propuesta = await TurnosProduccionService.GetPropuestaAsync() ?? propuesta;
                return;
            }
            tomadas[opcion.LineaId] = resultado;
            await TurnoPropio.RefrescarAsync();
            // El obligado a turno toma una sola línea (un turno abierto a la vez) y sigue.
            // Con aviso (línea sin objetivos) se queda para que lo lea.
            if (resultado.Alerta == null && (propuesta!.ObligadoATurno || (propuesta.Lineas.Count == 1 && resultado.ReemplazadoUsuarioId == null)))
                Seguir();
        }
        catch (Exception)
        {
            error = ApiErrores.SinConexion;
        }
        finally
        {
            enviando = false;
        }
    }

    // T-770: el obligado a turno cae en el tablero (su pantalla central de trabajo).
    private void Seguir() => Navigation.NavigateTo(RutasLogin.DestinoTrasTurno(Volver, propuesta?.ObligadoATurno == true || obligado));

    private async Task CerrarSesion()
    {
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("/login", true);
    }
}
