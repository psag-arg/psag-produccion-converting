@page "/login"
@using PSAG.Mantenimiento.Web.Services
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject PSAG.Mantenimiento.Web.Services.IPermisosService PermisosService

<div class="login-container">
    <div class="login-card">
        <h3>PSAG Produccion</h3>
        <h4>Iniciar sesión</h4>

        @if (Vencida == "1" && string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-warning">@ApiErrores.SesionVencida</div>
        }

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger">@errorMessage</div>
        }

        <EditForm Model="@loginModel" OnValidSubmit="HandleLogin">
            <DataAnnotationsValidator />

            <div class="form-group mb-3">
                <label for="username">Usuario</label>
                <InputText id="username" class="form-control" @bind-Value="loginModel.UserName" placeholder="Tu usuario" />
            </div>

            <div class="form-group mb-3">
                <label for="password">Contraseña</label>
                <InputText id="password" type="password" class="form-control" @bind-Value="loginModel.Password" placeholder="Tu contraseña" />
            </div>

            <button type="submit" class="btn btn-primary w-100" disabled="@isLoading">
                @if (isLoading)
                {
                    <span class="spinner-border spinner-border-sm me-2"></span>
                    <span>Ingresando...</span>
                }
                else
                {
                    <span>Ingresar</span>
                }
            </button>
        </EditForm>

        <p class="mt-4 mb-0 text-muted small">
            ¿No podés entrar? Pedile a tu supervisor o al administrador que revise tu usuario.
        </p>
    </div>
</div>

<style>
    .login-container {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        display: flex;
        justify-content: center;
        align-items: center;
        background: var(--psag-fondo-realce), var(--psag-fondo);
        z-index: 1000;
    }

    /* T-806: colores y formas con los tokens de css/tema.css; la franja de arriba lleva el degradé del tema */
    .login-card {
        position: relative;
        overflow: hidden;
        background: var(--psag-card-degrade), var(--psag-card);
        color: var(--bs-body-color);
        border: 1px solid var(--psag-borde);
        padding: 2.5rem 2rem 2rem;
        border-radius: var(--psag-radio-card);
        box-shadow: var(--psag-sombra-card);
        width: 100%;
        max-width: 400px;
    }

    .login-card::before {
        content: "";
        position: absolute;
        inset: 0 0 auto 0;
        height: 8px;
        background: var(--psag-encabezado);
    }

    .login-card h3 {
        text-align: center;
        color: var(--bs-emphasis-color);
        font-weight: 700;
        margin-bottom: 0.5rem;
    }

    .login-card h4 {
        text-align: center;
        color: var(--bs-secondary-color);
        margin-bottom: 1.5rem;
        font-weight: normal;
    }
</style>

@code {
    [SupplyParameterFromQuery(Name = "vencida")]
    public string? Vencida { get; set; }

    [SupplyParameterFromQuery(Name = "volver")]
    public string? Volver { get; set; }

    private LoginModel loginModel = new();
    private string? errorMessage;
    private bool isLoading;

    private async Task HandleLogin()
    {
        errorMessage = null;
        if (string.IsNullOrWhiteSpace(loginModel.UserName) || string.IsNullOrWhiteSpace(loginModel.Password))
        {
            errorMessage = "Completá usuario y contraseña.";
            return;
        }

        isLoading = true;
        try
        {
            var result = await AuthService.LoginAsync(loginModel.UserName, loginModel.Password);

            if (result.Success)
            {
                // T-798 etapa 2: el operario pasa por "Inicio de turno" (toma el turno de sus líneas y elige el producto).
                // Si no hay nada que preguntar o la API falla, esa pantalla sigue de largo al destino.
                // T-802: también el obligado a turno (rol con ObligadoATurno), que no puede seguir sin tomar uno.
                var destino = RutasLogin.DestinoSeguro(Volver);
                var obligado = false;
                try { obligado = (await PermisosService.RefrescarAsync()).ObligadoATurno; } catch { /* lo resuelve el layout */ }
                Navigation.NavigateTo(result.Roles?.Contains("OPERARIO") == true || obligado
                    ? $"/produccion/inicio-turno?volver={Uri.EscapeDataString(destino)}"
                    : destino);
            }
            else
            {
                errorMessage = result.Error ?? "Usuario o contraseña incorrectos.";
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error en login: {ex.Message}");
            errorMessage = ApiErrores.SinConexion;
        }
        finally
        {
            isLoading = false;
        }
    }

    private class LoginModel
    {
        public string UserName { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }
}
