@page "/inspecciones/hallazgos"
@using Microsoft.AspNetCore.Authorization
@using PSAG.Mantenimiento.Web.Models
@using PSAG.Mantenimiento.Web.Services
@attribute [Authorize]
@inject IInspeccionService InspeccionService
@inject ICatalogosService CatalogosService

<PageTitle>Panel NO OK - PSAG Produccion</PageTitle>

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2><i class="bi bi-exclamation-triangle text-warning me-2"></i>Panel de Hallazgos NO OK</h2>
            <p class="text-muted mb-0">Seguimiento y resolucion de items con resultado NO OK</p>
        </div>
        <a href="/inspecciones" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Volver a Inspecciones
        </a>
    </div>

    <!-- Filtros -->
    <div class="card mb-4">
        <div class="card-body">
            <div class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label">Linea</label>
                    <select class="form-select" @bind="filtroLineaId" @bind:after="@(async () => await CargarHallazgos())">
                        <option value="0">-- Todas --</option>
                        @foreach (var linea in lineas)
                        {
                            <option value="@linea.LineaId">@linea.Nombre</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Estado</label>
                    <select class="form-select" @bind="filtroSoloPendientes" @bind:after="@(async () => await CargarHallazgos())">
                        <option value="true">Solo Pendientes</option>
                        <option value="false">Todos</option>
                    </select>
                </div>
            </div>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
        </div>
    }
    else
    {
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger alert-dismissible">
                @errorMessage
                <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
            </div>
        }

        @if (!string.IsNullOrEmpty(successMessage))
        {
            <div class="alert alert-success alert-dismissible">
                @successMessage
                <button type="button" class="btn-close" @onclick="() => successMessage = null"></button>
            </div>
        }

        <!-- Resumen -->
        <div class="row mb-4">
            <div class="col-md-4">
                <div class="card border-warning">
                    <div class="card-body text-center">
                        <h3 class="mb-0 text-warning">@hallazgos.Items.Count(h => !h.Resuelto)</h3>
                        <small class="text-muted">Pendientes de Resolver</small>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-danger">
                    <div class="card-body text-center">
                        <h3 class="mb-0 text-danger">@hallazgos.Items.Count(h => !h.Resuelto && h.RequiereAccionCorrectiva)</h3>
                        <small class="text-muted">Requieren Accion Correctiva</small>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-success">
                    <div class="card-body text-center">
                        <h3 class="mb-0 text-success">@hallazgos.Items.Count(h => h.Resuelto)</h3>
                        <small class="text-muted">Resueltos</small>
                    </div>
                </div>
            </div>
        </div>

        <!-- Lista de hallazgos -->
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">Hallazgos (@hallazgos.TotalCount)</h5>
            </div>
            <div class="card-body p-0">
                @if (hallazgos.Items.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Fecha</th>
                                    <th>Linea</th>
                                    <th>Plan</th>
                                    <th>Item</th>
                                    <th>Descripcion</th>
                                    <th>Estado</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var hallazgo in hallazgos.Items)
                                {
                                    <tr class="@(hallazgo.Resuelto ? "" : "table-warning")">
                                        <td>
                                            <small>@hallazgo.FechaHoraHallazgo.ToString("dd/MM/yyyy HH:mm")</small>
                                        </td>
                                        <td>
                                            <strong>@hallazgo.LineaNombre</strong>
                                            @if (hallazgo.EquipoNombre != null)
                                            {
                                                <br /><small class="text-muted">@hallazgo.EquipoNombre</small>
                                            }
                                        </td>
                                        <td><small>@hallazgo.PlanNombre</small></td>
                                        <td><small>@hallazgo.ItemDescripcion</small></td>
                                        <td>
                                            @hallazgo.Descripcion
                                            @if (hallazgo.RequiereAccionCorrectiva)
                                            {
                                                <br /><span class="badge bg-danger mt-1">Requiere Accion Correctiva</span>
                                            }
                                        </td>
                                        <td>
                                            @if (hallazgo.Resuelto)
                                            {
                                                <span class="badge bg-success">Resuelto</span>
                                                <br /><small class="text-muted">@hallazgo.FechaHoraResolucion?.ToString("dd/MM/yyyy")</small>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning text-dark">Pendiente</span>
                                            }
                                        </td>
                                        <td>
                                            @if (!hallazgo.Resuelto)
                                            {
                                                <button class="btn btn-sm btn-success" @onclick="() => AbrirModalResolucion(hallazgo)">
                                                    <i class="bi bi-check-circle"></i> Resolver
                                                </button>
                                            }
                                            else
                                            {
                                                <button class="btn btn-sm btn-outline-info" @onclick="() => VerDetalles(hallazgo)">
                                                    <i class="bi bi-eye"></i> Ver
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Paginacion -->
                    @if (hallazgos.TotalPages > 1)
                    {
                        <div class="card-footer">
                            <nav>
                                <ul class="pagination pagination-sm justify-content-center mb-0">
                                    <li class="page-item @(hallazgos.Page <= 1 ? "disabled" : "")">
                                        <button class="page-link" @onclick="() => CambiarPagina(hallazgos.Page - 1)">Anterior</button>
                                    </li>
                                    @for (int i = 1; i <= hallazgos.TotalPages; i++)
                                    {
                                        var pageNum = i;
                                        <li class="page-item @(hallazgos.Page == pageNum ? "active" : "")">
                                            <button class="page-link" @onclick="() => CambiarPagina(pageNum)">@pageNum</button>
                                        </li>
                                    }
                                    <li class="page-item @(hallazgos.Page >= hallazgos.TotalPages ? "disabled" : "")">
                                        <button class="page-link" @onclick="() => CambiarPagina(hallazgos.Page + 1)">Siguiente</button>
                                    </li>
                                </ul>
                            </nav>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center py-5">
                        <i class="bi bi-check-circle text-success" style="font-size: 3rem;"></i>
                        <p class="text-muted mt-3">No hay hallazgos pendientes. Excelente trabajo!</p>
                    </div>
                }
            </div>
        </div>
    }
</div>

<!-- Modal Resolucion -->
@if (hallazgoSeleccionado != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        @(modoVisualizacion ? "Detalles del Hallazgo" : "Resolver Hallazgo")
                    </h5>
                    <button type="button" class="btn-close" @onclick="CerrarModal"></button>
                </div>
                <div class="modal-body">
                    <!-- Informacion del hallazgo -->
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label text-muted">Linea / Equipo</label>
                            <p class="mb-0">
                                <strong>@hallazgoSeleccionado.LineaNombre</strong>
                                @if (hallazgoSeleccionado.EquipoNombre != null)
                                {
                                    <text> - @hallazgoSeleccionado.EquipoNombre</text>
                                }
                            </p>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-muted">Fecha Hallazgo</label>
                            <p class="mb-0">@hallazgoSeleccionado.FechaHoraHallazgo.ToString("dd/MM/yyyy HH:mm")</p>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label text-muted">Plan de Inspeccion</label>
                            <p class="mb-0">@hallazgoSeleccionado.PlanNombre</p>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-muted">Item Inspeccionado</label>
                            <p class="mb-0">@hallazgoSeleccionado.ItemDescripcion</p>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-muted">Descripcion del Hallazgo</label>
                        <div class="alert alert-warning mb-0">
                            @hallazgoSeleccionado.Descripcion
                        </div>
                    </div>

                    <hr />

                    @if (modoVisualizacion)
                    {
                        <!-- Modo visualizacion (resuelto) -->
                        <div class="mb-3">
                            <label class="form-label text-muted">Observacion de Resolucion</label>
                            <p class="mb-0">@(hallazgoSeleccionado.ObservacionResolucion ?? "-")</p>
                        </div>
                        @if (hallazgoSeleccionado.RequiereAccionCorrectiva)
                        {
                            <div class="mb-3">
                                <label class="form-label text-muted">Accion Correctiva</label>
                                <p class="mb-0">@(hallazgoSeleccionado.AccionCorrectivaDescripcion ?? "-")</p>
                            </div>
                        }
                        <div class="mb-3">
                            <label class="form-label text-muted">Fecha Resolucion</label>
                            <p class="mb-0">@hallazgoSeleccionado.FechaHoraResolucion?.ToString("dd/MM/yyyy HH:mm")</p>
                        </div>
                    }
                    else
                    {
                        <!-- Modo edicion (resolver) -->
                        <div class="mb-3">
                            <label class="form-label">Observacion de Resolucion <span class="text-danger">*</span></label>
                            <textarea class="form-control" rows="3" @bind="observacionResolucion"
                                      placeholder="Describa como se resolvio el hallazgo..."></textarea>
                        </div>
                        <div class="mb-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="chkAccionCorrectiva"
                                       @bind="requiereAccionCorrectiva" />
                                <label class="form-check-label" for="chkAccionCorrectiva">
                                    Requiere Accion Correctiva
                                </label>
                            </div>
                        </div>
                        @if (requiereAccionCorrectiva)
                        {
                            <div class="mb-3">
                                <label class="form-label">Descripcion de la Accion Correctiva <span class="text-danger">*</span></label>
                                <textarea class="form-control" rows="2" @bind="accionCorrectivaDescripcion"
                                          placeholder="Describa la accion correctiva a tomar..."></textarea>
                            </div>
                        }
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CerrarModal">
                        @(modoVisualizacion ? "Cerrar" : "Cancelar")
                    </button>
                    @if (!modoVisualizacion)
                    {
                        <button type="button" class="btn btn-success" @onclick="ResolverHallazgo" disabled="@isResolviendo">
                            @if (isResolviendo)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            <i class="bi bi-check-circle me-1"></i> Marcar como Resuelto
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<LineaDto> lineas = new();
    private PagedResult<HallazgoNoOkDto> hallazgos = new();
    private int filtroLineaId;
    private bool filtroSoloPendientes = true;
    private bool isLoading = true;
    private string? errorMessage;
    private string? successMessage;

    // Modal
    private HallazgoNoOkDto? hallazgoSeleccionado;
    private bool modoVisualizacion;
    private bool isResolviendo;
    private string observacionResolucion = string.Empty;
    private bool requiereAccionCorrectiva;
    private string accionCorrectivaDescripcion = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            lineas = await CatalogosService.GetLineasAsync();
        }
        catch { }

        await CargarHallazgos();
    }

    private async Task CargarHallazgos(int page = 1)
    {
        isLoading = true;
        try
        {
            hallazgos = await InspeccionService.GetHallazgosAsync(
                page: page,
                pageSize: 10,
                lineaId: filtroLineaId > 0 ? filtroLineaId : null,
                soloPendientes: filtroSoloPendientes);
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al cargar hallazgos: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task CambiarPagina(int page)
    {
        await CargarHallazgos(page);
    }

    private void AbrirModalResolucion(HallazgoNoOkDto hallazgo)
    {
        hallazgoSeleccionado = hallazgo;
        modoVisualizacion = false;
        observacionResolucion = string.Empty;
        requiereAccionCorrectiva = false;
        accionCorrectivaDescripcion = string.Empty;
    }

    private void VerDetalles(HallazgoNoOkDto hallazgo)
    {
        hallazgoSeleccionado = hallazgo;
        modoVisualizacion = true;
    }

    private void CerrarModal()
    {
        hallazgoSeleccionado = null;
    }

    private async Task ResolverHallazgo()
    {
        if (hallazgoSeleccionado == null) return;

        if (string.IsNullOrWhiteSpace(observacionResolucion))
        {
            errorMessage = "La observacion de resolucion es obligatoria.";
            return;
        }

        if (requiereAccionCorrectiva && string.IsNullOrWhiteSpace(accionCorrectivaDescripcion))
        {
            errorMessage = "Debe describir la accion correctiva.";
            return;
        }

        isResolviendo = true;
        errorMessage = null;

        try
        {
            var request = new ResolverHallazgoRequest
            {
                HallazgoNoOkId = hallazgoSeleccionado.HallazgoNoOkId,
                ObservacionResolucion = observacionResolucion,
                RequiereAccionCorrectiva = requiereAccionCorrectiva,
                AccionCorrectivaDescripcion = requiereAccionCorrectiva ? accionCorrectivaDescripcion : null
            };

            var (success, error) = await InspeccionService.ResolverHallazgoAsync(
                hallazgoSeleccionado.HallazgoNoOkId, request);

            if (success)
            {
                successMessage = "Hallazgo resuelto exitosamente.";
                CerrarModal();
                await CargarHallazgos();
            }
            else
            {
                errorMessage = error ?? "Error al resolver hallazgo.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isResolviendo = false;
        }
    }
}
