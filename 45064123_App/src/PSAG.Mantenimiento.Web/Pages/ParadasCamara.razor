@page "/paradas-camara"
@using Microsoft.AspNetCore.Authorization
@using PSAG.Mantenimiento.Web.Models
@using PSAG.Mantenimiento.Web.Services
@attribute [Authorize]
@inject IConteoCamaraService ConteoCamaraService
@inject ICatalogosService CatalogosService
@inject ICalidadService CalidadService

<PageTitle>Paradas por cámara - PSAG Produccion</PageTitle>

<div class="container-fluid">
    <div class="mb-4">
        <h2 class="mb-0">Paradas y producción según la cámara</h2>
        <small class="text-muted">
            Todas las paradas que detectan las cámaras (también los microcortes) y si tienen una detención cargada.
            La cámara 09 (cortadora) solo informa. La cámara 10 (rebobinadora) crea sola la detención cuando la parada
            llega al umbral de Maestros → Calidad (5 min por defecto) y queda pendiente de declaración.
        </small>
    </div>

    <div class="card mb-3">
        <div class="card-body">
            <div class="row g-2 align-items-end">
                <div class="col-6 col-md-2">
                    <label class="form-label">Desde</label>
                    <input type="date" class="form-control" @bind="desde" @bind:after="@(async () => await Buscar())" />
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label">Hasta</label>
                    <input type="date" class="form-control" @bind="hasta" @bind:after="@(async () => await Buscar())" />
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label">Línea</label>
                    <select class="form-select" @bind="lineaId" @bind:after="@(async () => await Buscar())">
                        <option value="">Todas</option>
                        @foreach (var linea in lineas)
                        {
                            <option value="@linea.LineaId">@linea.Nombre</option>
                        }
                    </select>
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label">Cámara</label>
                    <select class="form-select" @bind="puntoId" @bind:after="@(async () => await Buscar())" data-testid="filtro-camara">
                        <option value="">Todas</option>
                        @foreach (var c in camaras)
                        {
                            <option value="@c.PuntoControlCalidadId">@c.Codigo</option>
                        }
                    </select>
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label">Duración mínima</label>
                    <select class="form-select" @bind="segundosMinimos" @bind:after="@(async () => await Buscar())">
                        <option value="0">Todas</option>
                        <option value="60">1 min o más</option>
                        <option value="180">3 min o más</option>
                        <option value="600">10 min o más</option>
                    </select>
                </div>
                <div class="col-12 col-md-2">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="soloSin" @bind="soloSinDetencion" @bind:after="@(async () => await Buscar())" />
                        <label class="form-check-label" for="soloSin">Solo las que no tienen detención cargada</label>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (error != null)
    {
        <div class="alert alert-danger">@error</div>
    }

    @foreach (var a in alertas)
    {
        <div class="alert @(a.Activa ? "alert-danger" : "alert-secondary") py-2" data-testid="alerta-camara">
            <i class="bi bi-camera-video-off me-1"></i>
            <strong>@a.TipoDescripcion</strong> · @a.PuntoControlCodigo (@a.LineaNombre) desde @a.FechaHoraInicio.ToString("dd/MM HH:mm:ss")&nbsp;
            @if (a.FechaHoraFin is { } fin)
            {
                <span>hasta @fin.ToString("HH:mm:ss") (resuelta).</span>
            }
            else
            {
                <span>· sigue activa: no se detectan paradas de esa cámara mientras dure.</span>
            }
        </div>
    }

    @if (isLoading)
    {
        <div class="text-center py-5"><div class="spinner-border text-primary" role="status"><span class="visually-hidden">Cargando...</span></div></div>
    }
    else
    {
        <div class="row g-3 mb-3">
            <div class="col-6 col-md-3">
                <div class="card"><div class="card-body">
                    <div class="text-muted small">Paradas en la lista</div>
                    <div class="fs-3 fw-semibold">@resultado.Total</div>
                </div></div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card"><div class="card-body">
                    <div class="text-muted small">Sin detención cargada</div>
                    <div class="fs-3 fw-semibold @(resultado.SinDetencion > 0 ? "text-danger" : "")">@resultado.SinDetencion</div>
                    <div class="small text-muted">@resultado.MinutosSinDetencion min en total</div>
                </div></div>
            </div>
        </div>

        @if (resultado.Items.Count == 0)
        {
            <div class="alert alert-info">No hay paradas detectadas con estos filtros.</div>
        }
        else
        {
            <div class="card mb-4">
                <div class="table-responsive">
                    <table class="table table-hover mb-0 align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Inicio</th>
                                <th>Fin</th>
                                <th class="text-end">Duración</th>
                                <th>Línea</th>
                                <th>Turno</th>
                                <th>Tipo</th>
                                <th>Cámara</th>
                                <th>Carriles</th>
                                <th>Detención</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in resultado.Items)
                            {
                                <tr>
                                    <td>
                                        @p.FechaHoraInicio.ToString("dd/MM HH:mm:ss")
                                        @if (p.InicioIncierto)
                                        {
                                            <span class="badge text-bg-light" title="El servicio arrancó con la línea ya parada: pudo empezar antes">aprox.</span>
                                        }
                                    </td>
                                    <td>
                                        @p.FechaHoraFin.ToString("HH:mm:ss")
                                        @if (p.FinIncierto)
                                        {
                                            <span class="badge text-bg-light" title="Se cortó el video antes del arranque: pudo seguir después">aprox.</span>
                                        }
                                    </td>
                                    <td class="text-end">@Duracion(p.DuracionSegundos)</td>
                                    <td>@p.LineaNombre</td>
                                    <td>@p.TurnoNombre</td>
                                    <td>@TipoTexto(p.Tipo)</td>
                                    <td class="font-monospace small">@p.PuntoControlCodigo</td>
                                    <td>@p.Carriles</td>
                                    <td>
                                        @switch (p.Cruce)
                                        {
                                            case "CON_DETENCION":
                                                <span class="badge text-bg-success">Cargada</span>
                                                <span class="small ms-1">@string.Join(", ", p.CodigosDetencion)</span>
                                                break;
                                            case "POSIBLE":
                                                <span class="badge text-bg-warning" title="Hay una detención del mismo día y turno sin horario: puede ser esta">Posible</span>
                                                <span class="small ms-1">@string.Join(", ", p.CodigosDetencion)</span>
                                                break;
                                            default:
                                                <span class="badge text-bg-danger">Sin detención</span>
                                                break;
                                        }
                                        @if (p.SuperaUmbral)
                                        {
                                            <span class="badge bg-info-subtle text-info-emphasis ms-1" title="Llegó al umbral: la cámara crea la detención automática">Automática</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        <h5 class="mt-4">Producción del @hasta.ToString("dd/MM/yyyy") según la cámara</h5>
        <small class="text-muted d-block mb-2">
            @if (produccion.Fin > produccion.Inicio)
            {
                <text>Día de planta: de @produccion.Inicio.ToString("dd/MM HH:mm") a @produccion.Fin.ToString("dd/MM HH:mm") (el turno noche es del día en que empieza, como en la eficiencia).</text>
            }
            Cámara 09: rollos estimados por la frecuencia de paso en cada carril. Cámara 10: mangas contadas al cruzar la mesa.
            Cada cámara va por separado: rollos y mangas no se suman. Validar contra el contador de la máquina antes de usarlo como dato oficial.
        </small>
        @if (produccion.Camaras.Count == 0)
        {
            <div class="alert alert-info">Sin datos de la cámara para ese día.</div>
        }
        @foreach (var cam in produccion.Camaras)
        {
            var esMangas = cam.Unidad == "mangas";
            <h6 class="mt-3" data-testid="produccion-camara">
                <span class="font-monospace">@cam.Codigo</span> @cam.Nombre
                @if (!string.IsNullOrEmpty(cam.LineaNombre)) { <span class="text-muted">· @cam.LineaNombre</span> }
                <span class="text-muted">· @cam.Total.ToString("N0") @cam.Unidad</span>
            </h6>
            @if (cam.Turnos.Count > 0)
            {
                <div class="d-flex flex-wrap gap-2 mb-2" data-testid="totales-turno">
                    @foreach (var t in cam.Turnos)
                    {
                        <div class="border rounded px-3 py-2">
                            <div class="small text-muted">@t.TurnoNombre @(t.Inicio is { } i && t.Fin is { } f ? $"({i:dd/MM HH:mm} a {f:HH:mm})" : "")</div>
                            <div class="fw-semibold">@t.Total.ToString("N0") @cam.Unidad</div>
                            <div class="small text-muted">@t.MinutosMarcha de @t.MinutosConDatos min en marcha</div>
                        </div>
                    }
                </div>
            }
            <div class="card mb-3">
                <div class="table-responsive">
                    <table class="table table-sm mb-0 align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Hora</th>
                                @foreach (var c in cam.Carriles)
                                {
                                    <th class="text-end">@(esMangas ? "Mangas" : $"Carril {c}")</th>
                                }
                                <th class="text-end">Total</th>
                                <th class="text-end" title="Minutos-carril en marcha sobre minutos-carril con video">En marcha</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var h in cam.Horas)
                            {
                                <tr>
                                    <td>@h.Hora.ToString("dd/MM HH:mm")</td>
                                    @foreach (var c in cam.Carriles)
                                    {
                                        <td class="text-end">@(h.RollosPorCarril.TryGetValue(c, out var r) ? r.ToString("N0") : "-")</td>
                                    }
                                    <td class="text-end fw-semibold">@h.TotalRollos.ToString("N0")</td>
                                    <td class="text-end">@(h.MinutosCarrilConDatos > 0 ? (100.0 * h.MinutosCarrilMarcha / h.MinutosCarrilConDatos).ToString("0") + " %" : "-")</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr class="fw-semibold">
                                <td>Día</td>
                                @foreach (var c in cam.Carriles)
                                {
                                    <td class="text-end">@cam.Horas.Sum(h => h.RollosPorCarril.GetValueOrDefault(c)).ToString("N0")</td>
                                }
                                <td class="text-end">@cam.Total.ToString("N0")</td>
                                <td></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        }
    }
</div>

@code {
    private DateTime desde = DateTime.Today.AddDays(-7);
    private DateTime hasta = DateTime.Today;
    private int? lineaId;
    private int? puntoId;
    private List<PuntoControlCalidadDto> camaras = [];
    private List<AlertaCamaraDto> alertas = [];
    private int segundosMinimos = 60;
    private bool soloSinDetencion = true;
    private bool isLoading = true;
    private string? error;
    private List<LineaDto> lineas = [];
    private ParadasCamaraResultado resultado = new();
    private ProduccionCamaraDto produccion = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            lineas = await CatalogosService.GetLineasAsync();
            camaras = await CalidadService.GetPuntosControlAsync(incluirInactivos: false);
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        await Buscar();
    }

    private async Task Buscar()
    {
        isLoading = true;
        error = null;
        try
        {
            var d = DateOnly.FromDateTime(desde);
            var h = DateOnly.FromDateTime(hasta);
            var paradas = ConteoCamaraService.GetParadasAsync(d, h, lineaId, soloSinDetencion, segundosMinimos, puntoId);
            var prod = ConteoCamaraService.GetProduccionAsync(h, lineaId, puntoId);
            var al = ConteoCamaraService.GetAlertasAsync(lineaId, horas: 24);
            resultado = await paradas;
            produccion = await prod;
            alertas = await al;
        }
        catch (Exception ex)
        {
            error = ex.Message;
            resultado = new();
            produccion = new();
        }
        finally
        {
            isLoading = false;
        }
    }

    private static string TipoTexto(string tipo) => tipo switch
    {
        "PARADA" => "Parada",
        "SIN_MANGAS" => "Sin mangas",
        _ => "Acumulación"
    };

    private static string Duracion(int segundos) =>
        segundos >= 3600 ? $"{segundos / 3600} h {segundos % 3600 / 60} min"
        : segundos >= 60 ? $"{segundos / 60} min {segundos % 60} s"
        : $"{segundos} s";
}
