@page "/configuracion/maquinistas"
@using Microsoft.AspNetCore.Authorization
@using PSAG.Mantenimiento.Web.Models
@using PSAG.Mantenimiento.Web.Services
@attribute [Authorize]
@inject ICatalogosService CatalogosService

<PageTitle>Maquinistas - PSAG Produccion</PageTitle>

@* T-802: sólo consulta. Las líneas habilitadas de cada usuario se cargan en el alta / edición del usuario
   (Configuración → Usuarios) y ya no hay turno habitual: el turno lo declara el operario al abrirlo. *@

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <h3 class="mb-0">Maquinistas <small class="text-muted fs-6">(consulta)</small></h3>
        <div style="width: 250px;">
            <AutocompleteSelect TItem="LineaDto"
                                TValue="int"
                                Items="lineas"
                                @bind-SelectedValue="filtroLineaId"
                                ValueSelector="@(l => l.LineaId)"
                                TextSelector="@(l => l.Nombre)"
                                Placeholder="Filtrar por línea...">
                <ItemTemplate Context="linea">
                    @linea.Nombre
                </ItemTemplate>
            </AutocompleteSelect>
        </div>
    </div>

    <div class="alert alert-info py-2 small">
        <i class="bi bi-info-circle me-1"></i>
        Quién está habilitado en cada línea. Para habilitar o quitar líneas, editá el usuario en
        <a href="configuracion/usuarios">Configuración → Usuarios</a>. El turno no se asigna: lo declara el operario al abrirlo.
    </div>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-body p-0 table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Usuario</th>
                            <th>Línea habilitada</th>
                            <th>Desde</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (maquinistasFiltrados.Any())
                        {
                            @foreach (var maq in maquinistasFiltrados)
                            {
                                <tr>
                                    <td>
                                        <strong>@maq.NombreUsuario</strong>
                                        <br /><small class="text-muted">@maq.EmailUsuario</small>
                                    </td>
                                    <td><span class="badge bg-info">@maq.LineaNombre</span></td>
                                    <td>@maq.FechaAsignacion.ToString("dd/MM/yyyy")</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="3" class="text-center text-muted py-4">No hay usuarios habilitados en líneas</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private List<LineaDto> lineas = new();
    private List<MaquinistaDto> maquinistas = new();
    private int filtroLineaId;
    private bool isLoading = true;

    private IEnumerable<MaquinistaDto> maquinistasFiltrados => filtroLineaId > 0
        ? maquinistas.Where(m => m.LineaId == filtroLineaId)
        : maquinistas;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var cargaLineas = CatalogosService.GetLineasAsync();
            var cargaMaquinistas = CatalogosService.GetMaquinistasAsync();
            lineas = await cargaLineas;
            maquinistas = await cargaMaquinistas;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error cargando maquinistas: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }
}
