@page "/configuracion/maquinistas"
@using Microsoft.AspNetCore.Authorization
@using PSAG.Mantenimiento.Web.Models
@using PSAG.Mantenimiento.Web.Services
@attribute [Authorize(Roles = "ADMINISTRADOR")]
@inject ICatalogosService CatalogosService
@inject IUsuariosService UsuariosService
@inject IJSRuntime JS

<PageTitle>Maquinistas - PSAG Produccion</PageTitle>

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3>Maquinistas</h3>
        <div class="d-flex gap-2 align-items-center">
            <div style="width: 250px;">
                <AutocompleteSelect TItem="LineaDto"
                                    TValue="int"
                                    Items="lineas"
                                    @bind-SelectedValue="filtroLineaId"
                                    OnValueChanged="@(async () => await CargarMaquinistas())"
                                    ValueSelector="@(l => l.LineaId)"
                                    TextSelector="@(l => l.Nombre)"
                                    Placeholder="Filtrar por línea...">
                    <ItemTemplate Context="linea">
                        @linea.Nombre
                    </ItemTemplate>
                </AutocompleteSelect>
            </div>
            <button class="btn btn-primary" @onclick="NuevoMaquinista">
                <i class="bi bi-plus-circle me-2"></i>Nuevo Maquinista
            </button>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>Usuario</th>
                            <th>Línea</th>
                            <th>Turno</th>
                            <th>Fecha de asignación</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (maquinistasFiltrados.Any())
                        {
                            @foreach (var maq in maquinistasFiltrados)
                            {
                                <tr>
                                    <td>@maq.UsuarioLineaId</td>
                                    <td>
                                        <strong>@maq.NombreUsuario</strong>
                                        <br /><small class="text-muted">@maq.EmailUsuario</small>
                                    </td>
                                    <td><span class="badge bg-info">@maq.LineaNombre</span></td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(maq.TurnoNombre))
                                        {
                                            <span class="badge bg-primary">@maq.TurnoNombre</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">Sin turno</span>
                                        }
                                    </td>
                                    <td>@maq.FechaAsignacion.ToString("dd/MM/yyyy")</td>
                                    <td class="text-end">
                                        <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => EditarMaquinista(maq)">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmarEliminar(maq)">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-4">No hay maquinistas registrados</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@* Modal para crear/editar *@
@if (showModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(editando ? "Editar" : "Nuevo") Maquinista</h5>
                    <button type="button" class="btn-close" @onclick="CerrarModal"></button>
                </div>
                <div class="modal-body">
                    @if (!editando)
                    {
                        <div class="mb-3">
                            <label class="form-label">Usuario *</label>
                            <AutocompleteSelect TItem="UsuarioDto"
                                                TValue="string"
                                                Items="usuarios"
                                                @bind-SelectedValue="maquinistaActual.UsuarioId"
                                                ValueSelector="@(u => u.Id)"
                                                TextSelector="@(u => $"{u.NombreCompleto} ({u.UserName})")"
                                                Placeholder="Buscar usuario...">
                                <ItemTemplate Context="usuario">
                                    <div>
                                        <strong>@usuario.NombreCompleto</strong>
                                        <br /><small class="text-muted">@usuario.UserName - @usuario.Email</small>
                                    </div>
                                </ItemTemplate>
                            </AutocompleteSelect>
                        </div>
                    }
                    else
                    {
                        <div class="mb-3">
                            <label class="form-label">Usuario</label>
                            <input type="text" class="form-control" value="@maquinistaActual.NombreUsuario" disabled />
                        </div>
                    }
                    <div class="mb-3">
                        <label class="form-label">Línea *</label>
                        <AutocompleteSelect TItem="LineaDto"
                                            TValue="int"
                                            Items="lineas"
                                            @bind-SelectedValue="maquinistaActual.LineaId"
                                            ValueSelector="@(l => l.LineaId)"
                                            TextSelector="@(l => l.Nombre)"
                                            Placeholder="Buscar línea...">
                            <ItemTemplate Context="linea">
                                @linea.Nombre
                            </ItemTemplate>
                        </AutocompleteSelect>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Turno</label>
                        <AutocompleteSelect TItem="TurnoDto"
                                            TValue="int?"
                                            Items="turnos"
                                            @bind-SelectedValue="maquinistaActual.TurnoId"
                                            ValueSelector="@(t => (int?)t.TurnoId)"
                                            TextSelector="@(t => t.Nombre)"
                                            Placeholder="Seleccionar turno...">
                            <ItemTemplate Context="turno">
                                @turno.Nombre (@turno.HoraInicio.ToString(@"hh\:mm") - @turno.HoraFin.ToString(@"hh\:mm"))
                            </ItemTemplate>
                        </AutocompleteSelect>
                    </div>
                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger mt-3 mb-0">@errorMessage</div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CerrarModal">Cancelar</button>
                    <button type="button" class="btn btn-primary" @onclick="GuardarMaquinista" disabled="@isSaving">
                        @if (isSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        Guardar
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<LineaDto> lineas = new();
    private List<TurnoDto> turnos = new();
    private List<UsuarioDto> usuarios = new();
    private List<MaquinistaDto> maquinistas = new();
    private MaquinistaDto maquinistaActual = new();
    private int filtroLineaId = 0;
    private bool isLoading = true;
    private bool showModal = false;
    private bool editando = false;
    private bool isSaving = false;
    private string? errorMessage;

    private IEnumerable<MaquinistaDto> maquinistasFiltrados => filtroLineaId > 0
        ? maquinistas.Where(m => m.LineaId == filtroLineaId)
        : maquinistas;

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(
            CargarLineas(),
            CargarTurnos(),
            CargarUsuarios(),
            CargarMaquinistas()
        );
    }

    private async Task CargarLineas()
    {
        try
        {
            lineas = await CatalogosService.GetLineasAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error cargando lineas: {ex.Message}");
        }
    }

    private async Task CargarTurnos()
    {
        try
        {
            turnos = await CatalogosService.GetTurnosAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error cargando turnos: {ex.Message}");
        }
    }

    private async Task CargarUsuarios()
    {
        try
        {
            usuarios = await UsuariosService.GetUsuariosAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error cargando usuarios: {ex.Message}");
        }
    }

    private async Task CargarMaquinistas()
    {
        isLoading = true;
        try
        {
            maquinistas = await CatalogosService.GetMaquinistasAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error cargando maquinistas: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void NuevoMaquinista()
    {
        maquinistaActual = new MaquinistaDto
        {
            LineaId = filtroLineaId > 0 ? filtroLineaId : 0
        };
        editando = false;
        errorMessage = null;
        showModal = true;
    }

    private void EditarMaquinista(MaquinistaDto maq)
    {
        maquinistaActual = new MaquinistaDto
        {
            UsuarioLineaId = maq.UsuarioLineaId,
            UsuarioId = maq.UsuarioId,
            NombreUsuario = maq.NombreUsuario,
            LineaId = maq.LineaId,
            TurnoId = maq.TurnoId
        };
        editando = true;
        errorMessage = null;
        showModal = true;
    }

    private void CerrarModal()
    {
        showModal = false;
        maquinistaActual = new();
    }

    private async Task GuardarMaquinista()
    {
        if (string.IsNullOrWhiteSpace(maquinistaActual.UsuarioId) && !editando)
        {
            errorMessage = "Elegí un usuario.";
            return;
        }
        if (maquinistaActual.LineaId == 0)
        {
            errorMessage = "Elegí una línea.";
            return;
        }

        isSaving = true;
        errorMessage = null;

        try
        {
            if (editando)
            {
                await CatalogosService.UpdateMaquinistaAsync(maquinistaActual);
            }
            else
            {
                await CatalogosService.CreateMaquinistaAsync(maquinistaActual);
            }

            showModal = false;
            await CargarMaquinistas();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task ConfirmarEliminar(MaquinistaDto maq)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"¿Desea eliminar la asignacion de '{maq.NombreUsuario}' a '{maq.LineaNombre}'?");
        if (confirmed)
        {
            try
            {
                await CatalogosService.DeleteMaquinistaAsync(maq.UsuarioLineaId);
                await CargarMaquinistas();
            }
            catch (Exception ex)
            {
                await JS.InvokeVoidAsync("alert", $"Error: {ex.Message}");
            }
        }
    }
}
