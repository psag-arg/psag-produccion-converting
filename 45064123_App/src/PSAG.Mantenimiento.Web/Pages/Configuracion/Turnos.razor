@page "/configuracion/turnos"
@using Microsoft.AspNetCore.Authorization
@using PSAG.Mantenimiento.Web.Models
@using PSAG.Mantenimiento.Web.Services
@attribute [Authorize(Roles = "ADMINISTRADOR")]
@inject ICatalogosService CatalogosService
@inject IJSRuntime JS

<PageTitle>Turnos - PSAG Produccion</PageTitle>

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3>Turnos</h3>
        <button class="btn btn-primary" @onclick="NuevoTurno">
            <i class="bi bi-plus-circle me-2"></i>Nuevo Turno
        </button>
    </div>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>Codigo</th>
                            <th>Nombre</th>
                            <th>Hora Inicio</th>
                            <th>Hora Fin</th>
                            <th>Horas</th>
                            <th class="text-center">Activo</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (turnos.Any())
                        {
                            @foreach (var turno in turnos)
                            {
                                <tr>
                                    <td>@turno.TurnoId</td>
                                    <td><span class="badge bg-info">@turno.Codigo</span></td>
                                    <td><strong>@turno.Nombre</strong></td>
                                    <td>@turno.HoraInicio.ToString(@"hh\:mm")</td>
                                    <td>@turno.HoraFin.ToString(@"hh\:mm")</td>
                                    <td>@FormatearHoras(turno)</td>
                                    <td class="text-center">
                                        @if (turno.Activo)
                                        {
                                            <span class="badge bg-success">Activo</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Inactivo</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => EditarTurno(turno)">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmarDesactivar(turno)">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center text-muted py-4">No hay turnos registrados</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
        <div class="card mt-4">
            <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
                <h5 class="mb-0"><i class="bi bi-calendar3 me-2"></i>Calendario de excepciones</h5>
                <select class="form-select form-select-sm" style="width: 220px;" @onchange="CambiarLineaCalendario">
                    @foreach (var linea in lineas)
                    {
                        <option value="@linea.LineaId" selected="@(linea.LineaId == lineaCalendarioId)">@linea.Nombre</option>
                    }
                </select>
            </div>
            <div class="card-body">
                <p class="text-muted small mb-3">Si un día no tiene excepción, se usan los turnos activos de la línea. Solo se cargan los días distintos.</p>

                @if (!string.IsNullOrEmpty(errorCalendario) && diaSeleccionado == null)
                {
                    <div class="alert alert-danger">@errorCalendario</div>
                }

                <div class="row g-4">
                    <div class="col-lg-8">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <button type="button" class="btn btn-outline-secondary btn-sm" title="Mes anterior" @onclick="MesAnterior">
                                <i class="bi bi-chevron-left"></i>
                            </button>
                            <strong class="text-capitalize">@NombreMes</strong>
                            <button type="button" class="btn btn-outline-secondary btn-sm" title="Mes siguiente" @onclick="MesSiguiente">
                                <i class="bi bi-chevron-right"></i>
                            </button>
                        </div>

                        <div class="calendario-dias text-center small text-muted fw-semibold mb-1">
                            <div>Lun</div><div>Mar</div><div>Mié</div><div>Jue</div><div>Vie</div><div>Sáb</div><div>Dom</div>
                        </div>
                        <div class="calendario-dias">
                            @for (var i = 0; i < OffsetPrimerDia; i++)
                            {
                                <div></div>
                            }
                            @foreach (var dia in diasCalendario)
                            {
                                <button type="button"
                                        class="btn btn-sm dia-calendario p-1 text-start d-flex flex-column rounded-2 border @ClaseDia(dia) @(EsDiaSeleccionado(dia) ? "border-primary border-2" : "")"
                                        @onclick="() => SeleccionarDia(dia)">
                                    <span class="fw-bold small">@dia.Fecha.Day</span>
                                    <span class="small fw-semibold">@FormatearHorasDia(dia.Horas)</span>
                                    @if (dia.Origen == "EXCEPCION" && !string.IsNullOrEmpty(dia.Motivo))
                                    {
                                        <span class="small text-truncate">@dia.Motivo</span>
                                    }
                                </button>
                            }
                        </div>

                        <div class="d-flex flex-wrap gap-3 small text-muted mt-3">
                            <span><span class="d-inline-block rounded-1 border me-1" style="width: 12px; height: 12px;"></span>estándar por turnos</span>
                            <span><span class="d-inline-block rounded-1 border border-warning-subtle bg-warning-subtle me-1" style="width: 12px; height: 12px;"></span>excepción cargada</span>
                            <span><span class="d-inline-block rounded-1 border border-info-subtle bg-info-subtle me-1" style="width: 12px; height: 12px;"></span>horas históricas (HS PROG)</span>
                        </div>
                    </div>

                    <div class="col-lg-4">
                        @if (diaSeleccionado != null)
                        {
                            <div class="border rounded p-3">
                                <h6 class="mb-3">Excepción del @diaSeleccionado.Fecha.ToString("dd/MM/yyyy")</h6>
                                <div class="mb-3">
                                    <label class="form-label">Fecha</label>
                                    <input type="text" class="form-control" value="@diaSeleccionado.Fecha.ToString("dd/MM/yyyy")" disabled />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Horas programadas *</label>
                                    <input type="number" class="form-control" min="0" max="24" step="0.5" @bind="horasDiaSeleccionado" />
                                    <small class="text-muted">0 = la línea no trabaja ese día.</small>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Motivo</label>
                                    <input type="text" class="form-control" maxlength="200" placeholder="Ej: Paro parcial" @bind="motivoDiaSeleccionado" />
                                </div>
                                @if (diaSeleccionado.Origen == "HISTORICO")
                                {
                                    <div class="form-text mb-3">Día con horas históricas (HS PROG). Al guardar pasa a excepción.</div>
                                }
                                @if (!string.IsNullOrEmpty(errorCalendario))
                                {
                                    <div class="alert alert-danger py-2">@errorCalendario</div>
                                }
                                <div class="d-flex flex-wrap gap-2">
                                    <button type="button" class="btn btn-primary" @onclick="GuardarExcepcion" disabled="@isSavingDia">
                                        @if (isSavingDia)
                                        {
                                            <span class="spinner-border spinner-border-sm me-2"></span>
                                        }
                                        Guardar excepción
                                    </button>
                                    @if (diaSeleccionado.Origen == "EXCEPCION")
                                    {
                                        <button type="button" class="btn btn-outline-danger" @onclick="QuitarExcepcion">Quitar excepción</button>
                                    }
                                    <button type="button" class="btn btn-link" @onclick="CerrarDia">Cancelar</button>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="text-muted small">Hacé clic en un día del calendario para cargar o editar su excepción.</div>
                        }
                    </div>
                </div>
            </div>
        </div>
</div>

@* Modal para crear/editar *@
@if (showModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(editando ? "Editar" : "Nuevo") Turno</h5>
                    <button type="button" class="btn-close" @onclick="CerrarModal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Codigo *</label>
                        <input type="text" class="form-control" @bind="turnoActual.Codigo" placeholder="Ej: T1, T2, T3" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Nombre *</label>
                        <input type="text" class="form-control" @bind="turnoActual.Nombre" placeholder="Ej: Turno Manana" />
                    </div>
                    <div class="row">
                        <div class="col-6 mb-3">
                            <label class="form-label">Hora Inicio *</label>
                            <input type="text" class="form-control" @bind="horaInicioStr" placeholder="HH:mm" />
                        </div>
                        <div class="col-6 mb-3">
                            <label class="form-label">Hora Fin *</label>
                            <input type="text" class="form-control" @bind="horaFinStr" placeholder="HH:mm" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Orden</label>
                        <input type="number" class="form-control" @bind="turnoActual.Orden" />
                    </div>
                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" id="activo" @bind="turnoActual.Activo" />
                        <label class="form-check-label" for="activo">Activo</label>
                    </div>
                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger mt-3 mb-0">@errorMessage</div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CerrarModal">Cancelar</button>
                    <button type="button" class="btn btn-primary" @onclick="GuardarTurno" disabled="@isSaving">
                        @if (isSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        Guardar
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<TurnoDto> turnos = new();
    private TurnoDto turnoActual = new();
    private string horaInicioStr = "00:00";
    private string horaFinStr = "00:00";
    private bool isLoading = true;
    private bool showModal = false;
    private bool editando = false;
    private bool isSaving = false;
    private string? errorMessage;

    private List<LineaDto> lineas = new();
    private int lineaCalendarioId;
    private DateOnly mesCalendario;
    private List<DiaProgramadoDto> diasCalendario = new();
    private DiaProgramadoDto? diaSeleccionado;
    private decimal horasDiaSeleccionado;
    private string? motivoDiaSeleccionado;
    private string? errorCalendario;
    private bool isSavingDia = false;

    private string NombreMes => mesCalendario.ToString("MMMM yyyy");

    private int OffsetPrimerDia => ((int)new DateTime(mesCalendario.Year, mesCalendario.Month, 1).DayOfWeek + 6) % 7;

    protected override async Task OnInitializedAsync()
    {
        var hoy = DateTime.Today;
        mesCalendario = new DateOnly(hoy.Year, hoy.Month, 1);
        var tareaLineas = CatalogosService.GetLineasAsync();
        var tareaTurnos = CargarTurnos();
        lineas = await tareaLineas;
        lineaCalendarioId = lineas.FirstOrDefault()?.LineaId ?? 0;
        await Task.WhenAll(tareaTurnos, CargarCalendario());
    }

    private static string FormatearHoras(TurnoDto turno) => $"{turno.DuracionMinutos / 60.0:0.##} h";

    private static string FormatearHorasDia(decimal horas) => $"{horas:0.##} h";

    private static string ClaseDia(DiaProgramadoDto dia) => dia.Origen switch
    {
        "EXCEPCION" => "bg-warning-subtle border-warning-subtle",
        "HISTORICO" => "bg-info-subtle border-info-subtle",
        _ => "text-body"
    };

    private bool EsDiaSeleccionado(DiaProgramadoDto dia) => diaSeleccionado?.Fecha == dia.Fecha;

    private async Task CargarCalendario()
    {
        diasCalendario = new();
        if (lineaCalendarioId == 0)
            return;

        try
        {
            var hasta = new DateOnly(mesCalendario.Year, mesCalendario.Month, DateTime.DaysInMonth(mesCalendario.Year, mesCalendario.Month));
            diasCalendario = await CatalogosService.GetTiemposProgramadosAsync(lineaCalendarioId, mesCalendario, hasta);
        }
        catch (Exception ex)
        {
            errorCalendario = ex.Message;
        }
    }

    private async Task CambiarLineaCalendario(ChangeEventArgs e)
    {
        lineaCalendarioId = int.TryParse(e.Value?.ToString(), out var id) ? id : 0;
        diaSeleccionado = null;
        await CargarCalendario();
    }

    private async Task MesAnterior()
    {
        mesCalendario = mesCalendario.AddMonths(-1);
        diaSeleccionado = null;
        await CargarCalendario();
    }

    private async Task MesSiguiente()
    {
        mesCalendario = mesCalendario.AddMonths(1);
        diaSeleccionado = null;
        await CargarCalendario();
    }

    private void SeleccionarDia(DiaProgramadoDto dia)
    {
        diaSeleccionado = dia;
        horasDiaSeleccionado = dia.Horas;
        motivoDiaSeleccionado = dia.Origen == "EXCEPCION" ? dia.Motivo : null;
        errorCalendario = null;
    }

    private void CerrarDia()
    {
        diaSeleccionado = null;
        errorCalendario = null;
    }

    private async Task GuardarExcepcion()
    {
        if (diaSeleccionado == null)
            return;

        if (horasDiaSeleccionado < 0 || horasDiaSeleccionado > 24)
        {
            errorCalendario = "Las horas programadas deben estar entre 0 y 24.";
            return;
        }

        var fecha = diaSeleccionado.Fecha;
        isSavingDia = true;
        errorCalendario = null;

        try
        {
            await CatalogosService.GuardarTiempoProgramadoAsync(lineaCalendarioId, fecha, horasDiaSeleccionado, motivoDiaSeleccionado);
            await CargarCalendario();
            var actualizado = diasCalendario.FirstOrDefault(d => d.Fecha == fecha);
            if (actualizado != null)
                SeleccionarDia(actualizado);
        }
        catch (Exception ex)
        {
            errorCalendario = ex.Message;
        }
        finally
        {
            isSavingDia = false;
        }
    }

    private async Task QuitarExcepcion()
    {
        if (diaSeleccionado?.TiempoProgramadoDiaId is not int id)
            return;

        var confirmed = await JS.InvokeAsync<bool>("confirm", $"¿Quitar la excepción del {diaSeleccionado.Fecha.ToString("dd/MM/yyyy")}? El día vuelve a regirse por los turnos activos.");
        if (!confirmed)
            return;

        try
        {
            await CatalogosService.DesactivarTiempoProgramadoAsync(id);
            diaSeleccionado = null;
            await CargarCalendario();
        }
        catch (Exception ex)
        {
            errorCalendario = ex.Message;
        }
    }

    private async Task CargarTurnos()
    {
        isLoading = true;
        try
        {
            turnos = await CatalogosService.GetTurnosAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void NuevoTurno()
    {
        turnoActual = new TurnoDto { Activo = true, Orden = turnos.Count + 1 };
        horaInicioStr = "06:00";
        horaFinStr = "14:00";
        editando = false;
        errorMessage = null;
        showModal = true;
    }

    private void EditarTurno(TurnoDto turno)
    {
        turnoActual = new TurnoDto
        {
            TurnoId = turno.TurnoId,
            Codigo = turno.Codigo,
            Nombre = turno.Nombre,
            HoraInicio = turno.HoraInicio,
            HoraFin = turno.HoraFin,
            Orden = turno.Orden,
            Activo = turno.Activo
        };
        horaInicioStr = turno.HoraInicio.ToString(@"hh\:mm");
        horaFinStr = turno.HoraFin.ToString(@"hh\:mm");
        editando = true;
        errorMessage = null;
        showModal = true;
    }

    private void CerrarModal()
    {
        showModal = false;
        turnoActual = new();
    }

    private async Task GuardarTurno()
    {
        if (string.IsNullOrWhiteSpace(turnoActual.Codigo))
        {
            errorMessage = "El codigo es requerido";
            return;
        }
        if (string.IsNullOrWhiteSpace(turnoActual.Nombre))
        {
            errorMessage = "El nombre es requerido";
            return;
        }

        // Parsear horas
        if (!TimeSpan.TryParse(horaInicioStr, out var horaInicio))
        {
            errorMessage = "Hora de inicio invalida";
            return;
        }
        if (!TimeSpan.TryParse(horaFinStr, out var horaFin))
        {
            errorMessage = "Hora de fin invalida";
            return;
        }

        turnoActual.HoraInicio = horaInicio;
        turnoActual.HoraFin = horaFin;

        isSaving = true;
        errorMessage = null;

        try
        {
            if (editando)
            {
                await CatalogosService.UpdateTurnoAsync(turnoActual);
            }
            else
            {
                await CatalogosService.CreateTurnoAsync(turnoActual);
            }

            showModal = false;
            await CargarTurnos();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task ConfirmarDesactivar(TurnoDto turno)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"¿Desea desactivar el turno '{turno.Nombre}'?");
        if (confirmed)
        {
            try
            {
                turno.Activo = false;
                await CatalogosService.UpdateTurnoAsync(turno);
                await CargarTurnos();
            }
            catch (Exception ex)
            {
                await JS.InvokeVoidAsync("alert", $"Error: {ex.Message}");
            }
        }
    }
}
