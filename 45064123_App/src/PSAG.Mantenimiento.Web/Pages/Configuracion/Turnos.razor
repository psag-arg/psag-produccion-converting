@page "/configuracion/turnos"
@using System.Globalization
@using Microsoft.AspNetCore.Authorization
@using PSAG.Mantenimiento.Web.Models
@using PSAG.Mantenimiento.Web.Services
@attribute [Authorize(Roles = "ADMINISTRADOR")]
@inject ICatalogosService CatalogosService
@inject IJSRuntime JS

<PageTitle>Turnos - PSAG Produccion</PageTitle>

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3>Turnos</h3>
        <button class="btn btn-primary" @onclick="NuevoTurno">
            <i class="bi bi-plus-circle me-2"></i>Nuevo turno
        </button>
    </div>

    <AvisoDescartable @bind-Mensaje="mensajeLista" />

    <SwitchInactivos @bind-Mostrar="mostrarInactivos" @bind-Mostrar:after="CargarTurnos" Ayuda="Los turnos activos no pueden superponerse y entre todos suman como máximo 24 h por día." />

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>Código</th>
                            <th>Nombre</th>
                            <th>Hora Inicio</th>
                            <th>Hora Fin</th>
                            <th>Horas</th>
                            <th class="text-center">Activo</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (turnos.Any())
                        {
                            @foreach (var turno in turnos)
                            {
                                <tr>
                                    <td>@turno.TurnoId</td>
                                    <td><span class="badge bg-info">@turno.Codigo</span></td>
                                    <td><strong>@turno.Nombre</strong></td>
                                    <td>@turno.HoraInicio.ToString(@"hh\:mm")</td>
                                    <td>@turno.HoraFin.ToString(@"hh\:mm")</td>
                                    <td>@FormatearHoras(turno)</td>
                                    <td class="text-center">
                                        @if (turno.Activo)
                                        {
                                            <span class="badge bg-success">Activo</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Inactivo</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => EditarTurno(turno)">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        @if (turno.Activo)
                                        {
                                            <button class="btn btn-sm btn-outline-danger" title="Desactivar" @onclick="() => ConfirmarDesactivar(turno)">
                                                <i class="bi bi-pause-circle"></i>
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center text-muted py-4">No hay turnos cargados.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    <div class="alert alert-light border mt-4 small mb-0">
        <i class="bi bi-calendar3 me-2"></i>
        Las horas programadas de cada línea (qué turnos trabaja cada día de la semana y las excepciones por día)
        se cargan en <a href="configuracion/horas-programadas">Horas programadas</a>.
        Una línea sin calendario cuenta todos los turnos activos todos los días.
    </div>
</div>

@* Modal para crear/editar *@
@if (showModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(editando ? "Editar turno" : "Nuevo turno")</h5>
                    <button type="button" class="btn-close" @onclick="CerrarModal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Código *</label>
                        <input type="text" class="form-control" @bind="turnoActual.Codigo" placeholder="Ej: T1, T2, T3" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Nombre *</label>
                        <input type="text" class="form-control" @bind="turnoActual.Nombre" placeholder="Ej: Turno Mañana" />
                    </div>
                    <div class="row">
                        <div class="col-6 mb-3">
                            <label class="form-label">Hora de inicio *</label>
                            <input type="time" class="form-control" value="@horaInicioStr" @onchange="e => horaInicioStr = e.Value?.ToString() ?? string.Empty" />
                        </div>
                        <div class="col-6 mb-3">
                            <label class="form-label">Hora de fin *</label>
                            <input type="time" class="form-control" value="@horaFinStr" @onchange="e => horaFinStr = e.Value?.ToString() ?? string.Empty" />
                        </div>
                        <div class="col-12 form-text mt-n2 mb-3">Si la hora de fin es menor que la de inicio, el turno termina al día siguiente (por ejemplo, 22:00 a 06:00).</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Orden</label>
                        <input type="number" class="form-control" @bind="turnoActual.Orden" />
                    </div>
                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" id="activo" @bind="turnoActual.Activo" />
                        <label class="form-check-label" for="activo">Activo</label>
                    </div>
                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger mt-3 mb-0">@errorMessage</div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CerrarModal">Cancelar</button>
                    <button type="button" class="btn btn-primary" @onclick="GuardarTurno" disabled="@isSaving">
                        @if (isSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        Guardar
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<TurnoDto> turnos = new();
    private TurnoDto turnoActual = new();
    private string horaInicioStr = "00:00";
    private string horaFinStr = "00:00";
    private bool isLoading = true;
    private bool showModal = false;
    private bool editando = false;
    private bool isSaving = false;
    private string? errorMessage;

    private string? mensajeLista;
    private bool mostrarInactivos;

    protected override async Task OnInitializedAsync()
    {
        await CargarTurnos();
    }

    private static string FormatearHoras(TurnoDto turno) => $"{turno.DuracionMinutos / 60.0:0.##} h";

    private async Task CargarTurnos()
    {
        isLoading = true;
        try
        {
            turnos = await CatalogosService.GetTurnosAsync(incluirInactivos: mostrarInactivos);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void NuevoTurno()
    {
        turnoActual = new TurnoDto { Activo = true, Orden = turnos.Count + 1 };
        horaInicioStr = "06:00";
        horaFinStr = "14:00";
        editando = false;
        errorMessage = null;
        showModal = true;
    }

    private void EditarTurno(TurnoDto turno)
    {
        turnoActual = new TurnoDto
        {
            TurnoId = turno.TurnoId,
            Codigo = turno.Codigo,
            Nombre = turno.Nombre,
            HoraInicio = turno.HoraInicio,
            HoraFin = turno.HoraFin,
            Orden = turno.Orden,
            Activo = turno.Activo
        };
        horaInicioStr = turno.HoraInicio.ToString(@"hh\:mm");
        horaFinStr = turno.HoraFin.ToString(@"hh\:mm");
        editando = true;
        errorMessage = null;
        showModal = true;
    }

    private void CerrarModal()
    {
        showModal = false;
        turnoActual = new();
    }

    private async Task GuardarTurno()
    {
        if (string.IsNullOrWhiteSpace(turnoActual.Codigo))
        {
            errorMessage = "Completá el código.";
            return;
        }
        if (string.IsNullOrWhiteSpace(turnoActual.Nombre))
        {
            errorMessage = "Completá el nombre.";
            return;
        }

        // TimeSpan.TryParse lee "6" como 6 días: se exige HH:mm.
        if (ParsearHora(horaInicioStr) is not TimeOnly horaInicio || ParsearHora(horaFinStr) is not TimeOnly horaFin)
        {
            errorMessage = "Escribí la hora como HH:mm, por ejemplo 06:00.";
            return;
        }
        if (horaInicio == horaFin)
        {
            errorMessage = "La hora de inicio y la de fin no pueden ser iguales.";
            return;
        }

        turnoActual.HoraInicio = horaInicio.ToTimeSpan();
        turnoActual.HoraFin = horaFin.ToTimeSpan();

        isSaving = true;
        errorMessage = null;

        try
        {
            if (editando)
            {
                await CatalogosService.UpdateTurnoAsync(turnoActual);
            }
            else
            {
                await CatalogosService.CreateTurnoAsync(turnoActual);
            }

            showModal = false;
            await CargarTurnos();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    private Task ConfirmarDesactivar(TurnoDto turno) =>
        JS.ConfirmarYDesactivarAsync($"el turno '{turno.Nombre}'", $"Las horas programadas por día bajan en {FormatearHoras(turno)}.",
            activo => turno.Activo = activo, () => CatalogosService.UpdateTurnoAsync(turno),
            async () => await CargarTurnos(), m => mensajeLista = m);

    private static TimeOnly? ParsearHora(string? texto) =>
        TimeOnly.TryParseExact(texto?.Trim(), new[] { "HH:mm", "H:mm", "HH:mm:ss" }, CultureInfo.InvariantCulture, DateTimeStyles.None, out var hora)
            ? hora
            : null;
}
