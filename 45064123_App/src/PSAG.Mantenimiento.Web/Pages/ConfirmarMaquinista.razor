@page "/maquinista-turno/confirmar"
@using Microsoft.AspNetCore.Authorization
@using PSAG.Mantenimiento.Web.Models
@using PSAG.Mantenimiento.Web.Services
@attribute [Authorize]
@inject IMaquinistaTurnoService MaquinistaTurnoService
@inject NavigationManager Navigation

<PageTitle>Maquinista del turno - PSAG Produccion</PageTitle>

@* T-783: después del login, el operario confirma si es el maquinista del turno en curso de su máquina (línea).
   Sólo se ofrecen las líneas donde tiene asignación para ese turno (o sin turno fijo). Sin asignación, sólo el
   aviso. Si no hay nada que preguntar, sigue de largo al destino. *@

<div class="container" style="max-width: 640px;">
    @if (cargando)
    {
        <div class="text-center py-5"><div class="spinner-border text-primary" role="status"><span class="visually-hidden">Cargando...</span></div></div>
    }
    else if (propuesta != null)
    {
        <h3 class="mt-3 mb-1"><i class="bi bi-person-badge me-2"></i>Maquinista del turno</h3>
        <div class="text-muted mb-3">@propuesta.TurnoNombre · @propuesta.FechaTurno?.ToString("dd/MM/yyyy")</div>

        @if (!string.IsNullOrEmpty(propuesta.Aviso))
        {
            <div class="alert alert-warning">
                <i class="bi bi-exclamation-triangle me-2"></i>@propuesta.Aviso
            </div>
        }

        @foreach (var o in propuesta.Opciones)
        {
            <div class="card mb-3">
                <div class="card-body">
                    <h5 class="card-title mb-2">@o.LineaNombre</h5>
                    @if (o.YaConfirmado || confirmadas.ContainsKey(o.LineaId))
                    {
                        <div class="text-success"><i class="bi bi-check-circle me-1"></i>Sos el maquinista de este turno.</div>
                        @if (confirmadas.TryGetValue(o.LineaId, out var c))
                        {
                            @if (c.ReemplazadoNombre != null)
                            {
                                <div class="small text-muted">Reemplazaste a @c.ReemplazadoNombre.</div>
                            }
                            @if (c.DetencionesReasignadas > 0)
                            {
                                <div class="small text-muted">@c.DetencionesReasignadas @(c.DetencionesReasignadas == 1 ? "detención pendiente del turno pasó" : "detenciones pendientes del turno pasaron") a tu nombre.</div>
                            }
                        }
                    }
                    else
                    {
                        <p class="mb-2">¿Vas a ser el maquinista del <strong>@propuesta.TurnoNombre</strong> en <strong>@o.LineaNombre</strong>?</p>
                        @if (o.MaquinistaActualNombre != null || o.MaquinistaActualUsuarioId != null)
                        {
                            <div class="alert alert-info py-2 small">
                                Ya figura <strong>@(o.MaquinistaActualNombre ?? "otro usuario")</strong> como maquinista de este turno
                                (@(o.MaquinistaActualOrigen == "SUPERVISOR" ? "lo cargó el supervisor" : "confirmó") a las @o.MaquinistaActualDesde?.ToString("HH:mm")).
                                Si confirmás, quedás vos y el cambio queda registrado.
                            </div>
                        }
                        @if (o.SinTurnoFijo)
                        {
                            <div class="small text-muted mb-2">Estás asignado a esta línea sin turno fijo.</div>
                        }
                        <button class="btn btn-primary" disabled="@enviando" @onclick="@(async () => await Confirmar(o))">
                            <i class="bi bi-check-lg me-1"></i>Sí, soy el maquinista
                        </button>
                    }
                </div>
            </div>
        }

        @if (error != null)
        {
            <div class="alert alert-danger">@error</div>
        }

        <div class="d-flex justify-content-end mt-2 mb-4">
            <button class="btn btn-outline-secondary" @onclick="Seguir">
                @(propuesta.Opciones.Count == 0 || confirmadas.Count > 0 ? "Continuar" : "No, seguir sin confirmar")
                <i class="bi bi-arrow-right ms-1"></i>
            </button>
        </div>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "volver")]
    public string? Volver { get; set; }

    private PropuestaMaquinistaTurnoDto? propuesta;
    private readonly Dictionary<int, ConfirmacionMaquinistaTurnoDto> confirmadas = [];
    private bool cargando = true;
    private bool enviando;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        propuesta = await MaquinistaTurnoService.GetPropuestaAsync();
        if (propuesta is not { Preguntar: true })
        {
            Seguir();
            return;
        }
        cargando = false;
    }

    private async Task Confirmar(OpcionMaquinistaTurnoDto opcion)
    {
        enviando = true;
        error = null;
        try
        {
            var (resultado, mensaje) = await MaquinistaTurnoService.ConfirmarAsync(opcion.LineaId);
            if (resultado == null)
            {
                error = mensaje;
                return;
            }
            confirmadas[opcion.LineaId] = resultado;
            // Con una sola línea no hay más nada que preguntar.
            if (propuesta!.Opciones.All(o => o.YaConfirmado || confirmadas.ContainsKey(o.LineaId)) && propuesta.Opciones.Count == 1
                && resultado.ReemplazadoNombre == null && resultado.DetencionesReasignadas == 0)
                Seguir();
        }
        finally
        {
            enviando = false;
        }
    }

    private void Seguir() => Navigation.NavigateTo(RutasLogin.DestinoSeguro(Volver));
}
