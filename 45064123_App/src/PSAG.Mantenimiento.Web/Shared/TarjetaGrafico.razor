@* T-770 iteración 2 · Bloque de un tema del tablero (los 4 indicadores de Ferretti): título, el gráfico SVG y
   "Ver detalle" (abre un modal; no navega). Colores de Bootstrap: sigue al modo oscuro.
   Ajustes 23/11: cada tema tiene su color de acento (borde superior e ícono, TableroUi.ColorTema); el mismo color va en
   el encabezado de sus modales. El acento no toca el semáforo del medidor de eficiencia. *@

<div class="col">
    <div class="card h-100 border-2" data-testid="@TestId" data-tema="@TableroUi.ClaveTema(Tema)" style="@TableroUi.EstiloAcento(Tema)">
        <div class="card-body d-flex flex-column">
            <div class="d-flex align-items-center gap-2 mb-2">
                <i class="bi @Icono fs-4" style="color: @TableroUi.ColorTema(Tema)"></i>
                <span class="fw-bold text-uppercase" style="color: @TableroUi.ColorTema(Tema)">@Titulo</span>
                @if (!string.IsNullOrEmpty(Subtitulo))
                {
                    <span class="ms-auto small text-body-secondary text-end">@Subtitulo</span>
                }
            </div>
            @ChildContent
            @if (AlVerDetalle.HasDelegate)
            {
                <button type="button" class="btn btn-outline-secondary btn-lg mt-auto w-100 boton-tablet" @onclick="@(async () => await AlVerDetalle.InvokeAsync())">
                    <i class="bi bi-zoom-in me-1"></i>Ver detalle
                </button>
            }
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string Titulo { get; set; } = string.Empty;
    [Parameter, EditorRequired] public TableroUi.Tema Tema { get; set; }
    [Parameter] public string? Subtitulo { get; set; }
    [Parameter] public string Icono { get; set; } = "bi-graph-up";
    [Parameter] public string? TestId { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public EventCallback AlVerDetalle { get; set; }
}
