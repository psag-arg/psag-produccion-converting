@* Dashboard: presupuesto vs. real por turno de producción, ayer y hoy (T-798 etapa 5). Reemplaza "Producción por
   cámara": un solo cálculo (api/indicadores/produccion). "Sin datos" nunca es 0 y "sin objetivo" nunca es 0 %. *@
@inject IIndicadoresService IndicadoresService

<div class="row mb-4">
    <div class="col-12">
        <div class="card border-info">
            <div class="card-header text-bg-info d-flex justify-content-between align-items-center">
                <h6 class="mb-0"><i class="bi bi-speedometer2 me-2"></i>Presupuesto vs. real</h6>
                <small class="d-none d-sm-inline">Mangas por turno, ayer y hoy</small>
            </div>
            <div class="card-body p-2 p-md-3">
                @if (cargando)
                {
                    <div class="text-center py-3"><div class="spinner-border spinner-border-sm text-info" role="status"></div> Cargando...</div>
                }
                else if (error)
                {
                    <div class="text-danger small">No se pudieron cargar los indicadores de producción. Tocá Actualizar.</div>
                }
                else if (!datos.Filas.Any())
                {
                    <p class="text-muted text-center py-2 mb-0">No hay turnos de producción ayer ni hoy.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Turno</th>
                                    <th class="text-end">Objetivo</th>
                                    <th class="text-end">Real</th>
                                    <th class="text-end">Eficiencia</th>
                                    <th class="text-end d-none d-md-table-cell">Bolsones</th>
                                    <th class="text-end d-none d-md-table-cell">Velocidad</th>
                                    <th class="text-end d-none d-md-table-cell">Parada</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var f in datos.Filas.Concat([datos.Total]))
                                {
                                    var total = f.Clave == "total";
                                    <tr class="@(total ? "fw-semibold table-group-divider" : "")">
                                        <td>
                                            @if (total)
                                            {
                                                <span>Total</span>
                                            }
                                            else
                                            {
                                                <span>@f.FechaProduccion?.ToString("dd/MM") · @f.LineaNombre · @f.TurnoNombre</span>
                                                @if (f.IncluyeAbiertos)
                                                {
                                                    <span class="badge bg-primary ms-1">En curso</span>
                                                }
                                            }
                                        </td>
                                        <td class="text-end">@EficienciaUi.TextoObjetivo(f.Mangas)</td>
                                        <td class="text-end">@EficienciaUi.TextoReal(f.Mangas)</td>
                                        <td class="text-end @EficienciaUi.ClasePorcentaje(f.Eficiencia)">@EficienciaUi.TextoPorcentaje(f.Eficiencia)</td>
                                        <td class="text-end d-none d-md-table-cell">@EficienciaUi.TextoReal(f.Bolsones) / @EficienciaUi.TextoObjetivo(f.Bolsones)</td>
                                        <td class="text-end d-none d-md-table-cell">@EficienciaUi.TextoVelocidad(f.VelocidadMetrosMinuto)</td>
                                        <td class="text-end d-none d-md-table-cell">@(f.MinutosParadaQueCuentan is { } m ? EficienciaUi.Minutos(m) : "-")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="small text-muted mt-2">
                        Objetivo prorrateado por los minutos de cada producto del turno. * provisorio: producción sin validar o turno en curso.
                        Parada: detenciones que cuentan para indicadores. <a href="/paradas-camara">Ver paradas y producción de las cámaras</a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    /// <summary>Línea elegida en el Dashboard (null = todas).</summary>
    [Parameter] public int? LineaId { get; set; }

    private PresupuestoRealDto datos = new();
    private bool cargando = true;
    private bool error;
    private int? lineaCargada = -1;

    protected override async Task OnParametersSetAsync()
    {
        if (lineaCargada != LineaId)
            await CargarAsync();
    }

    private async Task CargarAsync()
    {
        lineaCargada = LineaId;
        cargando = true;
        error = false;
        try
        {
            var hoy = DateOnly.FromDateTime(DateTime.Now);
            datos = await IndicadoresService.GetProduccionAsync(hoy.AddDays(-1), hoy, LineaId);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error cargando el presupuesto vs. real: {ex.Message}");
            error = true;
        }
        finally
        {
            cargando = false;
        }
    }
}
