@* Dashboard: producción por turno según las cámaras (ex "Eficiencia (cámara)", reunión 03/11). Hoy y ayer.
   T-798 etapa 4: el objetivo por hora de la cámara se quitó; el objetivo (y el %) sale del parámetro línea +
   producto en la etapa 5. Un turno sin minutos dice "Sin datos", nunca 0. *@
@inject IConteoCamaraService ConteoCamaraService

<div class="row mb-4">
    <div class="col-12">
        <div class="card border-info">
            <div class="card-header text-bg-info d-flex justify-content-between align-items-center">
                <h6 class="mb-0"><i class="bi bi-camera-video me-2"></i>Producción por cámara</h6>
                <small class="d-none d-sm-inline">Contadas por turno</small>
            </div>
            <div class="card-body p-2 p-md-3">
                @if (cargando)
                {
                    <div class="text-center py-3"><div class="spinner-border spinner-border-sm text-info" role="status"></div> Cargando...</div>
                }
                else if (error)
                {
                    <div class="text-danger small">No se pudo cargar la producción de las cámaras. Tocá Actualizar.</div>
                }
                else if (!camaras.Any())
                {
                    <p class="text-muted text-center py-2 mb-0">Ninguna cámara contó producción hoy ni ayer.</p>
                }
                else
                {
                    <div class="row g-3">
                        @foreach (var camara in camaras)
                        {
                            <div class="col-12">
                                <div class="border rounded p-2 h-100">
                                    <div class="d-flex flex-wrap justify-content-between align-items-baseline gap-1 mb-1">
                                        <strong>@EficienciaUi.Titulo(camara)</strong>
                                        @if (camara.CuentaProduccionOficial)
                                        {
                                            <span class="badge text-bg-primary" title="Es la cámara que cuenta la producción oficial de su magnitud en la línea">Oficial</span>
                                        }
                                    </div>

                                    @foreach (var (etiqueta, dia) in DiasDe(camara.CamaraId))
                                    {
                                        <div class="small text-uppercase text-muted fw-semibold mt-2">@etiqueta @dia.Fecha.ToString("dd/MM")</div>
                                        @foreach (var t in dia.Turnos)
                                        {
                                            var momento = EficienciaUi.TextoMomento(t.Momento);
                                            <div class="row g-1 align-items-center py-2 border-bottom text-center eficiencia-turno">
                                                <div class="col-12 col-md-3 text-start">
                                                    <span class="fw-semibold">@t.TurnoNombre</span>
                                                    @if (momento != null)
                                                    {
                                                        <span class="badge @(t.Momento == "EN_CURSO" ? "bg-primary" : "bg-secondary") ms-1">@momento</span>
                                                    }
                                                    <div class="small text-muted">@EficienciaUi.Horario(t)</div>
                                                </div>
                                                @if (t.Momento == "SIN_EMPEZAR")
                                                {
                                                    <div class="col-12 col-md-9 small text-muted">Todavía no empezó.</div>
                                                }
                                                else
                                                {
                                                <div class="col-6 col-md-3">
                                                    <div class="fs-5 fw-semibold lh-1 @(t.SinDatos ? "text-warning-emphasis" : "")">@EficienciaUi.TextoContadas(t)</div>
                                                    <small class="text-muted">Contadas</small>
                                                </div>
                                                <div class="col-6 col-md-3 small text-muted">
                                                    @(t.SinDatos ? "La cámara no mandó datos en el turno" : $"{EficienciaUi.Minutos(t.MinutosConDatos)} con datos")
                                                </div>
                                                <div class="col-6 col-md-2">
                                                    <div class="fw-semibold @(t.MinutosParada > 0 ? "text-danger" : "")">@EficienciaUi.Minutos(t.MinutosParada)</div>
                                                    <small class="text-muted">Parada</small>
                                                    @if (t.MinutosMicroparadas > 0)
                                                    {
                                                        <div class="small text-muted" title="De los minutos de parada, los de microparadas (no llegaron al umbral)">micro: @EficienciaUi.Minutos(t.MinutosMicroparadas)</div>
                                                    }
                                                </div>
                                                <div class="col-6 col-md-1">
                                                    <div class="fw-semibold" title="Paradas de menos de @camara.UmbralTexto">@t.Microcortes</div>
                                                    <small class="text-muted">Microcortes</small>
                                                </div>
                                                }
                                            </div>
                                        }
                                    }
                                </div>
                            </div>
                        }
                    </div>
                    <div class="small text-muted mt-2">
                        El objetivo y la eficiencia salen del producto de la línea (próximamente). "Sin datos" no es producción cero.
                        Microcortes: paradas de la cámara más cortas que el umbral de detención (marcadas con el umbral del momento en que pasaron).
                        <a href="/paradas-camara">Ver paradas y producción</a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    /// <summary>Línea elegida en el Dashboard (null = todas).</summary>
    [Parameter] public int? LineaId { get; set; }

    private EficienciaCamaraDiaDto hoy = new();
    private EficienciaCamaraDiaDto ayer = new();
    private List<EficienciaCamaraPuntoDto> camaras = new();
    private bool cargando = true;
    private bool error;
    private int? lineaCargada = -1;

    protected override async Task OnParametersSetAsync()
    {
        if (lineaCargada != LineaId)
            await CargarAsync();
    }

    private async Task CargarAsync()
    {
        lineaCargada = LineaId;
        cargando = true;
        error = false;
        try
        {
            var fechaHoy = DateOnly.FromDateTime(DateTime.Now);
            var tareaHoy = ConteoCamaraService.GetEficienciaAsync(fechaHoy, LineaId);
            var tareaAyer = ConteoCamaraService.GetEficienciaAsync(fechaHoy.AddDays(-1), LineaId);
            hoy = await tareaHoy;
            ayer = await tareaAyer;
            // Una tarjeta por cámara, aunque sólo tenga datos uno de los dos días.
            camaras = hoy.Camaras.Concat(ayer.Camaras)
                .GroupBy(c => c.CamaraId)
                .Select(g => g.First())
                .ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error cargando la producción por cámara: {ex.Message}");
            error = true;
        }
        finally
        {
            cargando = false;
        }
    }

    private IEnumerable<(string Etiqueta, DiaCamara Dia)> DiasDe(int camaraId)
    {
        foreach (var (etiqueta, dia) in new[] { ("Hoy", hoy), ("Ayer", ayer) })
        {
            var camara = dia.Camaras.FirstOrDefault(c => c.CamaraId == camaraId);
            if (camara != null)
                yield return (etiqueta, new DiaCamara(dia.Fecha, camara.Turnos));
        }
    }

    private sealed record DiaCamara(DateOnly Fecha, List<EficienciaTurnoDto> Turnos);
}
