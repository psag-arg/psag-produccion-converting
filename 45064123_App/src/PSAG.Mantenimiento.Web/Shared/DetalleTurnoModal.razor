@* T-803 · Detalle de un turno de producción en un MODAL (sin salir de Presupuesto vs. real): indicadores, presupuesto vs.
   real por producto (TablaTramos de T-770), la producción de cada tramo (cámara / oficial / estado, sólo lectura) y los
   microcortes por cámara. Validar o corregir la producción sigue en Turnos de producción (enlace, si tiene el permiso). *@
@using PSAG.Mantenimiento.Web.Models
@using PSAG.Mantenimiento.Web.Services
@inject IIndicadoresService IndicadoresService
@inject IConteoCamaraService ConteoCamaraService

@if (TurnoProduccionId is { } id)
{
    <div class="modal d-block" tabindex="-1" style="background-color: var(--psag-velo);" data-testid="modal-detalle-turno">
        <div class="modal-dialog modal-xl modal-dialog-scrollable modal-fullscreen-md-down">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@Titulo</h5>
                    <button type="button" class="btn-close" aria-label="Cerrar" @onclick="@(async () => await AlCerrar.InvokeAsync())"></button>
                </div>
                <div class="modal-body">
                    @if (error != null)
                    {
                        <div class="alert alert-warning">@error</div>
                    }
                    else if (detalle == null)
                    {
                        <div class="text-center py-4"><div class="spinner-border text-primary" role="status"><span class="visually-hidden">Cargando...</span></div></div>
                    }
                    else
                    {
                        var d = detalle;
                        <div class="row g-2 mb-2">
                            <div class="col-6 col-md">
                                <div class="border rounded p-2 text-center h-100">
                                    <div class="small text-muted">Eficiencia (mangas)</div>
                                    <div class="fs-4 fw-semibold @EficienciaUi.ClasePorcentaje(d.Eficiencia)">@EficienciaUi.TextoPorcentaje(d.Eficiencia)</div>
                                </div>
                            </div>
                            <div class="col-6 col-md">
                                <div class="border rounded p-2 text-center h-100">
                                    <div class="small text-muted">Mangas real / objetivo</div>
                                    <div class="fs-5 fw-semibold">@EficienciaUi.TextoReal(d.Mangas)</div>
                                    <div class="small text-muted">de @EficienciaUi.TextoObjetivo(d.Mangas)</div>
                                </div>
                            </div>
                            <div class="col-6 col-md">
                                <div class="border rounded p-2 text-center h-100">
                                    <div class="small text-muted">Bolsones real / objetivo</div>
                                    <div class="fs-5 fw-semibold">@EficienciaUi.TextoReal(d.Bolsones)</div>
                                    <div class="small text-muted">de @EficienciaUi.TextoObjetivo(d.Bolsones)</div>
                                </div>
                            </div>
                            <div class="col-6 col-md">
                                <div class="border rounded p-2 text-center h-100">
                                    <div class="small text-muted">Velocidad</div>
                                    <div class="fs-5 fw-semibold">@EficienciaUi.TextoVelocidad(d.VelocidadMetrosMinuto)</div>
                                </div>
                            </div>
                            <div class="col-12 col-md">
                                <div class="border rounded p-2 text-center h-100" title="Detenciones que cuentan ÷ minutos programados">
                                    <div class="small text-muted">Indisponibilidad</div>
                                    <div class="fs-5 fw-semibold">@(d.Indisponibilidad is { } i ? $"{i:N1} %" : "-")</div>
                                    <div class="small text-muted">@EficienciaUi.Minutos(d.MinutosParadaQueCuentan) de parada · @EficienciaUi.Minutos(d.MinutosProgramados) programados</div>
                                </div>
                            </div>
                        </div>
                        @if (d.ACompletar)
                        {
                            <div class="text-warning-emphasis small">Turno sin producto: se carga desde Turnos de producción ("Corregir producto").</div>
                        }

                        <TablaTramos Tramos="d.Tramos" />

                        @if (d.Tramos.Count > 0)
                        {
                            <h5 class="mt-3">Producción</h5>
                            <div class="table-responsive">
                                <table class="table table-sm align-middle mb-1">
                                    <thead>
                                        <tr>
                                            <th>Tramo</th><th>Magnitud</th><th class="text-end">Objetivo</th><th class="text-end">Cámara</th>
                                            <th class="text-end">Oficial</th><th>Estado</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var tramo in d.Tramos)
                                        {
                                            @foreach (var m in new[] { tramo.Mangas, tramo.Bolsones })
                                            {
                                                <tr>
                                                    <td>@tramo.ProductoNombre <span class="text-muted">@tramo.Desde.ToString("HH:mm")–@(tramo.Hasta?.ToString("HH:mm") ?? "…")</span></td>
                                                    <td>@CamarasUi.Unidad(m.Magnitud) @if (!m.TieneCamaraOficial) { <span class="text-muted">(sin cámara)</span> }</td>
                                                    <td class="text-end">@(m.Objetivo is { } o ? EficienciaUi.Numero(o) : EficienciaUi.TextoSinObjetivo)</td>
                                                    <td class="text-end">@(tramo.Abierto ? ProduccionUi.TextoCantidad(m.Real) : ProduccionUi.TextoCantidad(m.Vigente?.CantidadCamara))</td>
                                                    <td class="text-end">@ProduccionUi.TextoCantidad(m.Vigente?.CantidadOficial)</td>
                                                    <td><span class="badge @ProduccionUi.ClaseEstadoReal(m.EstadoReal)">@ProduccionUi.TextoEstadoReal(m.EstadoReal)</span></td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    }

                    <h5 class="mt-3">Microcortes por cámara</h5>
                    <MicrocortesTurnos Paradas="paradas" Error="@errorParadas" ConTurno="true" />
                </div>
                <div class="modal-footer">
                    @if (VeTurnos && FechaProduccion is { } fp)
                    {
                        <a class="btn btn-outline-primary me-auto" href="@($"produccion/turnos?fecha={fp:yyyy-MM-dd}&turno={id}")">Validar o corregir en Turnos de producción</a>
                    }
                    <button type="button" class="btn btn-secondary" @onclick="@(async () => await AlCerrar.InvokeAsync())">Cerrar</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    /// <summary>Turno a mostrar; null = modal cerrado.</summary>
    [Parameter] public long? TurnoProduccionId { get; set; }

    [Parameter] public int? LineaId { get; set; }
    [Parameter] public DateOnly? FechaProduccion { get; set; }
    [Parameter] public string Titulo { get; set; } = "Detalle del turno";

    /// <summary>Tiene VER de "Turnos de producción": se ofrece el enlace para validar o corregir.</summary>
    [Parameter] public bool VeTurnos { get; set; }

    [Parameter] public EventCallback AlCerrar { get; set; }

    private long? cargado;
    private IndicadoresTurnoDto? detalle;
    private string? error;
    private List<ParadaCamaraDto>? paradas;
    private string? errorParadas;

    protected override async Task OnParametersSetAsync()
    {
        if (TurnoProduccionId == cargado)
            return;
        cargado = TurnoProduccionId;
        detalle = null;
        error = null;
        paradas = null;
        errorParadas = null;
        if (TurnoProduccionId is not { } id)
            return;

        try
        {
            detalle = await IndicadoresService.GetTurnoAsync(id);
        }
        catch (Exception ex)
        {
            error = ex is HttpRequestException ? ex.Message : ApiErrores.SinConexion;
        }

        // Paradas de las cámaras del turno (el T3 termina al día siguiente): se piden dos días y se filtra por turno.
        var fecha = FechaProduccion ?? detalle?.FechaProduccion;
        if (fecha is not { } f)
        {
            paradas = [];
            return;
        }
        try
        {
            var r = await ConteoCamaraService.GetParadasAsync(f, f.AddDays(1), LineaId ?? detalle?.LineaId, false, 0);
            paradas = r.Items.Where(p => p.TurnoProduccionId == id).ToList();
        }
        catch (Exception)
        {
            errorParadas = "No se pudieron cargar las paradas de las cámaras.";
        }
    }
}
