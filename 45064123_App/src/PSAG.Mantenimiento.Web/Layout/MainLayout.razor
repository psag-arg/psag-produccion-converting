@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthStateProvider
@inject PSAG.Mantenimiento.Web.Services.IAuthService AuthService
@inject PSAG.Mantenimiento.Web.Services.IThemeService ThemeService
@inject NavigationManager Navigation
@implements IDisposable

<div class="page">
    <AuthorizeView>
        <Authorized>
            <div class="sidebar @(menuAbierto ? "abierto" : "")" id="menu-lateral">
                <NavMenu />
            </div>
            @if (menuAbierto)
            {
                <div class="sidebar-fondo" @onclick="() => menuAbierto = false"></div>
            }

            <main>
                <div class="top-row px-3 px-md-4">
                    <button class="btn btn-outline-secondary btn-sm boton-menu me-auto" @onclick="() => menuAbierto = !menuAbierto"
                            aria-controls="menu-lateral" aria-expanded="@(menuAbierto ? "true" : "false")" title="Menú">
                        <i class="bi bi-list"></i> Menú
                    </button>
                    <button class="btn btn-outline-secondary btn-sm me-3" @onclick="ToggleTheme" title="@(isDarkMode ? "Cambiar a modo claro" : "Cambiar a modo oscuro")">
                        <i class="bi @(isDarkMode ? "bi-sun-fill" : "bi-moon-stars-fill")"></i>
                    </button>
                    <span class="me-3 text-dark nombre-usuario">@context.User.Identity?.Name</span>
                    <button class="btn btn-outline-secondary btn-sm" @onclick="Logout">
                        Cerrar sesión
                    </button>
                </div>

                <article class="content px-3 px-md-4">
                    @Body
                </article>
            </main>
        </Authorized>
        <NotAuthorized>
            @Body
        </NotAuthorized>
    </AuthorizeView>
</div>

@code {
    private bool isDarkMode;
    private bool menuAbierto;

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += AlNavegar;
    }

    // En el celular el menú tapa la pantalla: se cierra solo al elegir una opción.
    private void AlNavegar(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        if (!menuAbierto) return;
        menuAbierto = false;
        InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await ThemeService.InitializeAsync();
            isDarkMode = ThemeService.IsDarkMode;
            ThemeService.OnThemeChanged += OnThemeChanged;
            StateHasChanged();
        }
    }

    private async Task ToggleTheme()
    {
        await ThemeService.ToggleThemeAsync();
        isDarkMode = ThemeService.IsDarkMode;
    }

    private void OnThemeChanged()
    {
        isDarkMode = ThemeService.IsDarkMode;
        InvokeAsync(StateHasChanged);
    }

    private async Task Logout()
    {
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("/login", true);
    }

    public void Dispose()
    {
        ThemeService.OnThemeChanged -= OnThemeChanged;
        Navigation.LocationChanged -= AlNavegar;
    }
}
