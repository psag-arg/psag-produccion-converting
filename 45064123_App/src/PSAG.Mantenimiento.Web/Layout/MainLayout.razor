@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthStateProvider
@inject PSAG.Mantenimiento.Web.Services.IAuthService AuthService
@inject PSAG.Mantenimiento.Web.Services.IThemeService ThemeService
@inject NavigationManager Navigation
@inject PSAG.Mantenimiento.Web.Services.ITurnoPropioService TurnoPropio
@implements IDisposable

<div class="page">
    <AuthorizeView>
        <Authorized>
            @* T-802: el obligado a turno sin turno no ve el menú: sólo "Inicio de turno" (y cerrar sesión). *@
            @if (!bloqueado)
            {
                <div class="sidebar @(menuAbierto ? "abierto" : "")" id="menu-lateral">
                    <NavMenu />
                </div>
                @if (menuAbierto)
                {
                    <div class="sidebar-fondo" @onclick="() => menuAbierto = false"></div>
                }
            }

            <main>
                <div class="top-row px-3 px-md-4">
                    @if (!bloqueado)
                    {
                        <button class="btn btn-outline-secondary btn-sm boton-menu me-auto" @onclick="() => menuAbierto = !menuAbierto"
                                aria-controls="menu-lateral" aria-expanded="@(menuAbierto ? "true" : "false")" title="Menú">
                            <i class="bi bi-list"></i> Menú
                        </button>
                    }
                    else
                    {
                        @if (tolerancia is { } sesion)
                        {
                            <span class="me-auto small aviso-bloqueado" data-testid="aviso-tolerancia">
                                <i class="bi bi-hourglass-split me-1"></i>Terminó tu @sesion.TurnoNombre de @sesion.LineaNombre: hasta las
                                @sesion.ToleranciaHasta.ToString("HH:mm") podés declarar sus detenciones
                                (<a href="detenciones/pendientes">Mis pendientes</a> · <a href="@PSAG.Mantenimiento.Web.Services.TurnoPropioService.RutaInicioTurno">Inicio de turno</a>).
                            </span>
                        }
                        else
                        {
                            <span class="me-auto small aviso-bloqueado"><i class="bi bi-lock me-1"></i>Abrí o tomá un turno para empezar</span>
                        }
                    }
                    <button class="btn btn-outline-secondary btn-sm me-3" @onclick="ToggleTheme" title="@(isDarkMode ? "Cambiar a modo claro" : "Cambiar a modo oscuro")">
                        <i class="bi @(isDarkMode ? "bi-sun-fill" : "bi-moon-stars-fill")"></i>
                    </button>
                    <span class="me-3 nombre-usuario">@context.User.Identity?.Name</span>
                    <button class="btn btn-outline-secondary btn-sm" @onclick="Logout">
                        Cerrar sesión
                    </button>
                </div>

                <article class="content px-4">
                    @if (bloqueado && !permitida)
                    {
                        <div class="text-muted small p-3">Abrí o tomá un turno para empezar…</div>
                    }
                    else
                    {
                        @if (!bloqueado)
                        {
                            <PSAG.Mantenimiento.Web.Shared.BarraTurno />
                            <PSAG.Mantenimiento.Web.Shared.AvisoFinTurno />
                        }
                        <PSAG.Mantenimiento.Web.Shared.ControlPermiso>
                            @Body
                        </PSAG.Mantenimiento.Web.Shared.ControlPermiso>
                    }
                </article>
            </main>
        </Authorized>
        <NotAuthorized>
            @Body
        </NotAuthorized>
    </AuthorizeView>
</div>

@code {
    private bool isDarkMode;
    private bool menuAbierto;
    private bool bloqueado;
    /// <summary>Turno automático: la pantalla actual se puede usar (inicio de turno, o pendientes en la tolerancia).</summary>
    private bool permitida = true;
    private PSAG.Mantenimiento.Web.Models.SesionToleranciaDto? tolerancia;
    private bool enInicioTurno;

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += AlNavegar;
        TurnoPropio.Cambio += AlCambiarTurno;
        AuthStateProvider.AuthenticationStateChanged += AlCambiarSesion;
        await EvaluarTurnoAsync();
    }

    // En el celular el menú tapa la pantalla: se cierra solo al elegir una opción.
    private async void AlNavegar(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        menuAbierto = false;
        await EvaluarTurnoAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async void AlCambiarTurno()
    {
        await EvaluarTurnoAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async void AlCambiarSesion(Task<AuthenticationState> _)
    {
        await EvaluarTurnoAsync();
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// T-802: obligado a turno sin turno abierto = bloqueado. Sólo puede estar en "Inicio de turno"; cualquier otra
    /// pantalla lo lleva ahí (con la pantalla pedida para volver después).
    /// </summary>
    private async Task EvaluarTurnoAsync()
    {
        try
        {
            var usuario = (await AuthStateProvider.GetAuthenticationStateAsync()).User;
            if (usuario.Identity?.IsAuthenticated != true)
            {
                bloqueado = false;
                permitida = true;
                tolerancia = null;
                return;
            }
            var actual = "/" + Navigation.ToBaseRelativePath(Navigation.Uri);
            enInicioTurno = PSAG.Mantenimiento.Web.Services.TurnoPropioService.EsInicioTurno(actual);
            var estado = await TurnoPropio.ObtenerAsync();
            bloqueado = estado.Bloqueado;
            tolerancia = estado.Turno == null ? estado.Tolerancia : null;
            permitida = estado.PuedeEstarEn(actual);
            // Turno automático: sin turno (o sin producto confirmado) sólo inicio de turno; en la tolerancia, también sus pendientes.
            if (!estado.PuedeEstarEn(actual) && !actual.StartsWith("/login", StringComparison.OrdinalIgnoreCase))
                Navigation.NavigateTo($"/{PSAG.Mantenimiento.Web.Services.TurnoPropioService.RutaInicioTurno}?volver={Uri.EscapeDataString(actual)}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Turno propio: {ex.Message}");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await ThemeService.InitializeAsync();
            isDarkMode = ThemeService.IsDarkMode;
            ThemeService.OnThemeChanged += OnThemeChanged;
            StateHasChanged();
        }
    }

    private async Task ToggleTheme()
    {
        await ThemeService.ToggleThemeAsync();
        isDarkMode = ThemeService.IsDarkMode;
    }

    private void OnThemeChanged()
    {
        isDarkMode = ThemeService.IsDarkMode;
        InvokeAsync(StateHasChanged);
    }

    private async Task Logout()
    {
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("/login", true);
    }

    public void Dispose()
    {
        ThemeService.OnThemeChanged -= OnThemeChanged;
        Navigation.LocationChanged -= AlNavegar;
        TurnoPropio.Cambio -= AlCambiarTurno;
        AuthStateProvider.AuthenticationStateChanged -= AlCambiarSesion;
    }
}
