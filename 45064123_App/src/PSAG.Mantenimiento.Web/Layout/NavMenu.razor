@inject NavigationManager Navigation
@inject PSAG.Mantenimiento.Web.Services.IAnalisisService AnalisisService
@inject PSAG.Mantenimiento.Web.Services.IPermisosService PermisosService
@using PSAG.Mantenimiento.Web.Models
@using PSAG.Mantenimiento.Web.Shared
@implements IDisposable

<div class="sidebar-wrapper @(sidebarCollapsed ? "collapsed" : "")">
<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">
            @if (!sidebarCollapsed)
            {
                <span>PSAG Produccion</span>
            }
            else
            {
                <span>PSAG</span>
            }
        </a>
    </div>
</div>

<div class="nav-scrollable">
    @* T-802: el menú sale de los permisos del usuario (GET api/permisos/mios), no de roles fijos. *@
    <nav class="nav flex-column">
        @foreach (var seccion in permisos.Secciones)
        {
            var indice = IndiceDe(seccion.Codigo);
            <div class="nav-section">
                <div class="nav-section-header" @onclick="() => ToggleSection(indice, seccion.Codigo)">
                    <span class="bi @IconoSeccion(seccion.Codigo) me-2"></span>
                    @if (!sidebarCollapsed)
                    {
                        <span>@seccion.Nombre</span>
                        <span class="bi @(IsExpanded(indice) ? "bi-chevron-up" : "bi-chevron-down") ms-auto"></span>
                    }
                </div>
                @if (IsExpanded(indice) && !sidebarCollapsed)
                {
                    <div class="nav-section-items">
                        @foreach (var item in ItemsDe(seccion.Codigo))
                        {
                            <NavLink class="nav-link" href="@item.Ruta" Match="@(item.Exacta ? NavLinkMatch.All : NavLinkMatch.Prefix)">
                                <span class="bi @item.Icono me-2"></span> @item.Texto
                                @if (item.Codigo == Opciones.DetencionesPendientes && pendientesCount > 0)
                                {
                                    <span class="badge bg-danger ms-2">@pendientesCount</span>
                                }
                            </NavLink>
                        }
                    </div>
                }
            </div>
        }
    </nav>
</div>

<button class="collapse-btn" @onclick="ToggleSidebar" title="@(sidebarCollapsed ? "Expandir menú" : "Colapsar menú")">
    <span class="bi @(sidebarCollapsed ? "bi-chevron-right" : "bi-chevron-left")"></span>
</button>
</div>

@code {
    private bool sidebarCollapsed = false;
    private HashSet<int> expandedSections = new() { 0 }; // Dashboard expanded by default
    private int pendientesCount;
    private DateTime ultimoConteo = DateTime.MinValue;
    private PermisosUsuario permisos = PermisosUsuario.Ninguno;

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += OnLocationChanged;
        AnalisisService.PendientesCambiaron += OnPendientesCambiaron;
        PermisosService.Cambiaron += OnPermisosCambiaron;
        permisos = await PermisosService.ObtenerAsync();
        await CargarPendientes();
    }

    private async void OnPermisosCambiaron()
    {
        permisos = await PermisosService.ObtenerAsync();
        await CargarPendientes(forzar: true);
        await InvokeAsync(StateHasChanged);
    }

    private sealed record ItemMenu(string Codigo, string Ruta, string Texto, string Icono, bool Exacta);

    // Presentación (íconos y textos cortos); qué se muestra lo deciden los permisos.
    private static readonly Dictionary<string, (string Texto, string Icono, bool Exacta)> Presentacion = new()
    {
        [Opciones.DashboardInicio] = ("Inicio", "bi-house", true),
        [Opciones.DashboardReportes] = ("Reportes", "bi-bar-chart", false),
        [Opciones.DashboardHorasProgramadas] = ("Horas programadas", "bi-calendar-week", false),
        [Opciones.MaestrosLineas] = ("Líneas", "bi-building", false),
        [Opciones.MaestrosEquipos] = ("Equipos", "bi-cpu", false),
        [Opciones.MaestrosTiposFalla] = ("Tipos de falla", "bi-exclamation-triangle", false),
        [Opciones.MaestrosFallas] = ("Fallas", "bi-x-circle", false),
        [Opciones.MaestrosReglasAnalisis] = ("Reglas de análisis", "bi-sliders", false),
        [Opciones.MaestrosControlProceso] = ("Puntos de control de proceso", "bi-ui-checks", false),
        [Opciones.MaestrosInspecciones] = ("Planes de inspección", "bi-clipboard-check", false),
        [Opciones.MaestrosProductos] = ("Productos", "bi-box-seam", false),
        [Opciones.MaestrosParametros] = ("Parámetros línea + producto", "bi-bullseye", false),
        [Opciones.MaestrosCamaras] = ("Cámaras", "bi-camera-video", false),
        [Opciones.MaestrosCalidad] = ("Calidad (puntos y defectos)", "bi-camera", false),
        [Opciones.DetencionesListado] = ("Ver detenciones", "bi-list-ul", true),
        [Opciones.DetencionesPendientes] = ("Mis pendientes", "bi-inbox", false),
        [Opciones.DetencionesSoluciones] = ("Base de soluciones", "bi-book", false),
        [Opciones.DetencionesDeclararManual] = ("Declarar detención manual", "bi-lightning-charge", false),
        [Opciones.ProduccionInicioTurno] = ("Inicio de turno", "bi-play-circle", false),
        [Opciones.ProduccionTurnos] = ("Turnos de producción", "bi-calendar3", false),
        [Opciones.ProduccionPresupuestoReal] = ("Presupuesto vs. real", "bi-graph-up-arrow", false),
        [Opciones.TareasPendientes] = ("Pendientes y programadas", "bi-list-ul", true),
        [Opciones.TareasHistorial] = ("Historial", "bi-clock-history", false),
        [Opciones.ControlProcesoRegistros] = ("Ver controles", "bi-list-ul", true),
        [Opciones.InspeccionesEjecuciones] = ("Ver inspecciones", "bi-list-check", true),
        [Opciones.InspeccionesNoOk] = ("Panel NO OK", "bi-exclamation-triangle", false),
        [Opciones.CalidadRegistro] = ("Registro de defectos", "bi-list-ul", true),
        [Opciones.CalidadParadasCamara] = ("Paradas y producción (cámara)", "bi-stopwatch", false),
        [Opciones.ConfigTurnos] = ("Turnos", "bi-clock", false),
        [Opciones.ConfigMaquinistas] = ("Maquinistas", "bi-people", false),
        [Opciones.ConfigUsuarios] = ("Usuarios", "bi-person-gear", false),
        [Opciones.ConfigRoles] = ("Roles y permisos", "bi-shield-lock", false),
    };

    private IEnumerable<ItemMenu> ItemsDe(string seccion)
    {
        foreach (var o in permisos.MenuDe(seccion))
        {
            var (texto, icono, exacta) = Presentacion.TryGetValue(o.Codigo, out var p) ? p : (o.Nombre, "bi-dot", false);
            // Accesos de alta (se muestran si el usuario puede dar de alta)
            if (o.Codigo == Opciones.TareasPendientes && o.Alta)
                yield return new ItemMenu(o.Codigo + ".NUEVA", "tareas-mantenimiento?nueva=1", "Nueva tarea", "bi-plus-circle", false);
            yield return new ItemMenu(o.Codigo, o.Ruta!, texto, icono, exacta);
            if (o.Codigo == Opciones.ControlProcesoRegistros && o.Alta)
                yield return new ItemMenu(o.Codigo + ".NUEVO", "control-proceso/nuevo", "Nuevo control", "bi-plus-circle", false);
            if (o.Codigo == Opciones.InspeccionesEjecuciones && o.Alta)
                yield return new ItemMenu(o.Codigo + ".NUEVA", "inspecciones/nueva", "Nueva inspección", "bi-plus-circle", false);
        }
    }

    private static readonly string[] OrdenSecciones =
    [
        Opciones.Dashboard, Opciones.Maestros, Opciones.Detenciones, Opciones.ControlProceso, Opciones.Inspecciones,
        Opciones.Configuracion, Opciones.Calidad, Opciones.Tareas, Opciones.Produccion
    ];

    private static int IndiceDe(string seccion) => Array.IndexOf(OrdenSecciones, seccion) is var i and >= 0 ? i : 100 + seccion.Length;

    private static string IconoSeccion(string seccion) => seccion switch
    {
        Opciones.Dashboard => "bi-speedometer2",
        Opciones.Maestros => "bi-gear",
        Opciones.Detenciones => "bi-pause-circle",
        Opciones.Produccion => "bi-gear-wide-connected",
        Opciones.Tareas => "bi-wrench-adjustable",
        Opciones.ControlProceso => "bi-clipboard-data",
        Opciones.Inspecciones => "bi-clipboard-check",
        Opciones.Calidad => "bi-camera",
        Opciones.Configuracion => "bi-gear-fill",
        _ => "bi-folder"
    };

    private async void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        await CargarPendientes();
        await InvokeAsync(StateHasChanged);
    }

    private async void OnPendientesCambiaron()
    {
        await CargarPendientes(forzar: true);
        await InvokeAsync(StateHasChanged);
    }

    private async Task CargarPendientes(bool forzar = false)
    {
        if (!forzar && DateTime.UtcNow - ultimoConteo < TimeSpan.FromSeconds(30))
        {
            return;
        }

        ultimoConteo = DateTime.UtcNow;
        if (!permisos.Ve(Opciones.DetencionesPendientes))
        {
            pendientesCount = 0;
            return;
        }

        try
        {
            pendientesCount = await AnalisisService.GetConteoPendientesAsync();
        }
        catch
        {
            pendientesCount = 0;
        }
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        AnalisisService.PendientesCambiaron -= OnPendientesCambiaron;
        PermisosService.Cambiaron -= OnPermisosCambiaron;
    }

    private void ToggleSidebar()
    {
        sidebarCollapsed = !sidebarCollapsed;
        if (sidebarCollapsed)
        {
            expandedSections.Clear();
        }
    }

    private void ToggleSection(int index, string seccion)
    {
        if (sidebarCollapsed)
        {
            // Si está colapsado, navegar directamente a la primera opción de la sección que el usuario ve
            var primera = ItemsDe(seccion).FirstOrDefault(i => !i.Codigo.Contains(".NUEV"));
            if (primera != null)
                Navigation.NavigateTo(primera.Ruta);
            return;
        }

        if (expandedSections.Contains(index))
            expandedSections.Remove(index);
        else
            expandedSections.Add(index);
    }

    private bool IsExpanded(int index) => expandedSections.Contains(index);
}
