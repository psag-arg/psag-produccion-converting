@inject NavigationManager Navigation
@inject PSAG.Mantenimiento.Web.Services.IAnalisisService AnalisisService
@implements IDisposable

<div class="sidebar-wrapper @(sidebarCollapsed ? "collapsed" : "")">
<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">
            @if (!sidebarCollapsed)
            {
                <span>PSAG Produccion</span>
            }
            else
            {
                <span>PSAG</span>
            }
        </a>
    </div>
</div>

<div class="nav-scrollable">
    <nav class="nav flex-column">
        @* DASHBOARD *@
        <div class="nav-section">
            <div class="nav-section-header" @onclick="() => ToggleSection(0)">
                <span class="bi bi-speedometer2 me-2"></span>
                @if (!sidebarCollapsed)
                {
                    <span>Dashboard</span>
                    <span class="bi @(IsExpanded(0) ? "bi-chevron-up" : "bi-chevron-down") ms-auto"></span>
                }
            </div>
            @if (IsExpanded(0) && !sidebarCollapsed)
            {
                <div class="nav-section-items">
                    <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                        <span class="bi bi-house me-2"></span> Inicio
                    </NavLink>
                    <NavLink class="nav-link" href="dashboard/reportes">
                        <span class="bi bi-bar-chart me-2"></span> Reportes
                    </NavLink>
                    <AuthorizeView Roles="ADMINISTRADOR,SUPERVISOR" Context="horas">
                        <NavLink class="nav-link" href="configuracion/horas-programadas">
                            <span class="bi bi-calendar-week me-2"></span> Horas programadas
                        </NavLink>
                    </AuthorizeView>
                </div>
            }
        </div>

        @* MAESTROS: sólo administrador (las páginas lo exigen) *@
        <AuthorizeView Roles="ADMINISTRADOR">
        <div class="nav-section">
            <div class="nav-section-header" @onclick="() => ToggleSection(1)">
                <span class="bi bi-gear me-2"></span>
                @if (!sidebarCollapsed)
                {
                    <span>Maestros</span>
                    <span class="bi @(IsExpanded(1) ? "bi-chevron-up" : "bi-chevron-down") ms-auto"></span>
                }
            </div>
            @if (IsExpanded(1) && !sidebarCollapsed)
            {
                <div class="nav-section-items">
                    <NavLink class="nav-link" href="maestros/lineas">
                        <span class="bi bi-building me-2"></span> Líneas
                    </NavLink>
                    <NavLink class="nav-link" href="maestros/equipos">
                        <span class="bi bi-cpu me-2"></span> Equipos
                    </NavLink>
                    <NavLink class="nav-link" href="maestros/tipos-falla">
                        <span class="bi bi-exclamation-triangle me-2"></span> Tipos de falla
                    </NavLink>
                    <NavLink class="nav-link" href="maestros/fallas">
                        <span class="bi bi-x-circle me-2"></span> Fallas
                    </NavLink>
                    <NavLink class="nav-link" href="maestros/reglas-analisis">
                        <span class="bi bi-sliders me-2"></span> Reglas de análisis
                    </NavLink>
                </div>
            }
        </div>
        </AuthorizeView>

        @* DETENCIONES *@
        <div class="nav-section">
            <div class="nav-section-header" @onclick="() => ToggleSection(2)">
                <span class="bi bi-pause-circle me-2"></span>
                @if (!sidebarCollapsed)
                {
                    <span>Detenciones</span>
                    <span class="bi @(IsExpanded(2) ? "bi-chevron-up" : "bi-chevron-down") ms-auto"></span>
                }
            </div>
            @if (IsExpanded(2) && !sidebarCollapsed)
            {
                <div class="nav-section-items">
                    <NavLink class="nav-link" href="detenciones" Match="NavLinkMatch.All">
                        <span class="bi bi-list-ul me-2"></span> Ver detenciones
                    </NavLink>
                    <NavLink class="nav-link" href="detenciones/pendientes">
                        <span class="bi bi-inbox me-2"></span> Mis pendientes
                        @if (pendientesCount > 0)
                        {
                            <span class="badge bg-danger ms-2">@pendientesCount</span>
                        }
                    </NavLink>
                    <NavLink class="nav-link" href="detenciones/soluciones">
                        <span class="bi bi-book me-2"></span> Base de soluciones
                    </NavLink>
                </div>
            }
        </div>

        @* REGISTROS DE PROCESO *@
        <div class="nav-section">
            <div class="nav-section-header" @onclick="() => ToggleSection(3)">
                <span class="bi bi-clipboard-data me-2"></span>
                @if (!sidebarCollapsed)
                {
                    <span>Registros</span>
                    <span class="bi @(IsExpanded(3) ? "bi-chevron-up" : "bi-chevron-down") ms-auto"></span>
                }
            </div>
            @if (IsExpanded(3) && !sidebarCollapsed)
            {
                <div class="nav-section-items">
                    <NavLink class="nav-link" href="registros-proceso" Match="NavLinkMatch.All">
                        <span class="bi bi-list-ul me-2"></span> Ver Registros
                    </NavLink>
                    <NavLink class="nav-link" href="registros-proceso/nuevo">
                        <span class="bi bi-plus-circle me-2"></span> Nuevo Registro
                    </NavLink>
                </div>
            }
        </div>

        @* INSPECCIONES *@
        <div class="nav-section">
            <div class="nav-section-header" @onclick="() => ToggleSection(4)">
                <span class="bi bi-clipboard-check me-2"></span>
                @if (!sidebarCollapsed)
                {
                    <span>Inspecciones</span>
                    <span class="bi @(IsExpanded(4) ? "bi-chevron-up" : "bi-chevron-down") ms-auto"></span>
                }
            </div>
            @if (IsExpanded(4) && !sidebarCollapsed)
            {
                <div class="nav-section-items">
                    <NavLink class="nav-link" href="inspecciones" Match="NavLinkMatch.All">
                        <span class="bi bi-list-check me-2"></span> Ver Inspecciones
                    </NavLink>
                    <NavLink class="nav-link" href="inspecciones/hallazgos">
                        <span class="bi bi-exclamation-triangle me-2"></span> Panel NO OK
                    </NavLink>
                </div>
            }
        </div>

        @* CONFIGURACION: sólo administrador *@
        <AuthorizeView Roles="ADMINISTRADOR">
        <div class="nav-section">
            <div class="nav-section-header" @onclick="() => ToggleSection(5)">
                <span class="bi bi-gear-fill me-2"></span>
                @if (!sidebarCollapsed)
                {
                    <span>Configuración</span>
                    <span class="bi @(IsExpanded(5) ? "bi-chevron-up" : "bi-chevron-down") ms-auto"></span>
                }
            </div>
            @if (IsExpanded(5) && !sidebarCollapsed)
            {
                <div class="nav-section-items">
                    <NavLink class="nav-link" href="configuracion/turnos">
                        <span class="bi bi-clock me-2"></span> Turnos
                    </NavLink>
                    <NavLink class="nav-link" href="configuracion/maquinistas">
                        <span class="bi bi-people me-2"></span> Maquinistas
                    </NavLink>
                    <NavLink class="nav-link" href="configuracion/usuarios">
                        <span class="bi bi-person-gear me-2"></span> Usuarios
                    </NavLink>
                </div>
            }
        </div>
        </AuthorizeView>
    </nav>
</div>

<button class="collapse-btn" @onclick="ToggleSidebar" title="@(sidebarCollapsed ? "Expandir menú" : "Colapsar menú")">
    <span class="bi @(sidebarCollapsed ? "bi-chevron-right" : "bi-chevron-left")"></span>
</button>
</div>

@code {
    private bool sidebarCollapsed = false;
    private HashSet<int> expandedSections = new() { 0 }; // Dashboard expanded by default
    private int pendientesCount;
    private DateTime ultimoConteo = DateTime.MinValue;

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += OnLocationChanged;
        AnalisisService.PendientesCambiaron += OnPendientesCambiaron;
        await CargarPendientes();
    }

    private async void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        await CargarPendientes();
        await InvokeAsync(StateHasChanged);
    }

    private async void OnPendientesCambiaron()
    {
        await CargarPendientes(forzar: true);
        await InvokeAsync(StateHasChanged);
    }

    private async Task CargarPendientes(bool forzar = false)
    {
        if (!forzar && DateTime.UtcNow - ultimoConteo < TimeSpan.FromSeconds(30))
        {
            return;
        }

        ultimoConteo = DateTime.UtcNow;
        try
        {
            pendientesCount = await AnalisisService.GetConteoPendientesAsync();
        }
        catch
        {
            pendientesCount = 0;
        }
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        AnalisisService.PendientesCambiaron -= OnPendientesCambiaron;
    }

    private void ToggleSidebar()
    {
        sidebarCollapsed = !sidebarCollapsed;
        if (sidebarCollapsed)
        {
            expandedSections.Clear();
        }
    }

    private void ToggleSection(int index)
    {
        if (sidebarCollapsed)
        {
            // Si está colapsado, navegar directamente a la primera opción de la sección
            var routes = new[] { "", "maestros/lineas", "detenciones", "registros-proceso", "inspecciones", "configuracion/turnos" };
            Navigation.NavigateTo(routes[index]);
            return;
        }

        if (expandedSections.Contains(index))
            expandedSections.Remove(index);
        else
            expandedSections.Add(index);
    }

    private bool IsExpanded(int index) => expandedSections.Contains(index);
}
