{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=PSAG_Mantenimiento;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "JwtSettings": {
    "SecretKey": "PSAG_Mantenimiento_Secret_Key_2024_Must_Be_At_Least_32_Characters_Long!",
    "Issuer": "PSAG.Mantenimiento.Api",
    "Audience": "PSAG.Mantenimiento.Web",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 7
  },
  "Adjuntos": {
    "Carpeta": "App_Data/AdjuntosAnalisis"
  },
  "Planta": {
    "ZonaHoraria": "America/Argentina/Buenos_Aires"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5188",
      "https://localhost:7236",
      "http://localhost:5000",
      "http://localhost:5001",
      "https://localhost:5001"
    ]
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/psag-mantenimiento-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithEnvironmentName" ]
  },
  "AllowedHosts": "*"
}
